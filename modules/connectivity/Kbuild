# Out-of-tree build of the vendored MT6797 CONSYS connectivity stack
# (WMT core + BTIF) against the Linux 6.6 Base tree.
#
# Source provenance: see PROVENANCE.md. Object lists mirror the vendor
# 3.18 Makefiles' CONFIG_MTK_COMBO=y + CONSYS_6797 selection (external-chip
# ICs, SDIO/UART transports, and the LTE-coex IDC path are excluded).
# Every 6.6-compatibility change to the sources is logged in API-CHURN-LOG.md.

ccflags-y := \
	-I$(src)/shim/include \
	-I$(src)/common_main/include \
	-I$(src)/common_main/core/include \
	-I$(src)/common_main/linux/include \
	-I$(src)/common_main/platform/include \
	-I$(src)/common_detect \
	-I$(src)/btif/inc \
	-I$(src)/btif/plat_inc \
	-I$(src)/drv_bt/include

# Vendor build flags for the CONSYS/SoC path (from the 3.18 Makefiles),
# minus -Werror: warnings in ported code are tracked, not silenced.
ccflags-y += \
	-DWMT_PLAT_ALPS=1 \
	-DWMT_UART_RX_MODE_WORK=0 \
	-DWMT_SDIO_MODE=1 \
	-DWMT_CREATE_NODE_DYNAMIC=1 \
	-DMTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT \
	-DWMT_IDC_SUPPORT=0 \
	-DCONFIG_ARCH_MT6797

# BTIF transport (AP<->CONSYS on-chip channel)
obj-m += mtk_btif.o
mtk_btif-y := \
	btif/mtk_btif.o \
	btif/mtk_btif_exp.o \
	btif/btif_plat.o \
	btif/btif_dma_plat.o

# Wi-Fi chardev gate (/dev/wmtWifi — userspace writes '1' to power Wi-Fi on).
# NOT a standalone module: it is linked INTO wlan_gen3.ko (see the wlan_gen3-y
# append below). The chardev and the gen3 driver reference each other's symbols
# (chardev reads gen3's g_IsNeedDoChipReset; gen3 calls the chardev's
# wifi_reset_start/end + register_set_p2p_mode_handler), which as two separate
# modules formed a bidirectional EXPORT_SYMBOL cycle that depmod cannot order
# (issue #22). Merging makes every such edge intra-module. Built with
# MTK_WCN_BUILT_IN_DRIVER so it exposes mtk_wcn_wmt_wifi_init/exit (driven by
# gen3's initWlan/exitWlan) instead of its own module_init — a single .ko may
# have only one module entry point, which stays gl_init.c's.
CFLAGS_wlan/wmt_chrdev_wifi.o := -DCREATE_NODE_DYNAMIC=1 -DMTK_WCN_BUILT_IN_DRIVER

# Gen3 WLAN driver — the driver actually built for CONSYS_6797 (MT6630-class
# core, SDIO-like AHB HIF). Object list mirrors the vendor gen3 Makefile's
# MT6797 selection. NOTE: gen2 is deliberately NOT vendored into this tree at
# all (CONTEXT.md: gen3, not gen2, despite older notes) — nothing here may
# reference wlan/gen2.
WLAN_GEN3_CFLAGS := \
	-UMT6620 -UMT6628 -UMT5931 -UMT6630 \
	-DLINUX -DMT6797 \
	-DCFG_SUPPORT_DEBUG_FS=0 \
	-DWLAN_INCLUDE_PROC \
	-DCFG_SUPPORT_AGPS_ASSIST=1 \
	-DCFG_SUPPORT_TSF_USING_BOOTTIME=1 \
	-DARP_MONITER_ENABLE=1 \
	-DCFG_SUPPORT_CHNL_CONFLICT_REVISE=1 \
	-DCFG_SUPPORT_AEE=0 \
	-DBUILD_QA_DBG=0 \
	-DCFG_SUPPORT_PASSPOINT=0 -DCFG_HS20_DEBUG=0 -DCFG_ENABLE_GTK_FRAME_FILTER=0 \
	-DCFG_MET_PACKET_TRACE_SUPPORT=0 \
	-DCFG_SPM_WORKAROUND_FOR_HOTSPOT=0 \
	-DDBG=0 \
	-DFW_CFG_SUPPORT \
	-I$(src)/wlan/gen3/os \
	-I$(src)/wlan/gen3/os/linux/include \
	-I$(src)/wlan/gen3/os/linux/hif/ahb_sdioLike/include \
	-I$(src)/wlan/gen3/include \
	-I$(src)/wlan/gen3/include/nic \
	-I$(src)/wlan/gen3/include/mgmt

obj-m += wlan_gen3.o
