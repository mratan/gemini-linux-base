-				 scp->base + scpd->data->ext_sram_ctl_offs :
-				 ctl_addr);
+	ret = scpsys_sram_enable(scpd,
+				 scpsys_sram_pdn_addr(scp, scpd, ctl_addr),
+				 scpsys_sram_ack_addr(scp, scpd, ctl_addr));
 	if (ret < 0)
 		goto err_pwr_ack;
 
