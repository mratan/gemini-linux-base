+/*
+ * Where the SRAM PDN bit is WRITTEN, and where its ACK is READ. Normally both
+ * are the domain's own control register. mt6797's MFG domains are two
+ * different exceptions:
+ *
+ *   MFG        PDN and ACK both live in MFG_SRAM_CON 0x33C -> ext_sram_ctl_offs
+ *   MFG_COREn  PDN is bit 8 of MFG_COREn_PWR_CON, but the ACK is bit 20+n of
+ *              MFG_SRAM_CON                                -> ext_sram_ack_offs
+ *
+ * (vendor clk-mt6797-pg.c, spm_mtcmos_ctrl_mfg and spm_mtcmos_ctrl_mfg_core0..3)
+ */
+static void __iomem *scpsys_sram_pdn_addr(struct scp *scp,
+					  struct scp_domain *scpd,
+					  void __iomem *ctl_addr)
+{
+	if (scpd->data->ext_sram_ctl_offs)
+		return scp->base + scpd->data->ext_sram_ctl_offs;
+	return ctl_addr;
+}
+
+static void __iomem *scpsys_sram_ack_addr(struct scp *scp,
+					  struct scp_domain *scpd,
+					  void __iomem *ctl_addr)
+{
+	if (scpd->data->ext_sram_ack_offs)
+		return scp->base + scpd->data->ext_sram_ack_offs;
+	return scpsys_sram_pdn_addr(scp, scpd, ctl_addr);
+}
+
 static int scpsys_bus_protect_enable(struct scp_domain *scpd)
 {
 	struct scp *scp = scpd->scp;
@@ -346,9 +384,9 @@
