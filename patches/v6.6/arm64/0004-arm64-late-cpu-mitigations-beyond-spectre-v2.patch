+/*
+ * What the declared-but-absent Cortex-A72 will report when it finally enables.
+ *
+ * update_mitigation_state() refuses -- with a WARN -- to advance the state
+ * after the capabilities are finalised, because userspace has already been told
+ * what the machine is. A late CPU that is the FIRST affected CPU therefore
+ * cannot record its own mitigation: the eight Cortex-A53s here are all in the
+ * Spectre-v2 safe list, so they leave spectre_v2_state at SPECTRE_UNAFFECTED,
+ * and cpu8 hits the WARN at ~240 s and leaves the sysfs file saying
+ * "Not affected" for a machine that has just stopped being that.
+ *
+ * So say at boot what the A72 is going to say. Its hardware state is not in
+ * doubt -- SPECTRE_VULNERABLE, being in neither safe list and having no CSV2 --
+ * so its answer is entirely the firmware's, and a boot CPU asks the firmware
+ * the same question with the same call.
+ *
+ * BE CAREFUL WITH THAT LAST STEP. SMCCC defines ARCH_FEATURES discovery for
+ * ARCH_WORKAROUND_1/_2 PER CALLING PE, and TF-A answers it out of the calling
+ * core's cpu_ops, so in general an A53 is NOT entitled to answer for an A72:
+ * a firmware that returned NOT_REQUIRED here would leave the capability
+ * undetected and the A72 permitted-but-unmitigated, which is the pre-#60
+ * behaviour and is reported as such by arm64/0002. It is not a new failure
+ * mode, but it is not a theoretical distinction either, so it is measured
+ * rather than assumed:
+ *
+ *   MT6797, build #109: the firmware reports PSCI v0.2. psci_init_smccc() is
+ *   only reached for PSCI >= 1.0, so SMCCC 1.1 is never negotiated,
+ *   arm_smccc_1_1_invoke() returns SMCCC_RET_NOT_SUPPORTED for every call from
+ *   every core, and this returns SPECTRE_VULNERABLE uniformly. There is no
+ *   firmware Spectre-v2 mitigation on this device to get wrong.
+ *
+ * The state is then correct from the moment the A72 arrives and pessimistic
+ * before it -- the A53s alone are UNAFFECTED. That is the direction to be wrong
+ * in for a file that answers "is this machine hardened", and on this SoC the
+ * A72s are onlined on every boot by gemini-a72-online.service anyway.
+ */
+static enum mitigation_state spectre_v2_late_a72_state(void)
+{
+	if (spectre_v2_mitigations_off())
+		return SPECTRE_VULNERABLE;
+
+	return spectre_v2_get_cpu_fw_mitigation_state();
+}
+
 void spectre_v2_enable_mitigation(const struct arm64_cpu_capabilities *__unused)
 {
 	enum mitigation_state state;
@@ -376,6 +426,9 @@
 	if (state == SPECTRE_VULNERABLE)
