+	if (arm64_get_spectre_v2_state() == SPECTRE_VULNERABLE ||
+	    !IS_ENABLED(CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY) ||
+	    cpu_mitigations_off() || __nospectre_bhb) {
+		update_mitigation_state(&spectre_bhb_state, SPECTRE_VULNERABLE);
+		return;
+	}
