+	b->rate = B_MIN_HZ;
+
+	{
+		struct clk_init_data init = {
+			.name = "mcu_b_idvfs",
+			.ops = &mt6797_b_idvfs_ops,
+			.parent_names = (const char *[]){ "clk26m" },
+			.num_parents = 1,
+			/* ->recalc_rate has a correction to make; let it run. */
+			.flags = CLK_GET_RATE_NOCACHE,
+		};
+
+		b->hw.init = &init;
+		ret = devm_clk_hw_register(dev, &b->hw);
+		if (ret) {
+			dev_err(dev, "failed to register mcu_b_idvfs: %d\n", ret);
+			goto err;
+		}
+	}
