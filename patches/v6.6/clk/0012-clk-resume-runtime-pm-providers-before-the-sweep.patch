From: Gemini PDA Linux bring-up
Subject: [PATCH] clk: resume runtime-PM providers before taking prepare_lock

#85, second half. patches/v6.6/clk/0011 makes three MT6797 clock providers
runtime-PM capable so the clk core holds their power domain before touching
their gates. On its own that is not enough, and build #120 measured why: it
looped on every reboot, worse than the defect it was fixing.

The reason is a lock inversion that only exists at this initcall.

  clk_disable_unused()          holds prepare_lock, then clk_pm_runtime_get()
                                on a provider -> genpd_lock()
  genpd_power_off_work_fn()     holds genpd_lock(), then the domain's own
                                clk_disable_unprepare() -> prepare_lock

Both sides are queued at the same late_initcall_sync -- genpd_power_off_unused()
puts one work item on pm_wq per domain, thirteen of them on this SoC -- so the
two run at the same instant on different CPUs and each waits for the other.
Before #120 the MT6797 providers had rpm_enabled false, so the left-hand side
never happened; giving them runtime PM turned an occasional MMIO wedge into a
reliable deadlock.

Upstream fixed exactly this in v6.11 (9d1e795f754d, "clk: Get runtime PM before
walking tree during disable_unused"): resume every runtime-PM-capable provider
BEFORE taking prepare_lock, and drop the per-clock get/put from inside the
sweep. That is what this backports. It needs a list of the cores with runtime
PM, which is maintained where rpm_enabled is set.

One caveat, recorded rather than fixed: __clk_release() now takes the list lock
while holding prepare_lock, the reverse of the order here. Upstream needed a
separate commit for that (e581cf5d2162, "clk: Remove prepare_lock hold assertion
in __clk_release()"). It is unreachable on this device -- no mt6797 clk provider
is ever unregistered -- and the alternative, leaving a freed core on the list,
is worse.

NOT YET VALIDATED ON HARDWARE. The device needed a power-cycle at the end of
the session that built it, so #121 was compiled and packed but never flashed.
Prove it with a reboot-cycle run before believing it.

--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -73,6 +73,7 @@
 	unsigned long		flags;
 	bool			orphan;
 	bool			rpm_enabled;
+	struct hlist_node	rpm_node;
 	unsigned int		enable_count;
 	unsigned int		prepare_count;
 	unsigned int		protect_count;
@@ -115,6 +116,19 @@
 	return pm_runtime_resume_and_get(core->dev);
 }
 
+/*
+ * #85: every core whose provider has runtime PM enabled. clk_disable_unused()
+ * resumes all of them BEFORE it takes prepare_lock, because resuming one from
+ * inside the sweep deadlocks: the sweep would hold prepare_lock and want
+ * genpd's, while genpd_power_off_work_fn -- queued for every unused domain at
+ * the same late_initcall_sync -- holds genpd's and wants prepare_lock through
+ * the power domain's own clk_disable_unprepare(). Upstream hit this and fixed
+ * it the same way (v6.11, "clk: Get runtime PM before walking tree during
+ * disable_unused").
+ */
+static HLIST_HEAD(clk_rpm_list);
+static DEFINE_MUTEX(clk_rpm_list_lock);
+
 static void clk_pm_runtime_put(struct clk_core *core)
 {
 	if (!core->rpm_enabled)
@@ -1492,6 +1506,50 @@
 	}
 }
 
+/*
+ * Resume every runtime-PM-capable provider, or none of them. The list lock is
+ * held until clk_pm_runtime_put_all() so no provider can register or vanish in
+ * between.
+ */
+static int __init clk_pm_runtime_get_all(void)
+{
+	int ret;
+	struct clk_core *core, *failed;
+
+	mutex_lock(&clk_rpm_list_lock);
+
+	hlist_for_each_entry(core, &clk_rpm_list, rpm_node) {
+		ret = clk_pm_runtime_get(core);
+		if (ret) {
+			failed = core;
+			pr_err("clk: Failed to runtime PM get '%s': %d\n",
+			       core->name, ret);
+			goto err;
+		}
+	}
+
+	return 0;
+
+err:
+	hlist_for_each_entry(core, &clk_rpm_list, rpm_node) {
+		if (core == failed)
+			break;
+		clk_pm_runtime_put(core);
+	}
+	mutex_unlock(&clk_rpm_list_lock);
+
+	return ret;
+}
+
+static void __init clk_pm_runtime_put_all(void)
+{
+	struct clk_core *core;
+
+	hlist_for_each_entry(core, &clk_rpm_list, rpm_node)
+		clk_pm_runtime_put(core);
+	mutex_unlock(&clk_rpm_list_lock);
+}
+
 static void __init clk_unprepare_unused_subtree(struct clk_core *core)
 {
 	struct clk_core *child;
@@ -1507,9 +1565,6 @@
 	if (core->flags & CLK_IGNORE_UNUSED)
 		return;
 
-	if (clk_pm_runtime_get(core))
-		return;
-
 	gemini_clktrace_enter(core->name, 2);
 	if (clk_core_is_prepared(core)) {
 		trace_clk_unprepare(core);
@@ -1520,8 +1575,6 @@
 		trace_clk_unprepare_complete(core);
 	}
 	gemini_clktrace_leave();
-
-	clk_pm_runtime_put(core);
 }
 
 static void __init clk_disable_unused_subtree(struct clk_core *core)
@@ -1537,9 +1590,6 @@
 	if (core->flags & CLK_OPS_PARENT_ENABLE)
 		clk_core_prepare_enable(core->parent);
 
-	if (clk_pm_runtime_get(core))
-		goto unprepare_out;
-
 	flags = clk_enable_lock();
 
 	if (core->enable_count)
@@ -1566,8 +1616,6 @@
 
 unlock_out:
 	clk_enable_unlock(flags);
-	clk_pm_runtime_put(core);
-unprepare_out:
 	if (core->flags & CLK_OPS_PARENT_ENABLE)
 		clk_core_disable_unprepare(core->parent);
 }
@@ -1583,6 +1631,7 @@
 static int __init clk_disable_unused(void)
 {
 	struct clk_core *core;
+	int ret;
 
 	if (clk_ignore_unused) {
 		pr_warn("clk: Not disabling unused clocks\n");
@@ -1591,6 +1640,10 @@
 
 	pr_info("clk: Disabling unused clocks\n");
 
+	ret = clk_pm_runtime_get_all();
+	if (ret)
+		return ret;
+
 	gemini_clktrace_begin();
 
 	clk_prepare_lock();
@@ -1609,6 +1662,8 @@
 
 	clk_prepare_unlock();
 
+	clk_pm_runtime_put_all();
+
 	gemini_clktrace_end();
 
 	return 0;
@@ -4334,8 +4389,12 @@
 	}
 	core->ops = init->ops;
 
-	if (dev && pm_runtime_enabled(dev))
+	if (dev && pm_runtime_enabled(dev)) {
 		core->rpm_enabled = true;
+		mutex_lock(&clk_rpm_list_lock);
+		hlist_add_head(&core->rpm_node, &clk_rpm_list);
+		mutex_unlock(&clk_rpm_list_lock);
+	}
 	core->dev = dev;
 	core->of_node = np;
 	if (dev && dev->driver)
@@ -4468,6 +4527,21 @@
 
 	lockdep_assert_held(&prepare_lock);
 
+	/*
+	 * Taking clk_rpm_list_lock here inverts the order clk_disable_unused()
+	 * uses (list lock, then prepare_lock), so on a kernel that unregisters
+	 * clocks this wants upstream's e581cf5d2162 ("clk: Remove prepare_lock
+	 * hold assertion in __clk_release()") first. Nothing on this device
+	 * ever gets here -- every mt6797 clk provider is built in and never
+	 * removed -- and leaving a freed core on the list is not survivable, so
+	 * remove it and record the caveat.
+	 */
+	if (core->rpm_enabled) {
+		mutex_lock(&clk_rpm_list_lock);
+		hlist_del(&core->rpm_node);
+		mutex_unlock(&clk_rpm_list_lock);
+	}
+
 	clk_core_free_parent_map(core);
 	kfree_const(core->name);
 	kfree(core);
