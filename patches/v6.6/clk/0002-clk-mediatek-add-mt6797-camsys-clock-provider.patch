diff --git a/include/dt-bindings/clock/mt6797-clk.h b/include/dt-bindings/clock/mt6797-clk.h
--- a/include/dt-bindings/clock/mt6797-clk.h
+++ b/include/dt-bindings/clock/mt6797-clk.h
@@ -218,6 +218,23 @@
 #define	CLK_INFRA_13M				84
 #define	CLK_INFRA_NR				85
 
+/*
+ * CAM_SYS (camsys_config@1a000000).
+ *
+ * Numbered from 0, unlike the IMG_SYS/MM_SYS blocks above: the MediaTek
+ * clock core sizes its clk_hw_onecell_data from ARRAY_SIZE(gate table) and
+ * then indexes it by gate id, so a table of N gates whose ids run 1..N
+ * writes one entry past the end. Starting at 0 keeps max(id) < N.
+ */
+#define	CLK_CAM_LARB2				0
+#define	CLK_CAM_CAMSYS				1
+#define	CLK_CAM_CAMTG				2
+#define	CLK_CAM_SENINF				3
+#define	CLK_CAM_CAMSV0				4
+#define	CLK_CAM_CAMSV1				5
+#define	CLK_CAM_CAMSV2				6
+#define	CLK_CAM_NR				7
+
 /* IMG_SYS */
 #define	CLK_IMG_FDVT				1
 #define	CLK_IMG_DPE				2
