--- a/drivers/input/keyboard/Kconfig
+++ b/drivers/input/keyboard/Kconfig
@@ -790,6 +790,21 @@
 	  To compile this driver as a module, choose M here: the
 	  module will be called mt6779-keypad.
 
+config KEYBOARD_MT6351
+	tristate "MediaTek MT6351 PMIC keys (polled)"
+	depends on REGMAP
+	help
+	  Say Y here if you want to use the power and home keys of the
+	  MediaTek MT6351 PMIC.
+
+	  This is a POLLED driver. The MT6351's interrupt is an EINT, and
+	  mainline pinctrl-mt6797 has no EINT support, so the interrupt-driven
+	  mtk-pmic-keys cannot be used on that SoC. Both key states live in one
+	  register, so a poll costs a single PMIC read.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called mt6351-keys.
+
 config KEYBOARD_MTK_PMIC
 	tristate "MediaTek PMIC keys support"
 	depends on MFD_MT6397 || COMPILE_TEST
--- a/drivers/input/keyboard/Makefile
