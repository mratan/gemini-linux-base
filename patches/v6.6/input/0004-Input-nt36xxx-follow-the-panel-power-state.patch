Input: nt36xxx — follow the panel's power, because it IS the panel

The NT36672 is a TDDI part: the touch controller shares the panel's die and
its power domain. Nothing told the touch driver that, and it cost two
things.

While the screen was off the driver kept polling at 60 Hz against an
unpowered chip, logging "page select failed: -6" about fifty times a
second — 240 suppressed callbacks per five seconds, and a kernel log with
nothing else visible in it. And when the panel came back, the controller
had cold-booted and no one re-initialised it.

Register as a drm_panel_follower. On panel_unpreparing, stop polling and
drop any contact still down, so a finger held as the screen blanks is not
reported as pressed across the whole blank. On panel_prepared, drive the
same reset probe does and re-read the firmware info — LK is not around to
release the controller the second time.

The phandle is optional: a device tree without `panel` keeps the old
always-polling behaviour and logs why, rather than failing to probe. That
is the right trade for a driver whose job is an input device.

Measured across a 20 s DPMS blank: zero I2C errors, where before there
were roughly a thousand, and the controller re-initialises on unblank.

This also retires the reason blanking was disabled in userspace. The claim
was that DPMS off was "a one-way trip for touch"; it is not — the panel and
the controller both come back — but until now the trip was noisy and the
controller came back uninitialised.

Signed-off-by: mratan <mattdratan@gmail.com>

--- a/drivers/input/touchscreen/gemini-nt36xxx.c
+++ b/drivers/input/touchscreen/gemini-nt36xxx.c
@@ -67,6 +67,7 @@
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/property.h>
+#include <drm/drm_panel.h>
 
 #define NVT_FW_ADDR		0x01	/* reports and firmware info live here */
 
@@ -113,6 +114,14 @@
 	u32			max_y;
 	bool			swap_xy;
 	bool			invert_y;
+	struct drm_panel_follower panel_follower;
+	/*
+	 * True between the panel being told to power down and coming back.
+	 * This is a TDDI part: the touch controller is on the panel's silicon
+	 * and its power domain, so while the panel is off the chip is not
+	 * merely idle, it is unpowered, and every I2C transfer NAKs.
+	 */
+	bool			panel_off;
 };
 
 /*
@@ -217,6 +226,16 @@
 	 * which works fine. So poll the line and do the transfer only when it
 	 * is asserted — the vendor's semantics, minus the interrupt.
 	 */
+	/*
+	 * Nothing to talk to while the panel is down. Without this the poll
+	 * keeps running at 60 Hz against an unpowered chip and logs "page
+	 * select failed: -6" about fifty times a second for as long as the
+	 * screen is off — measured: 240 suppressed callbacks per 5 s, and a
+	 * log with nothing else visible in it.
+	 */
+	if (READ_ONCE(ts->panel_off))
+		return;
+
 	if (ts->rdy_gpio && !gpiod_get_value_cansleep(ts->rdy_gpio))
 		return;
 
@@ -313,6 +332,57 @@
 	input_sync(ts->input);
 }
 
+/*
+ * Panel-follower callbacks.
+ *
+ * The NT36672 is a TDDI part: display and touch share one die and one power
+ * domain, so the panel's prepare/unprepare IS this controller's power
+ * sequence. Nothing else was telling the touch driver about it, which had two
+ * consequences — a 60 Hz I2C error loop for as long as the screen was off, and
+ * a controller that came back from cold with no one to re-initialise it.
+ *
+ * drm_panel_prepare()/unprepare() call these with the panel's follower_lock
+ * held, so they may sleep but must not touch DRM.
+ */
+static int nvt_ts_panel_prepared(struct drm_panel_follower *follower)
+{
+	struct nvt_ts *ts = container_of(follower, struct nvt_ts, panel_follower);
+
+	/*
+	 * The chip has just come up from cold and LK is not around to release
+	 * it this time, so drive the same reset probe does, and re-read the
+	 * firmware info — the resolution it reports is what the input device's
+	 * axis limits were built from.
+	 */
+	nvt_reset(ts);
+	nvt_read_fw_info(ts);
+	WRITE_ONCE(ts->panel_off, false);
+	return 0;
+}
+
+static int nvt_ts_panel_unpreparing(struct drm_panel_follower *follower)
+{
+	struct nvt_ts *ts = container_of(follower, struct nvt_ts, panel_follower);
+
+	WRITE_ONCE(ts->panel_off, true);
+
+	/*
+	 * Drop any contact still down. A finger held as the screen blanks would
+	 * otherwise stay reported until the next successful poll, which is
+	 * after the panel comes back — a stuck press across a whole blank.
+	 */
+	if (ts->input) {
+		input_mt_sync_frame(ts->input);
+		input_sync(ts->input);
+	}
+	return 0;
+}
+
+static const struct drm_panel_follower_funcs nvt_ts_panel_follower_funcs = {
+	.panel_prepared   = nvt_ts_panel_prepared,
+	.panel_unpreparing = nvt_ts_panel_unpreparing,
+};
+
 static int nvt_ts_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -380,6 +450,20 @@
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to register input device\n");
 
+	/*
+	 * Follow the panel's power state, if the DT says which panel. Optional
+	 * on purpose: a device tree without the phandle keeps the old
+	 * always-polling behaviour rather than failing to probe, which is the
+	 * right trade for a driver whose job is an input device.
+	 */
+	ts->panel_follower.funcs = &nvt_ts_panel_follower_funcs;
+	ret = devm_drm_panel_add_follower(dev, &ts->panel_follower);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret)
+		dev_warn(dev, "not following a panel (%d): polling will continue while the screen is off\n",
+			 ret);
+
 	dev_info(dev, "Novatek NT36xxx touchscreen ready (client 0x%02x, reports via 0x%02x, polled - B-11)\n",
 		 client->addr, NVT_FW_ADDR);
 	return 0;
