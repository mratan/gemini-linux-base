iommu/mediatek: add MT6797 support

MT6797 (Helio X20) has an M4U at 0x10205000 — the same address MT8173
uses, which is consistent with them being the same generation — and
mainline has never had a compatible for it. The consequence is not
subtle: with no IOMMU instance on the platform bus, the SMI larbs run in
MMU-bypass mode, mediatek-drm can only scan out physically contiguous
memory (mtk_gem_prime_import_sg_table rejects any scattered sg_table),
and a panfrost-rendered buffer can therefore never be handed to the
display. Every GPU-composited pixel goes through a CPU copy. See B-39.

Modelled on mt6795_data: MT6795/Helio X10 is the closest already
supported relative. The one deliberate difference is that HAS_BCLK is
NOT set. MT8173 and MT6795 take an infracfg CLK_INFRA_M4U as "bclk";
MT6797 has no such clock — it is absent from mt6797-clk.h, and the
vendor DT's m4u node lists only the MM/larb clocks and the mtcmos
domains, never a dedicated M4U gate. Claiming HAS_BCLK would fail the
probe looking for a clock the SoC does not have.

Only larb0 is remapped. The hardware has seven (vendor gM4uPort[] spans
larb0..larb6) but larb0 is the only one this tree instantiates, and the
whole display pipeline is behind it.

The larb/port bindings header is transcribed mechanically from the
vendor 3.18 table drivers/misc/mediatek/m4u/mt6797/m4u_platform.h,
which carries the larb id and larb-local port number for all 71 masters.
Transcribing all of them rather than only the display ports means an
incomplete header cannot become a trap later. It also records a defect
found while doing so: larb5 is the second display path (DISP_OVL1 /
DISP_RDMA1), while mt6797.dtsi currently points those nodes at larb0.
That is wrong and is only harmless because they are status="disabled".

--- a/drivers/iommu/mtk_iommu.c
+++ b/drivers/iommu/mtk_iommu.c
@@ -166,6 +166,7 @@
 	M4U_MT2712,
 	M4U_MT6779,
 	M4U_MT6795,
+	M4U_MT6797,
 	M4U_MT8167,
 	M4U_MT8173,
 	M4U_MT8183,
@@ -1532,6 +1533,34 @@
 	.larbid_remap = {{0}, {1}, {2}, {3}, {4}}, /* Linear mapping. */
 };
 
+/*
+ * MT6797 (Helio X20). The M4U sits at the same address as MT8173's
+ * (0x10205000) and is the same generation; MT6795/Helio X10 is the closest
+ * relative already supported, so this is modelled on mt6795_data.
+ *
+ * The one deliberate difference is that HAS_BCLK is NOT set. MT8173 and
+ * MT6795 take an infracfg CLK_INFRA_M4U as "bclk"; MT6797 has no such clock
+ * — it does not exist in mt6797-clk.h, and the vendor DT's m4u node lists
+ * only the MM/larb clocks and the mtcmos domains, never a dedicated M4U
+ * gate. Claiming HAS_BCLK here would fail the probe looking for a clock the
+ * SoC does not have.
+ *
+ * Only larb0 is listed. The hardware has seven (vendor gM4uPort[] spans
+ * larb0..larb6), but larb0 is the only one this tree instantiates, and the
+ * display pipeline is entirely behind it.
+ */
+static const struct mtk_iommu_plat_data mt6797_data = {
+	.m4u_plat     = M4U_MT6797,
+	.flags	      = HAS_4GB_MODE | RESET_AXI | HAS_LEGACY_IVRP_PADDR |
+			MTK_IOMMU_TYPE_MM | TF_PORT_TO_ADDR_MT8173,
+	.inv_sel_reg  = REG_MMU_INV_SEL_GEN1,
+	.banks_num    = 1,
+	.banks_enable = {true},
+	.iova_region  = single_domain,
+	.iova_region_nr = ARRAY_SIZE(single_domain),
+	.larbid_remap = {{0}}, /* Linear mapping; larb0 only. */
+};
+
 static const struct mtk_iommu_plat_data mt8167_data = {
 	.m4u_plat     = M4U_MT8167,
 	.flags        = RESET_AXI | HAS_LEGACY_IVRP_PADDR | MTK_IOMMU_TYPE_MM,
@@ -1759,6 +1788,7 @@
 	{ .compatible = "mediatek,mt2712-m4u", .data = &mt2712_data},
 	{ .compatible = "mediatek,mt6779-m4u", .data = &mt6779_data},
 	{ .compatible = "mediatek,mt6795-m4u", .data = &mt6795_data},
+	{ .compatible = "mediatek,mt6797-m4u", .data = &mt6797_data},
 	{ .compatible = "mediatek,mt8167-m4u", .data = &mt8167_data},
 	{ .compatible = "mediatek,mt8173-m4u", .data = &mt8173_data},
 	{ .compatible = "mediatek,mt8183-m4u", .data = &mt8183_data},
diff --git a/include/dt-bindings/memory/mt6797-larb-port.h b/include/dt-bindings/memory/mt6797-larb-port.h
new file mode 100644
--- /dev/null
+++ b/include/dt-bindings/memory/mt6797-larb-port.h
@@ -0,0 +1,115 @@
