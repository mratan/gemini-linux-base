--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -562,6 +562,21 @@ config TPS6594_PFSM
 	  This driver can also be built as a module.  If so, the module
 	  will be called tps6594-pfsm.
 
+config GEMINI_RIGHTPORT_MUX
+	tristate "Planet Gemini PDA right-port USB-C HDMI/USB-host mux"
+	depends on GPIOLIB
+	depends on OF
+	help
+	  Static/sysfs selection driver for the Planet Gemini PDA's right
+	  USB-C port hardware mux, which routes the port to EITHER the on-board
+	  SiI9024A HDMI transmitter OR USB-2 host — never both. Drives the three
+	  mux GPIOs (sw_en/sw_sel/sw7226_en) and exposes a "mode" sysfs attribute
+	  (hdmi / usb-host). Decoupled from the Type-C state machine; HPD-gated
+	  automatic switching is not implemented here.
+
+	  If unsure, say N. If built as a module it is called
+	  gemini-rightport-mux.
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
