+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/planet,gemini-rightport-mux.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Planet Gemini PDA right-port USB-C HDMI/USB-host mux
+
+maintainers:
+  - Gemini PDA Linux Project <gemini-linux@users.noreply.github.com>
+
+description: |
+  The Planet Gemini PDA's right USB-C port is a hardware mux: its pins carry
+  EITHER HDMI TMDS (from the on-board SiI9024A transmitter) OR USB-2 host,
+  never both. Three SoC GPIOs drive the mux; sw7226-en is the master select
+  (low = HDMI, high = USB), so HDMI-out and right-port USB host are mutually
+  exclusive. The near-term selection is static (a DT default) plus a runtime
+  sysfs "mode" attribute, deliberately decoupled from the Type-C/fusb302 CC
+  state machine.
+
+properties:
+  compatible:
+    const: planet,gemini-rightport-mux
+
+  sw-en-gpios:
+    maxItems: 1
+    description: |
+      OTG/HDMI lane-mux enable (vendor fusb301a_sw_en, GPIO70). Driven low for
+      HDMI, high for USB host.
+
+  sw-sel-gpios:
+    maxItems: 1
+    description: |
+      Lane orientation select (vendor fusb301a_sw_sel, GPIO71); the CC
+      orientation in HDMI mode (CC1 = low, CC2 = high). Static selection uses
+      the CC1 default; CC-driven orientation is part of HPD-gated switching.
+
+  sw7226-en-gpios:
+    maxItems: 1
+    description: |
+      Master mux select and USB VBUS load-switch enable (vendor sw7226_en,
+      GPIO72). Low routes HDMI, high routes USB host — the mutual-exclusion
+      interlock.
+
+  planet,default-mode:
+    $ref: /schemas/types.yaml#/definitions/string
+    enum: [ hdmi, usb-host ]
+    default: usb-host
+    description: |
+      Mux mode applied at probe. Defaults to usb-host to preserve the
+      right-port host bring-up behaviour.
+
+  pinctrl-names:
+    items:
+      - const: hdmi
+      - const: usb-host
+
+  pinctrl-0: true
+  pinctrl-1: true
+
+required:
+  - compatible
+  - sw-en-gpios
+  - sw-sel-gpios
+  - sw7226-en-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    rightport-mux {
+        compatible = "planet,gemini-rightport-mux";
+        sw-en-gpios = <&pio 70 GPIO_ACTIVE_HIGH>;
+        sw-sel-gpios = <&pio 71 GPIO_ACTIVE_HIGH>;
+        sw7226-en-gpios = <&pio 72 GPIO_ACTIVE_HIGH>;
+        planet,default-mode = "usb-host";
+    };
