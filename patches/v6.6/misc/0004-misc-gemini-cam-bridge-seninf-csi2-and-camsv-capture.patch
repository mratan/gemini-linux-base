+/* -------------------------------------------------------------------------
+ * Format
+ *
+ * One format only: the SGRBG10 the Hi-556 emits, packed the way CAMSV's PAK
+ * block writes it. Anything else would be a claim this driver has not tested.
+ */
+/*
+ * V4L2_PIX_FMT_SGRBG10P, not ...SGRBG10.
+ *
+ * CAMSV's PAK block is configured for RAW10 and the DMA is given a line length
+ * of width * 10 / 8, so what lands in memory is standard CSI-2 packing: four
+ * pixels in five bytes, four most-significant bytes followed by one byte
+ * holding their four low bit-pairs. V4L2_PIX_FMT_SGRBG10 means something else
+ * entirely -- 10 bits in a 16-bit container, two bytes per pixel -- so
+ * advertising it describes a buffer twice the size of the one written, and
+ * anything that believed us would read garbage.
+ *
+ * Measured rather than reasoned: a captured test-pattern row contains only the
+ * four byte values 0x00, 0x0f, 0xf0 and 0xff, which is exactly what black and
+ * white pixels give under 4-in-5 packing (the MSB bytes saturate, and the
+ * shared low-bits byte takes 0x00, 0xff, or 0x0f/0xf0 across a bar edge). An
+ * unpacked buffer could not produce that set.
+ */
+static void gemini_cam_fill_format(struct v4l2_pix_format *f)
+{
+	f->pixelformat = V4L2_PIX_FMT_SGRBG10P;
+	f->field = V4L2_FIELD_NONE;
+	f->colorspace = V4L2_COLORSPACE_RAW;
+	f->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	f->quantization = V4L2_QUANTIZATION_DEFAULT;
+	f->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+
+	f->width = clamp_t(u32, ALIGN(f->width, 2), 64, 2592);
+	f->height = clamp_t(u32, ALIGN(f->height, 2), 64, 1944);
+	f->bytesperline = ALIGN(DIV_ROUND_UP(f->width * 10, 8), 2);
+	f->sizeimage = f->bytesperline * f->height;
+}
+
+/* -------------------------------------------------------------------------
+ * videobuf2
+ */
+static int gemini_cam_queue_setup(struct vb2_queue *vq, unsigned int *nbufs,
+				  unsigned int *nplanes, unsigned int sizes[],
+				  struct device *alloc_devs[])
+{
+	struct gemini_cam *cam = vb2_get_drv_priv(vq);
+	unsigned int size = cam->format.sizeimage;
+
+	/* The FBC slot count is a 4-bit field. */
+	*nbufs = clamp_t(unsigned int, *nbufs, 2, 15);
+
+	if (*nplanes) {
+		if (*nplanes != 1 || sizes[0] < size)
+			return -EINVAL;
+		return 0;
+	}
+
+	*nplanes = 1;
+	sizes[0] = size;
+	return 0;
+}
+
+static int gemini_cam_buf_prepare(struct vb2_buffer *vb)
+{
+	struct gemini_cam *cam = vb2_get_drv_priv(vb->vb2_queue);
+	struct gemini_cam_buffer *buf = to_cam_buffer(vb);
+
+	if (vb2_plane_size(vb, 0) < cam->format.sizeimage) {
+		dev_err(cam->dev, "buffer too small: %lu < %u\n",
+			vb2_plane_size(vb, 0), cam->format.sizeimage);
+		return -EINVAL;
+	}
+
+	vb2_set_plane_payload(vb, 0, cam->format.sizeimage);
+	buf->vb.field = V4L2_FIELD_NONE;
+	buf->daddr = vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	/*
+	 * CAMSV_IMGO_BASE_ADDR is a 32-bit register and this SoC has memory
+	 * above 4 GB. A buffer the DMA cannot address must be refused, not
+	 * truncated into somebody else's pages.
+	 */
+	if (upper_32_bits(buf->daddr)) {
+		dev_err(cam->dev, "buffer at %pad is above the 32-bit DMA window\n",
+			&buf->daddr);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void gemini_cam_buf_queue(struct vb2_buffer *vb)
+{
+	struct gemini_cam *cam = vb2_get_drv_priv(vb->vb2_queue);
+	struct gemini_cam_buffer *buf = to_cam_buffer(vb);
+	bool streaming = vb2_start_streaming_called(vb->vb2_queue);
+	unsigned long flags;
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	if (streaming && list_empty(&cam->buf_list))
+		gemini_cam_set_buffer(cam, buf);
+	list_add_tail(&buf->list, &cam->buf_list);
+	if (streaming && use_fbc)
+		gemini_cam_fbc_inc(cam);
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+}
+
+static void gemini_cam_return_buffers(struct gemini_cam *cam,
+				      enum vb2_buffer_state state)
+{
+	struct gemini_cam_buffer *buf, *tmp;
+	unsigned long flags;
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	list_for_each_entry_safe(buf, tmp, &cam->buf_list, list) {
+		list_del(&buf->list);
+		vb2_buffer_done(&buf->vb.vb2_buf, state);
+	}
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+}
+
+static int gemini_cam_start_streaming(struct vb2_queue *vq, unsigned int count)
+{
+	struct gemini_cam *cam = vb2_get_drv_priv(vq);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(cam->dev);
+	if (ret < 0) {
+		dev_err(cam->dev, "runtime resume: %d\n", ret);
+		goto err_return;
+	}
+
+	memset(&cam->stats, 0, sizeof(cam->stats));
+	cam->sequence = (unsigned int)-1;
+
+	ret = video_device_pipeline_start(&cam->vdev, &cam->pipeline);
+	if (ret) {
+		dev_err(cam->dev, "pipeline start: %d\n", ret);
+		goto err_pm;
+	}
+
+	gemini_cam_camsv_setup(cam, count);
+	gemini_cam_camsv_vf_enable(cam);
+
+	ret = v4l2_subdev_call(&cam->sd, video, s_stream, 1);
+	if (ret)
+		goto err_pipeline;
+
+	cam->streaming = true;
+	sysfs_notify(&cam->dev->kobj, NULL, "streaming");
+	return 0;
+
+err_pipeline:
+	gemini_cam_camsv_vf_disable(cam);
+	video_device_pipeline_stop(&cam->vdev);
+err_pm:
+	pm_runtime_put(cam->dev);
+err_return:
+	gemini_cam_return_buffers(cam, VB2_BUF_STATE_QUEUED);
+	return ret;
+}
+
+static void gemini_cam_stop_streaming(struct vb2_queue *vq)
+{
+	struct gemini_cam *cam = vb2_get_drv_priv(vq);
+
+	cam->streaming = false;
+	sysfs_notify(&cam->dev->kobj, NULL, "streaming");
+
+	v4l2_subdev_call(&cam->sd, video, s_stream, 0);
+	gemini_cam_camsv_vf_disable(cam);
+	gemini_cam_return_buffers(cam, VB2_BUF_STATE_ERROR);
+	video_device_pipeline_stop(&cam->vdev);
+
+	dev_info(cam->dev,
+		 "stream stopped: %u frames, %u sof, %u dropped, errors tg %u gb %u imgo %u ovr %u, mux_intsta 0x%08x, csi2 packets %u, tg frmsize 0x%08x\n",
+		 cam->stats.frames, cam->stats.sof, cam->stats.dropped,
+		 cam->stats.tg_err, cam->stats.tg_gberr, cam->stats.imgo_err,
+		 cam->stats.imgo_overrun, cam->stats.mux_intsta,
+		 cam->stats.csi2_packets, cam->stats.tg_frmsize);
+	dev_info(cam->dev,
+		 "  csi-2: int 0x%08x/0x%08x, lane fsm 0x%08x, clock fsm 0x%08x, frame/line 0x%08x\n",
+		 cam->stats.csi2_int, cam->stats.csi2_int_ext,
+		 cam->stats.lane_fsm, cam->stats.clk_fsm,
+		 cam->stats.frame_line);
+
+	pm_runtime_put(cam->dev);
+}
