+/*
+ * Enumeration is filtered by media bus code, which is what a device that
+ * declares V4L2_CAP_IO_MC is expected to support: userspace asks "given the
+ * sensor is emitting this code, what can you write to memory?" rather than
+ * assuming. libcamera's simple pipeline handler asks exactly that, and
+ * refuses the camera outright if the answer is "filtering not supported" --
+ * which is what this returned before, and why the device enumerated as no
+ * camera at all despite the pipeline handler matching it.
+ *
+ * There is one code and one format, so honouring the filter is a comparison.
+ */
+static int gemini_cam_enum_fmt(struct file *file, void *priv,
+			       struct v4l2_fmtdesc *f)
+{
+	if (f->mbus_code && f->mbus_code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+	if (f->index)
+		return -EINVAL;
+	f->pixelformat = V4L2_PIX_FMT_SGRBG10P;
+	return 0;
+}
+
+static int gemini_cam_g_fmt(struct file *file, void *priv,
+			    struct v4l2_format *f)
+{
+	struct gemini_cam *cam = video_drvdata(file);
+
+	f->fmt.pix = cam->format;
+	return 0;
+}
+
+static int gemini_cam_try_fmt(struct file *file, void *priv,
+			      struct v4l2_format *f)
+{
+	gemini_cam_fill_format(&f->fmt.pix);
+	return 0;
+}
+
+static int gemini_cam_s_fmt(struct file *file, void *priv,
+			    struct v4l2_format *f)
+{
+	struct gemini_cam *cam = video_drvdata(file);
+
+	if (vb2_is_busy(&cam->queue))
+		return -EBUSY;
+
+	gemini_cam_fill_format(&f->fmt.pix);
+	cam->format = f->fmt.pix;
+	return 0;
+}
+
+static int gemini_cam_enum_framesizes(struct file *file, void *priv,
+				      struct v4l2_frmsizeenum *fsize)
+{
+	/*
+	 * The sensor's own mode table is the authority on what sizes exist;
+	 * this only says what the DMA can carry. Userspace picks a mode by
+	 * setting the format on the sensor subdev.
+	 */
+	if (fsize->index || fsize->pixel_format != V4L2_PIX_FMT_SGRBG10P)
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = 64;
+	fsize->stepwise.max_width = 2592;
+	fsize->stepwise.step_width = 2;
+	fsize->stepwise.min_height = 64;
+	fsize->stepwise.max_height = 1944;
+	fsize->stepwise.step_height = 2;
+	return 0;
+}
+
+static int gemini_cam_enum_input(struct file *file, void *priv,
+				 struct v4l2_input *inp)
+{
+	if (inp->index)
+		return -EINVAL;
+	inp->type = V4L2_INPUT_TYPE_CAMERA;
+	strscpy(inp->name, "Camera", sizeof(inp->name));
+	return 0;
+}
+
+static int gemini_cam_g_input(struct file *file, void *priv, unsigned int *i)
+{
+	*i = 0;
+	return 0;
+}
+
+static int gemini_cam_s_input(struct file *file, void *priv, unsigned int i)
+{
