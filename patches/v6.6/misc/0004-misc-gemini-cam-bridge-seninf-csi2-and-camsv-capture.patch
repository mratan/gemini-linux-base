+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/planet,gemini-camera-bridge.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Planet Computers Gemini PDA camera capture pipeline
+
+maintainers:
+  - Gemini PDA Linux port <https://github.com/mratan/gemini-linux>
+
+description: |
+  The camera data path on the Gemini PDA (MT6797): the media device the
+  sensor's async subdev attaches to, the SENINF CSI-2 receiver in front of it,
+  and the CAMSV0 DMA engine behind it, which writes raw Bayer frames straight
+  to memory with no image processing.
+
+  Three register windows, because the blocks are not contiguous and two of them
+  are shared:
+
+    * SENINF (0x1a040000) is shared with planet,gemini-camera-power, which owns
+      the per-socket master clocks inside it. Neither driver claims the region.
+    * CAMSV0 (0x1a050000) is the first of six identical DMA engines 0x1000
+      apart; only the first is used.
+    * mipi_RX_ana (0x10217000) is the CSI-2 analog receiver. On this SoC one
+      page holds six banks 0x200 apart -- CSI0A, CSI0B, CSI1A, CSI1B, CSI2A,
+      CSI2B -- rather than a page per PHY as on later parts.
+
+properties:
+  compatible:
+    const: planet,gemini-camera-bridge
+
+  reg:
+    maxItems: 3
+
+  reg-names:
+    items:
+      - const: seninf
+      - const: camsv
+      - const: mipi-ana
+
+  interrupts:
+    maxItems: 1
+    description: CAMSV0 pass-1-done.
+
+  clocks:
+    maxItems: 3
+    description:
+      The three CAMSV gates. The vendor gate table has one gate per CAMSV pair
+      and the vendor enables all three together whenever any CAMSV runs.
+
+  clock-names:
+    items:
+      - const: camsv0
+      - const: camsv1
+      - const: camsv2
+
+  power-domains:
+    maxItems: 1
+    description:
+      The camera domain. Its rails, camsys gates, ISP MTCMOS domain and SENINF
+      master clocks come up with it and go back down when nothing is streaming.
+
+  iommus:
+    maxItems: 1
+    description:
+      The CAMSV output DMA port on SMI larb2. This is not optional - the M4U
+      translates the port whether or not the kernel has mapped it, so a device
+      without this property faults on every burst.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    description: Input port, connected to the image sensor.
+
+    properties:
+      endpoint:
+        $ref: video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            minItems: 1
+            maxItems: 4
+
+        required:
+          - data-lanes
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+  - iommus
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/clock/mt6797-clk.h>
+    #include <dt-bindings/memory/mt6797-larb-port.h>
+
+    camera-bridge@1a050000 {
+        compatible = "planet,gemini-camera-bridge";
+        reg = <0x1a040000 0x8000>,
+              <0x1a050000 0x1000>,
+              <0x10217000 0x1000>;
+        reg-names = "seninf", "camsv", "mipi-ana";
+        interrupts = <GIC_SPI 252 IRQ_TYPE_LEVEL_LOW>;
+        clocks = <&camsys CLK_CAM_CAMSV0>,
+                 <&camsys CLK_CAM_CAMSV1>,
+                 <&camsys CLK_CAM_CAMSV2>;
+        clock-names = "camsv0", "camsv1", "camsv2";
+        power-domains = <&camera_power>;
+        iommus = <&m4u M4U_PORT_CAM_SV0>;
+
+        port {
+            cam_bridge_in: endpoint {
+                remote-endpoint = <&hi556_out>;
+                data-lanes = <1 2>;
+            };
+        };
+    };
