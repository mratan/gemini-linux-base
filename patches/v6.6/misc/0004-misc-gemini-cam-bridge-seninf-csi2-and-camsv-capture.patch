Subject: [PATCH] misc: gemini-cam-bridge: SENINF CSI-2 receiver and CAMSV capture (#65)

diff --git a/drivers/misc/gemini-cam-bridge.c b/drivers/misc/gemini-cam-bridge.c
--- a/drivers/misc/gemini-cam-bridge.c
+++ b/drivers/misc/gemini-cam-bridge.c
@@ -1,155 +1,2279 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Gemini PDA camera media-graph bridge.
+ * Gemini PDA camera pipeline: SENINF CSI-2 receiver + CAMSV DMA capture.
  *
- * Bring-up scaffolding for Track 4, slice #64: the minimal media device that
- * binds the sensor's async V4L2 subdev and exposes it as a /dev/v4l-subdev with
- * a media-controller entity. It deliberately does NO CSI/SENINF data-path work
- * (that is #65) — it is only the "media graph seam" the sensor attaches to, so
- * media-ctl and v4l2-ctl can enumerate the sensor, its formats and its controls.
+ * WHAT THIS IS
  *
- * =m and self-contained, like the rest of the camera bring-up.
+ * Slice #64 left a bare media device here — enough for the sensor subdev to
+ * attach to, and nothing else. Slice #65 turns it into a real capture path:
+ *
+ *	hi556 (sensor) --> [gemini-seninf] --> /dev/video0 (CAMSV0 DMA)
+ *
+ * The SENINF is the SoC's sensor interface: a CSI-2 receiver per input, a
+ * crossbar (TOP MUX) from inputs to FIFO muxes, and a second crossbar (CAM
+ * MUX) from those muxes to the consumers — CAM_A/CAM_B (the hardware ISP) and
+ * six CAMSV instances. CAMSV is the bypass path: it takes a mux output and
+ * writes it to memory with no image processing at all, which is exactly what
+ * #65 asks for (raw Bayer in memory) and is also what libcamera's software ISP
+ * wants underneath it.
+ *
+ * WHERE THE REGISTER KNOWLEDGE COMES FROM
+ *
+ * Three independent sources, which agree:
+ *
+ *  1. The MT6797 Functional Specification §6.10 register-bank table (in
+ *     07-kernel/wt-main/docs/) gives the bank base addresses:
+ *
+ *		seninf_top   +1a040000	 SENINF1_TG   +1a040600
+ *		seninf1      +1a040200	 SENINF1_NCSI2 +1a040700
+ *		seninf1_csi2 +1a040a00	 seninf1_mux  +1a040d00
+ *		mipi_RX_config_csi0 +1a040800	 mipi_RX_ana +10217000
+ *
+ *     and each further instance at +0x1000. NOTE: 0x1a041000 is reserved
+ *     space, NOT "SENINF1" — an earlier misreading of this map cost this
+ *     project a week and produced a fictitious "DEVAPC lock". See
+ *     04-docs/CAMERA-SENSORS-2026-08-24.md.
+ *
+ *  2. The vendor 3.18 kernel
+ *     (drivers/misc/mediatek/cameraisp/src/mt6797/camera_isp.c) gives the
+ *     complete CAMSV register map, its base addresses (CAMSV0 0x1a050000,
+ *     stride 0x1000) and its interrupt bit assignments.
+ *
+ *  3. The upstream MediaTek ISP3.0 drivers for MT8365 (mtk_seninf.c,
+ *     mtk_camsv_hw.c, posted as "Add Mediatek ISP3.0" v8) give the bit-level
+ *     field definitions. That IP is the same generation as this one: their
+ *     SENINF_MUX_CTRL "normal mode" value computes to exactly 0x86df0080,
+ *     which is byte-for-byte what the vendor stack writes to seninf1_mux and
+ *     seninf2_mux on this device (captured live, 2026-08-25). Their CAMSV
+ *     register block is this one shifted by 0x10, and their TG block is this
+ *     one's +0x4f0 — every offset lines up.
+ *
+ * WHAT IS STILL GUESSED, AND HOW TO SWEEP IT
+ *
+ * Three things are board wiring that no document in hand states: which SENINF
+ * instance the front sensor's CSI-2 lanes land on, which physical D-PHY lanes
+ * carry its clock and data, and which CAM MUX output CAMSV0 consumes. The
+ * defaults below are the best inference (the vendor drives the sub sensor's
+ * MCLK from SENINF2_TG, so SENINF instance 1; CAM MUX 2 is the first consumer
+ * after CAM_A/CAM_B). All three are module parameters so they can be swept on
+ * the device against a real instrument — the CSI-2 packet counter and the TG
+ * frame-size register — rather than argued about. See "stats" in debugfs.
  */
+
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
 #include <linux/property.h>
+#include <linux/seq_file.h>
+
+#include <media/media-device.h>
 #include <media/v4l2-async.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
-#include <media/media-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-ioctl.h>
+#include <media/v4l2-mc.h>
+#include <media/v4l2-subdev.h>
+#include <media/videobuf2-dma-contig.h>
+#include <media/videobuf2-v4l2.h>
+
+/* -------------------------------------------------------------------------
+ * SENINF registers (offsets from seninf_top, 0x1a040000)
+ */
+#define SENINF_INST_STRIDE			0x1000
+
+#define SENINF_TOP_CTRL				0x0000
+#define SENINF_TOP_CTRL_PCLK_EN			BIT(10)
+#define SENINF_TOP_CTRL_PCLK2_EN		BIT(11)
+#define SENINF_TOP_MUX_CTRL			0x0008
+#define SENINF_TOP_CAM_MUX_CTRL			0x0010
+#define SENINF_TOP_PHY_CTL(csi)			(0x001c + (csi) * 4)
+#define SENINF_TOP_PHY_CTL_DPHY_MODE		BIT(0)
+#define SENINF_TOP_PHY_CTL_CK_SEL_1		GENMASK(10, 8)
+#define SENINF_TOP_PHY_CTL_CK_SEL_2		GENMASK(13, 12)
+#define SENINF_TOP_PHY_CTL_LANE_MUX_EN		BIT(31)
+
+/* Per-instance, relative to seninf_top + inst * SENINF_INST_STRIDE. */
+#define SENINF_CTRL				0x0200
+#define SENINF_CTRL_SENINF_EN			BIT(0)
+#define SENINF_CTRL_CSI2_SW_RST			BIT(7)
+/*
+ * Four bits, not the three the MT8365 header declares: the vendor masks this
+ * field with 0xffff0fff and then ORs 0x8000 into it, so bit 15 is part of it
+ * and the NCSI2 source value is 8.
+ */
+#define SENINF_CTRL_SENINF_SRC_SEL		GENMASK(15, 12)
+#define SENINF_CTRL_PAD2CAM_DATA_SEL		GENMASK(30, 28)
+#define SENINF_CTRL_EXT				0x0204
+#define SENINF_CTRL_EXT_TESTMDL_IP_EN		BIT(1)
+#define SENINF_CTRL_EXT_NCSI2_IP_EN		BIT(5)
+#define SENINF_CTRL_EXT_CSI2_IP_EN		BIT(6)
+
+#define SENINF_TG_PH_CNT			0x0600
+#define SENINF_TG_SEN_CK			0x0604
+#define SENINF_TG_SEN_CK_CLKCNT			GENMASK(21, 16)
+#define SENINF_TG_TM_CTL			0x0608
+#define SENINF_TG_TM_SIZE			0x060c
+#define SENINF_TG_TM_CLK			0x0610
+#define SENINF_TG_TM_STP			0x0614
+
+/*
+ * mipi_RX_config_csi<n>, at seninf instance + 0x800 (MT6797 Functional Spec
+ * §6.10 bank table). This is the digital half of the D-PHY, and it is the
+ * piece neither the MT8183 RFC nor the MT8365 upstream driver configures --
+ * they were written for parts where it comes up usable at reset. Offsets and
+ * values are transcribed from SeninfDrvImp::setSeninfCSI2 in the vendor HAL
+ * (libcam.halsensor.so, /vendor/lib64 of the stock system image).
+ */
+#define SENINF_MIPI_RX_CON24			0x0824
+/* Five per-lane enables: +0x88c, 0x890, 0x894, 0x898 and 0x8a0. */
+#define SENINF_MIPI_RX_LANE_EN(n)		((n) < 4 ? 0x088c + (n) * 4 : 0x08a0)
+#define SENINF_NCSI2_CTL			0x0700
+#define SENINF_NCSI2_CTL_LANE_MASK		GENMASK(3, 0)
+#define SENINF_NCSI2_CTL_FIXED			0x04000010
+#define SENINF_NCSI2_CTL_B7			BIT(7)
+#define SENINF_NCSI2_SETTLE			0x0708
+#define SENINF_NCSI2_SPARE			0x070c
+#define SENINF_NCSI2_INT_EN			0x0710
+#define SENINF_NCSI2_INT_EN_ALL			0x80007fff
+#define SENINF_NCSI2_HSRX_DBG			0x0738
+#define SENINF_MIPI_RX_CON00			0x0800
+#define SENINF_MIPI_RX_CON04			0x0804
+#define SENINF_MIPI_RX_CON08			0x0808
+#define SENINF_MIPI_RX_CAL_CTL			0x0838
+#define SENINF_MIPI_RX_CAL_CTL_EN		BIT(0)
+#define SENINF_MIPI_RX_CAL_CTL_SEARCH		BIT(1)
+#define SENINF_MIPI_RX_CAL_CTL_TRIG		BIT(2)
+#define SENINF_MIPI_RX_CAL_CFG			0x083c
+#define SENINF_MIPI_RX_CAL_CFG_VALUE		0x1541
+#define SENINF_MIPI_RX_CAL_ST0			0x0844
+#define SENINF_MIPI_RX_CAL_ST0_DONE		0x00010001
+#define SENINF_MIPI_RX_CAL_ST1			0x0848
+#define SENINF_MIPI_RX_CAL_ST1_DONE		0x00000101
+#define SENINF_MIPI_RX_CONB0			0x08b0
+#define SENINF_MIPI_RX_CONB4			0x08b4
+#define SENINF_MIPI_RX_CONB8			0x08b8
+#define SENINF_MIPI_RX_CONBC			0x08bc
+#define SENINF_MIPI_RX_CONC0			0x08c0
+#define SENINF_MIPI_RX_COND0			0x08d0
+#define SENINF_MIPI_RX_CON24_LN0_MUX		GENMASK(25, 24)
+#define SENINF_MIPI_RX_CON24_LN1_MUX		GENMASK(27, 26)
+#define SENINF_MIPI_RX_CON24_LN2_MUX		GENMASK(29, 28)
+#define SENINF_MIPI_RX_CON24_LN3_MUX		GENMASK(31, 30)
+
+#define SENINF_CSI2_CTL				0x0a00
+#define SENINF_CSI2_CTL_CLOCK_LANE_EN		BIT(4)
+#define SENINF_CSI2_CTL_HSRX_DET_EN		BIT(7)
+#define SENINF_CSI2_CTL_ED_SEL			BIT(16)
+#define SENINF_CSI2_CTL_HS_TRAIL_EN		BIT(25)
+#define SENINF_CSI2_CTL_CLOCK_HS_OPTION		BIT(27)
+#define SENINF_CSI2_LNRD_TIMING			0x0a08
+#define SENINF_CSI2_LNRD_TIMING_DATA_SETTLE	GENMASK(15, 8)
+#define SENINF_CSI2_DPCM			0x0a0c
+#define SENINF_CSI2_DPCM_DI_30_EN		BIT(7)
+#define SENINF_CSI2_DGB_SEL			0x0a18
+#define SENINF_CSI2_DGB_SEL_DEBUG_SEL		GENMASK(7, 0)
+#define SENINF_CSI2_DGB_SEL_DEBUG_EN		BIT(31)
+#define SENINF_CSI2_DGB_PORT			0x0a1c
+#define SENINF_CSI2_SPARE0			0x0a20
+#define SENINF_CSI2_INT_EN			0x0a10
+#define SENINF_CSI2_INT_STATUS			0x0a14
+#define SENINF_CSI2_LNRC_FSM			0x0a28
+#define SENINF_CSI2_LNRD_FSM			0x0a2c
+#define SENINF_CSI2_FRAME_LINE_NUM		0x0a30
+#define SENINF_CSI2_HSRX_DBG			0x0a38
+#define SENINF_CSI2_HSRX_DBG_EN_ALL		0x1f
+#define SENINF_CSI2_CTRL_TRIO_CON		0x0a7c
+#define SENINF_CSI2_SYNC_RESYNC_CTL		0x0aa8
+#define SENINF_CSI2_POST_DETECT_CTL		0x0aac
+#define SENINF_CSI2_INT_EN_EXT			0x0b10
+#define SENINF_CSI2_INT_STATUS_EXT		0x0b14
+#define SENINF_CSI2_HS_TRAIL			0x0a40
+#define SENINF_CSI2_HS_TRAIL_PARAM		GENMASK(7, 0)
+#define SENINF_CSI2_RESYNC_MERGE_CTL		0x0a74
+#define SENINF_CSI2_RESYNC_CPHY_CNT		GENMASK(2, 0)
+#define SENINF_CSI2_RESYNC_BYPASS		BIT(10)
+#define SENINF_CSI2_RESYNC_CDPHY_SEL		BIT(11)
+#define SENINF_CSI2_MODE			0x0ae8
+#define SENINF_CSI2_MODE_CSI2_MODE		GENMASK(7, 0)
+#define SENINF_CSI2_MODE_HEADER_LEN		GENMASK(10, 8)
+#define SENINF_CSI2_DPHY_SYNC			0x0b20
+#define SENINF_CSI2_DPHY_SYNC_MASK_0		GENMASK(15, 0)
+#define SENINF_CSI2_DPHY_SYNC_PAT_0		GENMASK(31, 16)
+
+/*
+ * mipi_RX_ana (0x10217000). One page, but NOT one PHY: MT6797 packs six
+ * identical banks 0x200 apart -- CSI0A, CSI0B, CSI1A, CSI1B, CSI2A, CSI2B --
+ * where MT8183 gave each its own 0x1000 page. Which bank belongs to which
+ * socket is board wiring; on this device the front sensor answers on the bank
+ * at +0x400, established by configuring one bank at a time and watching which
+ * one makes the SENINF lane state machines leave idle.
+ */
+#define MIPI_RX_ANA_BANK_STRIDE			0x200
+#define MIPI_RX_ANA00				0x0000
+#define MIPI_RX_ANA00_CPHY_EN			BIT(0)
+#define MIPI_RX_ANA00_BG_LPF_EN			BIT(2)
+#define MIPI_RX_ANA00_BG_CORE_EN		BIT(3)
+#define MIPI_RX_ANA00_L0_CKMODE_EN		BIT(5)
+#define MIPI_RX_ANA00_L0_CKSEL			BIT(6)
+#define MIPI_RX_ANA00_L1_CKMODE_EN		BIT(8)
+#define MIPI_RX_ANA00_L1_CKSEL			BIT(9)
+#define MIPI_RX_ANA00_L2_CKMODE_EN		BIT(11)
+#define MIPI_RX_ANA00_L2_CKSEL			BIT(12)
+/* Bits 4, 7 and 10 are set at reset and the vendor clears all three. */
+#define MIPI_RX_ANA00_RESET_BITS		(BIT(4) | BIT(7) | BIT(10))
+#define MIPI_RX_ANA04				0x0004
+#define MIPI_RX_ANA04_F1			GENMASK(10, 8)
+#define MIPI_RX_ANA04_F2			GENMASK(15, 12)
+#define MIPI_RX_ANA18				0x0018
+#define MIPI_RX_ANA1C				0x001c
+#define MIPI_RX_ANA20				0x0020
+#define MIPI_RX_ANA_EQ_IS			GENMASK(7, 6)
+#define MIPI_RX_ANA_EQ_BW			GENMASK(23, 22)
+#define MIPI_RX_WRAPPER80			0x0080
+#define MIPI_RX_WRAPPER80_F			GENMASK(7, 4)
+
+/* Per-mux, relative to seninf_top + mux * SENINF_INST_STRIDE. */
+#define SENINF_MUX_CTRL				0x0d00
+#define SENINF_MUX_CTRL_MUX_SW_RST		BIT(0)
+#define SENINF_MUX_CTRL_IRQ_SW_RST		BIT(1)
+#define SENINF_MUX_CTRL_PIX_SEL			BIT(8)
+#define SENINF_MUX_CTRL_VSYNC_POL		BIT(9)
+#define SENINF_MUX_CTRL_HSYNC_POL		BIT(10)
+#define SENINF_MUX_CTRL_SRC_SEL			GENMASK(15, 12)
+#define SENINF_MUX_CTRL_FIFO_PUSH_EN		GENMASK(21, 16)
+#define SENINF_MUX_CTRL_FIFO_FLUSH_EN		GENMASK(28, 22)
+#define SENINF_MUX_CTRL_FIFO_FULL_WR_EN		GENMASK(29, 28)
+#define SENINF_MUX_CTRL_MUX_EN			BIT(31)
+#define SENINF_MUX_INTEN			0x0d04
+#define SENINF_MUX_INTSTA			0x0d08
+#define SENINF_MUX_SPARE			0x0d2c
+#define SENINF_MUX_SPARE_FIFO_FULL_SEL		BIT(13)
+#define SENINF_MUX_CTRL_EXT			0x0d3c
+#define SENINF_MUX_CTRL_EXT_SRC_SEL_EXT		GENMASK(1, 0)
+#define SENINF_MUX_CTRL_EXT_PIX_SEL_EXT		BIT(4)
+
+#define FIFO_PUSH_EN_NORMAL_MODE		0x1f
+#define FIFO_FLUSH_EN_NORMAL_MODE		0x1b
+#define SENINF_MIPI_SENSOR			0x8
+#define SENINF_NORMAL_MODEL			1
+#define SENINF_PAD_10BIT			0
+#define SENINF_TIMESTAMP_STEP			0x67
+#define SENINF_SETTLE_DELAY			0x15
+#define SENINF_HS_TRAIL_PARAMETER		0x8
+
+/*
+ * The MUX interrupt status bits are not documented in anything available
+ * here. The vendor's CAMSV path reports the same conditions (TG error, TG
+ * grab error, DMA overrun) through its own interrupt, which is what this
+ * driver counts. SENINF_MUX_INTSTA is read and its raw value latched into the
+ * stats so a marginal link shows up as a non-zero word even before anybody
+ * knows which bit is which.
+ */
+
+/* -------------------------------------------------------------------------
+ * CAMSV registers (offsets from CAMSV0, 0x1a050000). Vendor camera_isp.c.
+ */
+#define CAMSV_MODULE_EN				0x0010
+#define CAMSV_MODULE_EN_TG_EN			BIT(0)
+#define CAMSV_MODULE_EN_PAK_EN			BIT(2)
+#define CAMSV_MODULE_EN_IMGO_EN			BIT(4)
+#define CAMSV_MODULE_EN_DB_EN			BIT(30)
+#define CAMSV_FMT_SEL				0x0014
+#define CAMSV_FMT_SEL_TG1_FMT_RAW_10		0x1
+#define CAMSV_INT_EN				0x0018
+#define CAMSV_INT_STATUS			0x001c
+#define CAMSV_SW_CTL				0x0020
+#define CAMSV_SW_CTL_IMGO_RST_TRIG		BIT(0)
+#define CAMSV_SW_CTL_IMGO_RST_ST		BIT(1)
+#define CAMSV_SW_CTL_SW_RST			BIT(2)
+#define CAMSV_IMGO_FBC				0x002c
+#define CAMSV_IMGO_FBC_RCNT_INC			BIT(11)
+#define CAMSV_IMGO_FBC_EN			BIT(14)
+#define CAMSV_IMGO_FBC_FB_NUM			GENMASK(19, 16)
+#define CAMSV_CLK_EN				0x0030
+#define CAMSV_CLK_EN_TG_DP			BIT(0)
+#define CAMSV_CLK_EN_PAK_DP			BIT(2)
+#define CAMSV_CLK_EN_DMA_DP			BIT(15)
+#define CAMSV_PAK				0x004c
+#define CAMSV_PAK_MODE_RAW_10			0x2
+#define CAMSV_PAK_DBL_MODE_2_PIXELS		BIT(2)
+
+#define CAMSV_IMGO_BASE_ADDR			0x0220
+#define CAMSV_IMGO_XSIZE			0x0230
+#define CAMSV_IMGO_YSIZE			0x0234
+#define CAMSV_IMGO_STRIDE			0x0238
+#define CAMSV_IMGO_STRIDE_BUS_SIZE_32		GENMASK(17, 16)
+#define CAMSV_IMGO_STRIDE_BUS_SIZE_EN		BIT(19)
+#define CAMSV_IMGO_CON				0x023c
+#define CAMSV_IMGO_CON_FIFO_SIZE		GENMASK(7, 0)
+#define CAMSV_IMGO_CON_MAX_BURST_LEN		GENMASK(31, 28)
+#define CAMSV_IMGO_CON2				0x0240
+#define CAMSV_IMGO_CON2_PRI_THRL		GENMASK(15, 8)
+#define CAMSV_IMGO_CON2_PRI_THRH		GENMASK(23, 16)
+#define CAMSV_IMGO_ERR_STAT			0x0444
+
+#define CAMSV_TG_SEN_MODE			0x0500
+#define CAMSV_TG_SEN_MODE_CMOS_EN		BIT(0)
+#define CAMSV_TG_SEN_MODE_DBL_DATA_BUS_EN	BIT(1)
+#define CAMSV_TG_VF_CON				0x0504
+#define CAMSV_TG_VF_CON_VFDATA_EN		BIT(0)
+#define CAMSV_TG_SEN_GRAB_PXL			0x0508
+#define CAMSV_TG_SEN_GRAB_LIN			0x050c
+#define CAMSV_TG_PATH_CFG			0x0510
+#define CAMSV_TG_PATH_CFG_YUV_U2S_DIS		BIT(12)
+#define CAMSV_TG_SOF_CNT			0x0520
+#define CAMSV_TG_FRM_CNT_ST			0x0534
+#define CAMSV_TG_FRMSIZE_ST			0x0538
+#define CAMSV_TG_INTER_ST			0x053c
+
+/* Interrupt bits (vendor camera_isp.c, "CAMSV interrupt status"). */
+#define CAMSV_IRQ_VS1				BIT(0)
+#define CAMSV_IRQ_TG_ST1			BIT(1)
+#define CAMSV_IRQ_TG_ERR			BIT(4)
+#define CAMSV_IRQ_TG_GBERR			BIT(5)
+#define CAMSV_IRQ_SOF				BIT(7)
+#define CAMSV_IRQ_PASS1_DON			BIT(10)
+#define CAMSV_IRQ_IMGO_ERR			BIT(16)
+#define CAMSV_IRQ_IMGO_OVERRUN			BIT(17)
+
+#define CAMSV_INT_ST_MASK			(CAMSV_IRQ_PASS1_DON | CAMSV_IRQ_SOF)
+#define CAMSV_INT_ST_MASK_ERR			(CAMSV_IRQ_TG_ERR | \
+						 CAMSV_IRQ_TG_GBERR | \
+						 CAMSV_IRQ_IMGO_ERR | \
+						 CAMSV_IRQ_IMGO_OVERRUN)
+
+/* -------------------------------------------------------------------------
+ * Board-wiring sweep knobs. See the file header.
+ */
+static unsigned int seninf_inst = 1;
+module_param(seninf_inst, uint, 0644);
+MODULE_PARM_DESC(seninf_inst,
+		 "SENINF instance the sensor's CSI-2 lanes arrive on (0 = seninf1). Default 1: the vendor drives the sub sensor's MCLK from SENINF2_TG.");
+
+static unsigned int seninf_csi = 1;
+module_param(seninf_csi, uint, 0644);
+MODULE_PARM_DESC(seninf_csi,
+		 "D-PHY port index for SENINF_TOP_PHY_CTL (0 = CSI0 at +0x1c)");
+
+static unsigned int seninf_mux = 1;
+module_param(seninf_mux, uint, 0644);
+MODULE_PARM_DESC(seninf_mux, "SENINF FIFO mux index (0 = seninf1_mux)");
+
+static unsigned int seninf_cam_mux = 2;
+module_param(seninf_cam_mux, uint, 0644);
+MODULE_PARM_DESC(seninf_cam_mux,
+		 "CAM MUX output index CAMSV0 consumes. CAM0/CAM1 are CAM_A/CAM_B (the ISP), so 2 is the first CAMSV.");
+
+/*
+ * The SENINF's own test-pattern generator, driven instead of the CSI-2
+ * receiver. It exists so the two halves of this driver can fail separately:
+ * with it on, everything downstream of the SENINF input — the FIFO mux, both
+ * crossbars, CAMSV, the DMA, the interrupt and vb2 — is exercised by a source
+ * that cannot be mis-wired, so "no frames" means the receive path and "frames"
+ * means the D-PHY. Register values are the vendor sequence from the MediaTek
+ * mtk-isp SENINF RFC (seninf_enable_test_pattern, TEST_GEN_PATTERN), whose
+ * register header matches the MT6797 bank table exactly.
+ */
+static bool test_pattern;
+module_param(test_pattern, bool, 0644);
+MODULE_PARM_DESC(test_pattern,
+		 "drive the SENINF test-pattern generator instead of the sensor (bring-up instrument)");
+
