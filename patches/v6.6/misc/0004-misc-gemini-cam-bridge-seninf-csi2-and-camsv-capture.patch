+/*
+ * Pad operations.
+ *
+ * The SENINF does not scale, crop or convert: whatever the sensor emits comes
+ * out the other side. So the format on both pads is the same format, the sink
+ * takes whatever the sensor offers, and the source is read-only.
+ *
+ * These are not decoration. Anything that drives a media pipeline properly --
+ * media-ctl -V, and libcamera's simple pipeline handler, which calls
+ * setFormat() on every entity in the chain -- fails on a subdev with no pad
+ * ops, and fails in a way that reads as "this camera is not supported" rather
+ * than "this driver is incomplete".
+ */
+static int gemini_cam_sd_init_cfg(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+
+	fmt = v4l2_subdev_get_pad_format(sd, state, GEMINI_CAM_PAD_SINK);
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->width = 1296;
+	fmt->height = 972;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+
+	*v4l2_subdev_get_pad_format(sd, state, GEMINI_CAM_PAD_SOURCE) = *fmt;
+	return 0;
+}
+
+static int gemini_cam_sd_enum_mbus_code(struct v4l2_subdev *sd,
+					struct v4l2_subdev_state *state,
+					struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	/*
+	 * One code. The CAMSV path is configured for RAW10 and nothing in this
+	 * driver converts, so offering anything else would be a promise the
+	 * hardware does not keep.
+	 */
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	return 0;
+}
+
+static int gemini_cam_sd_set_fmt(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *format)
+{
+	struct v4l2_mbus_framefmt *sink, *source;
+
+	/* The source pad mirrors the sink; it cannot be set independently. */
+	if (format->pad == GEMINI_CAM_PAD_SOURCE)
+		return v4l2_subdev_get_fmt(sd, state, format);
+
+	format->format.code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	format->format.width = clamp_t(u32, format->format.width, 64, 2592);
+	format->format.height = clamp_t(u32, format->format.height, 64, 1944);
+	format->format.field = V4L2_FIELD_NONE;
+	format->format.colorspace = V4L2_COLORSPACE_RAW;
+
+	sink = v4l2_subdev_get_pad_format(sd, state, GEMINI_CAM_PAD_SINK);
+	*sink = format->format;
+
+	source = v4l2_subdev_get_pad_format(sd, state, GEMINI_CAM_PAD_SOURCE);
+	*source = *sink;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops gemini_cam_sd_pad_ops = {
