+	writel(0x800000ff, inst + SENINF_MIPI_RX_CONC0);
+	reg_update(inst + SENINF_MIPI_RX_CONB8, 0x00000f0fu, 0x00000101u);
+	reg_update(inst + SENINF_MIPI_RX_CONBC, 0x030f7f0fu, 0x00050400u);
+	reg_update(inst + SENINF_MIPI_RX_COND0, 0x0000003fu, 0x0000000fu);
+
+	/* Decode configuration the upstream drivers leave at zero. */
+	writel(0x15, inst + SENINF_CSI2_CTRL_TRIO_CON);
+	writel(0x402, inst + SENINF_CSI2_MODE);
+	reg_update(inst + SENINF_CSI2_RESYNC_MERGE_CTL, 0x17u, 0x15u);
+	reg_update(inst + SENINF_CSI2_SYNC_RESYNC_CTL, 0x7u, 0x1u);
+	writel(readl(inst + SENINF_CSI2_POST_DETECT_CTL) | 2,
+	       inst + SENINF_CSI2_POST_DETECT_CTL);
+
+	/* Report every CSI-2 error the block can raise. */
+	writel(0x9fffffff, inst + SENINF_CSI2_INT_EN);
+	writel(0x9fffffff, inst + SENINF_CSI2_INT_STATUS);
+	writel(SENINF_CSI2_HSRX_DBG_EN_ALL, inst + SENINF_CSI2_INT_EN_EXT);
+}
+
+static void gemini_cam_seninf_start(struct gemini_cam *cam)
+{
+	void __iomem *inst = seninf_inst_base(cam);
+	void __iomem *mux = seninf_mux_base(cam);
+	unsigned int num_lanes = cam->bus.num_data_lanes;
+	u32 val;
+
+	if (test_pattern) {
+		gemini_cam_seninf_testpat(cam);
+		return;
+	}
+
+	/* The SENINF register banks need their own PCLK gates. */
+	reg_update(cam->seninf + SENINF_TOP_CTRL,
+		   SENINF_TOP_CTRL_PCLK_EN | SENINF_TOP_CTRL_PCLK2_EN,
+		   SENINF_TOP_CTRL_PCLK_EN | SENINF_TOP_CTRL_PCLK2_EN);
+
+	/*
+	 * SENINF_TOP_PHY_SENINF_CTL_CSI<n> (+0x1c/0x20/0x24) is deliberately
+	 * NOT written. That is where MT8183 and MT8365 put the D-PHY lane-mux
+	 * enable; on MT6797 those three words read back zero and drop writes,
+	 * because the part predates them. The analog PHY is configured through
+	 * mipi_RX_ana instead, and the SENINF-to-PHY mapping is fixed.
+	 */
+	gemini_cam_phy_setup(cam);
+
+	reg_update(inst + SENINF_MIPI_RX_CON24,
+		   SENINF_MIPI_RX_CON24_LN0_MUX | SENINF_MIPI_RX_CON24_LN1_MUX |
+		   SENINF_MIPI_RX_CON24_LN2_MUX | SENINF_MIPI_RX_CON24_LN3_MUX,
+		   gemini_cam_lane_mux(cam));
+
+	writel(SENINF_TIMESTAMP_STEP, inst + SENINF_TG_TM_STP);
+
+	/*
+	 * SENINF_TG_PH_CNT (+0x600) is deliberately NOT written.
+	 *
+	 * The MT8365 driver writes 0 there, calling it a phase counter whose
+	 * zero value means "sensor powered up, reset deasserted". On MT6797
+	 * bit 31 of that same register is the sensor MASTER CLOCK ENABLE —
+	 * the vendor's live value is 0x80000001, and it is what makes the
+	 * CMMCLK pad toggle at all. Writing 0 stops the sensor's clock, and
+	 * the sensor then NAKs every I2C write: measured on build #78, where
+	 * hi556 failed its very first mode register with -EIO.
+	 *
+	 * SENINF_TG_SEN_CK is left alone for the same reason: it is exactly
+	 * what gemini-camera-power set it to (0x00010001, the vendor's
+	 * captured value: CLKCNT 1, so the 48 MHz CAMTG becomes the 24 MHz
+	 * MCLK the Hi-556 asks for). Recomputing it
+	 * from the link frequency here, as the MT8365 driver does, would move
+	 * the master clock away from a value already proven to make the sensor
+	 * answer on I2C.
+	 */
+
+	/* Enable the input and point it at the CSI-2 receiver. */
+	inst_update(cam, SENINF_CTRL, SENINF_CTRL_SENINF_EN, 1);
+	inst_update(cam, SENINF_CTRL, SENINF_CTRL_PAD2CAM_DATA_SEL,
+		    SENINF_PAD_10BIT);
+	inst_update(cam, SENINF_CTRL, SENINF_CTRL_SENINF_SRC_SEL, 0);
+	if (use_ncsi2) {
+		inst_update(cam, SENINF_CTRL, SENINF_CTRL_SENINF_SRC_SEL, 8);
+		inst_update(cam, SENINF_CTRL_EXT, SENINF_CTRL_EXT_CSI2_IP_EN, 0);
+		inst_update(cam, SENINF_CTRL_EXT, SENINF_CTRL_EXT_NCSI2_IP_EN, 1);
+	} else {
+		inst_update(cam, SENINF_CTRL_EXT, SENINF_CTRL_EXT_CSI2_IP_EN, 1);
+		inst_update(cam, SENINF_CTRL_EXT, SENINF_CTRL_EXT_NCSI2_IP_EN, 0);
+	}
+
+	/* Plain RAW10, no DPCM compression. */
+	writel(SENINF_CSI2_DPCM_DI_30_EN, inst + SENINF_CSI2_DPCM);
+
+	inst_update(cam, SENINF_CSI2_LNRD_TIMING,
+		    SENINF_CSI2_LNRD_TIMING_DATA_SETTLE, SENINF_SETTLE_DELAY);
+
+	val = readl(inst + SENINF_CSI2_CTL)
+	    | FIELD_PREP(SENINF_CSI2_CTL_ED_SEL, 1)
+	    | SENINF_CSI2_CTL_CLOCK_LANE_EN
+	    | (BIT(num_lanes) - 1);
+	writel(val, inst + SENINF_CSI2_CTL);
+
+	inst_update(cam, SENINF_CSI2_RESYNC_MERGE_CTL,
+		    SENINF_CSI2_RESYNC_BYPASS, 0);
+	inst_update(cam, SENINF_CSI2_RESYNC_MERGE_CTL,
+		    SENINF_CSI2_RESYNC_CDPHY_SEL, 0);
+	inst_update(cam, SENINF_CSI2_RESYNC_MERGE_CTL,
+		    SENINF_CSI2_RESYNC_CPHY_CNT, 3);
+	inst_update(cam, SENINF_CSI2_MODE, SENINF_CSI2_MODE_CSI2_MODE, 0);
+	inst_update(cam, SENINF_CSI2_MODE, SENINF_CSI2_MODE_HEADER_LEN, 0);
+	inst_update(cam, SENINF_CSI2_DPHY_SYNC, SENINF_CSI2_DPHY_SYNC_MASK_0,
+		    0xff00);
+	inst_update(cam, SENINF_CSI2_DPHY_SYNC, SENINF_CSI2_DPHY_SYNC_PAT_0,
+		    0x001d);
+
+	inst_update(cam, SENINF_CSI2_CTL, SENINF_CSI2_CTL_CLOCK_HS_OPTION, 0);
+	inst_update(cam, SENINF_CSI2_CTL, SENINF_CSI2_CTL_HSRX_DET_EN, 0);
+	if (csi2_ctl_or)
+		writel(readl(inst + SENINF_CSI2_CTL) | csi2_ctl_or,
+		       inst + SENINF_CSI2_CTL);
+	inst_update(cam, SENINF_CSI2_CTL, SENINF_CSI2_CTL_HS_TRAIL_EN, 1);
+	inst_update(cam, SENINF_CSI2_HS_TRAIL, SENINF_CSI2_HS_TRAIL_PARAM,
+		    SENINF_HS_TRAIL_PARAMETER);
+
+	/*
+	 * Debug port 0x1a is the received-packet counter. It is the only
+	 * instrument that distinguishes "the D-PHY is mis-muxed" from "the
+	 * sensor is not transmitting", so it is always on.
+	 */
+	inst_update(cam, SENINF_CSI2_DGB_SEL, SENINF_CSI2_DGB_SEL_DEBUG_EN, 1);
+	inst_update(cam, SENINF_CSI2_DGB_SEL, SENINF_CSI2_DGB_SEL_DEBUG_SEL,
+		    0x1a);
+
+	writel(0xfffffffe, inst + SENINF_CSI2_SPARE0);
+
+	gemini_cam_rx_config(cam);
+
+	if (use_ncsi2) {
+		/*
+		 * The NCSI2 decoder's own control block. Composition from
+		 * SeninfDrvImp::setSeninfCSI2: a lane-enable mask in the low
+		 * nibble, a fixed 0x04000010, and bit 7 set unless the settle
+		 * parameter is 1.
+		 */
+		writel(readl(inst + SENINF_NCSI2_CTL) | SENINF_NCSI2_CTL_B7,
+		       inst + SENINF_NCSI2_CTL);
+		writel(SENINF_SETTLE_DELAY << 8, inst + SENINF_NCSI2_SETTLE);
+		writel(readl(inst + SENINF_NCSI2_CTL) |
+		       (BIT(num_lanes) - 1) | SENINF_NCSI2_CTL_FIXED,
+		       inst + SENINF_NCSI2_CTL);
+		writel(SENINF_NCSI2_INT_EN_ALL, inst + SENINF_NCSI2_INT_EN);
+		writel(ncsi2_spare, inst + SENINF_NCSI2_SPARE);
+
+		dev_info(cam->dev, "NCSI2 decoder: ctl 0x%08x settle 0x%08x\n",
+			 readl(inst + SENINF_NCSI2_CTL),
+			 readl(inst + SENINF_NCSI2_SETTLE));
+	}
+
+	/* Commit the CSI-2 configuration. */
+	inst_update(cam, SENINF_CTRL, SENINF_CTRL_CSI2_SW_RST, 1);
+	udelay(1);
+	inst_update(cam, SENINF_CTRL, SENINF_CTRL_CSI2_SW_RST, 0);
+
+	/* FIFO mux: one pixel per clock, normal (non-JPEG) FIFO thresholds. */
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_MUX_EN, 1);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_SRC_SEL,
+		   SENINF_MIPI_SENSOR);
+	mux_update(cam, SENINF_MUX_CTRL_EXT, SENINF_MUX_CTRL_EXT_SRC_SEL_EXT,
+		   SENINF_NORMAL_MODEL);
+	mux_update(cam, SENINF_MUX_CTRL_EXT, SENINF_MUX_CTRL_EXT_PIX_SEL_EXT,
+		   pixel_mode == 4 ? 1 : 0);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_PIX_SEL,
+		   pixel_mode == 2 ? 1 : 0);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_FIFO_FULL_WR_EN, 2);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_FIFO_FLUSH_EN,
+		   FIFO_FLUSH_EN_NORMAL_MODE);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_FIFO_PUSH_EN,
+		   FIFO_PUSH_EN_NORMAL_MODE);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_HSYNC_POL, 0);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_VSYNC_POL, 0);
+
+	val = readl(mux + SENINF_MUX_CTRL);
+	writel(val | SENINF_MUX_CTRL_IRQ_SW_RST | SENINF_MUX_CTRL_MUX_SW_RST,
+	       mux + SENINF_MUX_CTRL);
+	writel(val & ~(SENINF_MUX_CTRL_IRQ_SW_RST | SENINF_MUX_CTRL_MUX_SW_RST),
+	       mux + SENINF_MUX_CTRL);
+
+	writel(SENINF_MUX_SPARE_FIFO_FULL_SEL | 0xc0000, mux + SENINF_MUX_SPARE);
+
+	/* Report every mux error the block can raise, so overflows are counted. */
+	writel(0xffffffff, mux + SENINF_MUX_INTEN);
+	writel(readl(mux + SENINF_MUX_INTSTA), mux + SENINF_MUX_INTSTA);
+
+	gemini_cam_seninf_route(cam);
+
+	dev_dbg(cam->dev,
+		"seninf started: inst %u csi %u mux %u cam_mux %u; top_mux 0x%08x cam_mux 0x%08x mux_ctrl 0x%08x csi2_ctl 0x%08x\n",
+		seninf_inst, seninf_csi, seninf_mux, seninf_cam_mux,
+		readl(cam->seninf + SENINF_TOP_MUX_CTRL),
+		readl(cam->seninf + SENINF_TOP_CAM_MUX_CTRL),
+		readl(mux + SENINF_MUX_CTRL), readl(inst + SENINF_CSI2_CTL));
+}
+
+static void gemini_cam_seninf_stop(struct gemini_cam *cam)
+{
+	void __iomem *inst = seninf_inst_base(cam);
+	u32 val;
+
+	/* Sample the instruments before tearing the receiver down. */
+	cam->stats.csi2_packets = readl(inst + SENINF_CSI2_DGB_PORT);
+	cam->stats.csi2_int = readl(inst + SENINF_CSI2_INT_STATUS);
+	cam->stats.csi2_int_ext = readl(inst + SENINF_CSI2_INT_STATUS_EXT);
+	cam->stats.lane_fsm = readl(inst + SENINF_CSI2_LNRD_FSM);
+	cam->stats.clk_fsm = readl(inst + SENINF_CSI2_LNRC_FSM);
+	cam->stats.frame_line = readl(inst + SENINF_CSI2_FRAME_LINE_NUM);
+
+	val = readl(inst + SENINF_CSI2_CTL);
+	val &= ~(SENINF_CSI2_CTL_CLOCK_LANE_EN | 0xf);
+	writel(val, inst + SENINF_CSI2_CTL);
+
+	if (test_pattern) {
+		writel(0, inst + SENINF_TG_TM_CTL);
+		writel(readl(inst + SENINF_CTRL_EXT) &
+		       ~SENINF_CTRL_EXT_TESTMDL_IP_EN, inst + SENINF_CTRL_EXT);
+	}
+
+	writel(0, seninf_mux_base(cam) + SENINF_MUX_INTEN);
+	mux_update(cam, SENINF_MUX_CTRL, SENINF_MUX_CTRL_MUX_EN, 0);
+	inst_update(cam, SENINF_CTRL, SENINF_CTRL_SENINF_EN, 0);
+}
+
+/* -------------------------------------------------------------------------
+ * CAMSV
+ */
+static void gemini_cam_fbc_inc(struct gemini_cam *cam)
+{
+	u32 val = camsv_read(cam, CAMSV_IMGO_FBC);
+
+	camsv_write(cam, CAMSV_IMGO_FBC, val | CAMSV_IMGO_FBC_RCNT_INC);
+	camsv_write(cam, CAMSV_IMGO_FBC, val & ~CAMSV_IMGO_FBC_RCNT_INC);
+}
+
+static void gemini_cam_set_buffer(struct gemini_cam *cam,
+				  struct gemini_cam_buffer *buf)
+{
+	camsv_write(cam, CAMSV_IMGO_BASE_ADDR, lower_32_bits(buf->daddr));
+}
+
+static void gemini_cam_camsv_setup(struct gemini_cam *cam, unsigned int count)
+{
+	const struct v4l2_pix_format *f = &cam->format;
+	struct gemini_cam_buffer *buf;
+	unsigned long flags;
+	unsigned int i;
+	u32 fbc, tmp;
+
+	/*
+	 * The double data bus and the PAK block's 2-pixel mode are the CAMSV
+	 * side of the mux's PIX_SEL. Configuring the two independently is how
+	 * build #79 ended up with the mux delivering one pixel per clock into
+	 * a DMA expecting two, which raised IMGO_ERR on every burst and never
+	 * completed a frame.
+	 */
+	camsv_write(cam, CAMSV_TG_SEN_MODE,
+		    pixel_mode >= 2 ? CAMSV_TG_SEN_MODE_DBL_DATA_BUS_EN : 0);
+	camsv_write(cam, CAMSV_TG_SEN_GRAB_PXL, f->width << 16);
+	camsv_write(cam, CAMSV_TG_SEN_GRAB_LIN, f->height << 16);
+	camsv_write(cam, CAMSV_TG_PATH_CFG, CAMSV_TG_PATH_CFG_YUV_U2S_DIS);
+
+	/* Reset the block and its output DMA. */
+	camsv_write(cam, CAMSV_SW_CTL, CAMSV_SW_CTL_SW_RST);
+	camsv_write(cam, CAMSV_SW_CTL, 0);
+	camsv_write(cam, CAMSV_SW_CTL, CAMSV_SW_CTL_IMGO_RST_TRIG);
+	if (readl_poll_timeout_atomic(cam->camsv + CAMSV_SW_CTL, tmp,
+				      tmp == (CAMSV_SW_CTL_IMGO_RST_TRIG |
+					      CAMSV_SW_CTL_IMGO_RST_ST),
+				      10, 200))
+		dev_warn(cam->dev, "CAMSV IMGO reset did not complete (0x%08x)\n",
+			 camsv_read(cam, CAMSV_SW_CTL));
+	camsv_write(cam, CAMSV_SW_CTL, 0);
+
+	/*
+	 * The frame-buffer controller, AFTER the software reset — the reset
+	 * clears it. Setting it before, the way the code first read, left
+	 * CAMSV_IMGO_FBC reading 0x00000000 with FB_NUM zero, and the DMA
+	 * raised IMGO_ERR on every burst because it had no slot to write
+	 * into (measured, build #79). FB_NUM is the number of buffers the
+	 * driver holds; RCNT_INC is pulsed once per buffer to hand them over.
+	 */
+	if (use_fbc) {
+		fbc = camsv_read(cam, CAMSV_IMGO_FBC);
+		fbc &= ~CAMSV_IMGO_FBC_FB_NUM;
+		fbc |= CAMSV_IMGO_FBC_EN |
+		       FIELD_PREP(CAMSV_IMGO_FBC_FB_NUM, count);
+		camsv_write(cam, CAMSV_IMGO_FBC, fbc);
+
+		for (i = 0; i < count; i++)
+			gemini_cam_fbc_inc(cam);
+	} else {
+		camsv_write(cam, CAMSV_IMGO_FBC, 0);
+	}
+
+	camsv_write(cam, CAMSV_INT_EN, CAMSV_INT_ST_MASK | CAMSV_INT_ST_MASK_ERR);
+
+	camsv_write(cam, CAMSV_MODULE_EN,
+		    CAMSV_MODULE_EN_DB_EN | CAMSV_MODULE_EN_TG_EN |
+		    CAMSV_MODULE_EN_PAK_EN);
+	camsv_write(cam, CAMSV_FMT_SEL, CAMSV_FMT_SEL_TG1_FMT_RAW_10);
+	camsv_write(cam, CAMSV_PAK,
+		    CAMSV_PAK_MODE_RAW_10 |
+		    (pixel_mode >= 2 ? CAMSV_PAK_DBL_MODE_2_PIXELS : 0));
+
+	camsv_write(cam, CAMSV_IMGO_XSIZE, f->bytesperline - 1);
+	camsv_write(cam, CAMSV_IMGO_YSIZE, f->height - 1);
+	camsv_write(cam, CAMSV_IMGO_STRIDE,
+		    CAMSV_IMGO_STRIDE_BUS_SIZE_EN |
+		    CAMSV_IMGO_STRIDE_BUS_SIZE_32 | f->bytesperline);
+	camsv_write(cam, CAMSV_IMGO_CON,
+		    FIELD_PREP(CAMSV_IMGO_CON_MAX_BURST_LEN, 0x8) |
+		    FIELD_PREP(CAMSV_IMGO_CON_FIFO_SIZE, 0x80));
+	camsv_write(cam, CAMSV_IMGO_CON2,
+		    FIELD_PREP(CAMSV_IMGO_CON2_PRI_THRL, 0x2) |
+		    FIELD_PREP(CAMSV_IMGO_CON2_PRI_THRH, 0x2));
+
+	spin_lock_irqsave(&cam->buf_lock, flags);
+	buf = list_first_entry_or_null(&cam->buf_list, struct gemini_cam_buffer,
+				       list);
+	if (buf)
+		gemini_cam_set_buffer(cam, buf);
+	spin_unlock_irqrestore(&cam->buf_lock, flags);
+
+	/* CMOS first, then arm the output DMA. */
+	camsv_write(cam, CAMSV_TG_SEN_MODE,
+		    camsv_read(cam, CAMSV_TG_SEN_MODE) |
+		    CAMSV_TG_SEN_MODE_CMOS_EN);
+	camsv_write(cam, CAMSV_MODULE_EN,
+		    camsv_read(cam, CAMSV_MODULE_EN) | CAMSV_MODULE_EN_IMGO_EN);
+}
+
+static void gemini_cam_camsv_vf_enable(struct gemini_cam *cam)
+{
+	if (use_fbc)
+		camsv_write(cam, CAMSV_IMGO_FBC,
+			    camsv_read(cam, CAMSV_IMGO_FBC) |
+			    CAMSV_IMGO_FBC_EN);
+	camsv_write(cam, CAMSV_CLK_EN,
+		    CAMSV_CLK_EN_TG_DP | CAMSV_CLK_EN_PAK_DP |
+		    CAMSV_CLK_EN_DMA_DP);
+	camsv_write(cam, CAMSV_TG_SEN_MODE,
+		    camsv_read(cam, CAMSV_TG_SEN_MODE) |
+		    CAMSV_TG_SEN_MODE_CMOS_EN);
+	camsv_write(cam, CAMSV_TG_VF_CON,
+		    camsv_read(cam, CAMSV_TG_VF_CON) |
+		    CAMSV_TG_VF_CON_VFDATA_EN);
+}
+
+static void gemini_cam_camsv_vf_disable(struct gemini_cam *cam)
+{
+	/* Sample the TG's own view of the frame before stopping it. */
+	cam->stats.tg_frmsize = camsv_read(cam, CAMSV_TG_FRMSIZE_ST);
+	cam->stats.fbc = camsv_read(cam, CAMSV_IMGO_FBC);
+
+	camsv_write(cam, CAMSV_TG_SEN_MODE,
+		    camsv_read(cam, CAMSV_TG_SEN_MODE) &
+		    ~CAMSV_TG_SEN_MODE_CMOS_EN);
+	camsv_write(cam, CAMSV_TG_VF_CON,
+		    camsv_read(cam, CAMSV_TG_VF_CON) &
+		    ~CAMSV_TG_VF_CON_VFDATA_EN);
+	camsv_write(cam, CAMSV_INT_EN, 0);
+	camsv_write(cam, CAMSV_MODULE_EN, 0);
+	camsv_write(cam, CAMSV_IMGO_FBC,
+		    camsv_read(cam, CAMSV_IMGO_FBC) & ~CAMSV_IMGO_FBC_EN);
+}
+
+static irqreturn_t gemini_cam_irq(int irq, void *data)
+{
+	struct gemini_cam *cam = data;
+	struct gemini_cam_buffer *done, *next;
+	u32 status, mux_sta;
+
+	status = camsv_read(cam, CAMSV_INT_STATUS);
+	if (!status)
+		return IRQ_NONE;
+
+	spin_lock(&cam->buf_lock);
+
+	if (status & CAMSV_IRQ_TG_ERR)
+		cam->stats.tg_err++;
+	if (status & CAMSV_IRQ_TG_GBERR)
+		cam->stats.tg_gberr++;
+	if (status & CAMSV_IRQ_IMGO_ERR)
+		cam->stats.imgo_err++;
+	if (status & CAMSV_IRQ_IMGO_OVERRUN)
+		cam->stats.imgo_overrun++;
+	if (status & CAMSV_IRQ_SOF)
+		cam->stats.sof++;
+
+	/*
+	 * The SENINF FIFO's own error word. Its bit meanings are not
+	 * documented in anything available here, so it is latched raw rather
+	 * than decoded — a non-zero value is still the difference between "the
+	 * link is marginal" and "the link is fine", which is what #65 asks to
+	 * be diagnosable.
+	 */
+	mux_sta = readl(seninf_mux_base(cam) + SENINF_MUX_INTSTA);
+	if (mux_sta) {
+		cam->stats.mux_intsta = mux_sta;
+		writel(mux_sta, seninf_mux_base(cam) + SENINF_MUX_INTSTA);
+	}
+
+	if (status & CAMSV_IRQ_PASS1_DON) {
+		cam->stats.frames++;
+		cam->sequence++;
+
+		done = list_first_entry_or_null(&cam->buf_list,
+						struct gemini_cam_buffer, list);
+		if (done)
+			list_del(&done->list);
+		else
+			cam->stats.dropped++;
+
+		next = list_first_entry_or_null(&cam->buf_list,
+						struct gemini_cam_buffer, list);
+
+		if (done) {
+			done->vb.sequence = cam->sequence;
+			done->vb.vb2_buf.timestamp = ktime_get_ns();
+			vb2_buffer_done(&done->vb.vb2_buf, VB2_BUF_STATE_DONE);
+			if (use_fbc)
+				gemini_cam_fbc_inc(cam);
+		}
+
+		/*
+		 * With no buffer to point at, the hardware keeps its previous
+		 * target and the FBC drops frames until buf_queue supplies one.
+		 */
+		if (next)
+			gemini_cam_set_buffer(cam, next);
+	}
+
+	spin_unlock(&cam->buf_lock);
+
+	/* Write-1-to-clear is not used here: reading INT_STATUS clears it. */
+	if (status & CAMSV_INT_ST_MASK_ERR)
+		dev_warn_ratelimited(cam->dev, "CAMSV error status 0x%08x\n",
+				     (u32)(status & CAMSV_INT_ST_MASK_ERR));
+
+	return IRQ_HANDLED;
+}
