+/* -------------------------------------------------------------------------
+ * "the camera shows when it is in use" (#67)
+ *
+ * The panel needs a signal that means the sensor is actually delivering
+ * frames, not merely that somebody has the device node open -- an application
+ * can hold /dev/video0 for a long time without streaming, and an indicator
+ * that lit for that would train the owner to ignore it.
+ *
+ * This flag is set and cleared in vb2's start/stop_streaming, which is the
+ * narrowest place that is true. It also handles the case the issue calls out:
+ * when an application crashes rather than exiting cleanly, the kernel closes
+ * its file descriptor, vb2 runs stop_streaming, and the flag clears. There is
+ * no path where the hardware streams and this reads 0.
+ */
+static ssize_t streaming_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct gemini_cam *cam = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", cam->streaming ? 1 : 0);
+}
+static DEVICE_ATTR_RO(streaming);
