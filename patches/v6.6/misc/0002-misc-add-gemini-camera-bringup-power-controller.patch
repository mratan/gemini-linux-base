--- /dev/null
+++ b/drivers/misc/gemini-camera-power.c
@@ -0,0 +1,873 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Gemini PDA camera bring-up power controller.
+ *
+ * WHAT THIS IS FOR
+ *
+ * Nobody knows which image sensors this board is fitted with. The vendor
+ * k97 build compiles four sensor drivers (sp5506 = OmniVision OV5675,
+ * sp5509 in two variants, st55a = Samsung S5K5E2YA) and there is no
+ * Gemini-specific camera configuration anywhere to say which are populated.
+ * An I2C scan answers it in seconds — but only if the sensors are powered
+ * and clocked, and none of the rails, the master clock or the reset and
+ * power-down lines can be driven from userspace.
+ *
+ * So this driver drives them. Writing 1 to its sysfs "socket_power" attribute
+ * runs the vendor's power-on sequence for both camera sockets and leaves them
+ * powered, so that an ordinary i2cdetect/i2ctransfer on the two camera buses
+ * can do the actual reading. Writing 0, or unloading the module, powers
+ * everything back down. Binding on its own powers nothing.
+ *
+ * It is scaffolding for issue #63 and is meant to be deleted by #64: once a
+ * V4L2 sensor subdev driver exists, these supplies, clocks and GPIOs belong
+ * on the sensor's own I2C node where the V4L2 framework can see them.
+ * Nothing else may depend on it, and it is deliberately not autoloaded.
+ *
+ * SOURCES
+ *
+ * Power sequence: vendor 3.18
+ * drivers/misc/mediatek/imgsensor/src/mt6797/camera_hw/kd_camera_hw.c,
+ * PowerOnList[] — identical for all four candidate sensors:
+ *
+ *	SensorMCLK high
+ *	RST low
+ *	PDN low
+ *	DOVDD 1.8 V, 10 ms
+ *	AVDD  2.8 V, 10 ms
+ *	DVDD  1.2 V, 10 ms
+ *	RST high, 10 ms
+ *	PDN high, 10 ms
+ *
+ * MCLK output enable: vendor
+ * drivers/misc/mediatek/cameraisp/src/mt6797/camera_isp.c, ISP_MCLK1_EN()
+ * and ISP_MCLK2_EN() — set bit 29 of SENINF0/SENINF1 + 0x600.
+ *
+ * Clock ordering: same file, Prepare_Enable_ccf_clock(), which carries the
+ * requirement in a comment — "must keep this clk open order: CG_SCP_SYS_DIS
+ * -> CG_DISP0_SMI_COMMON -> CG_SCP_SYS_ISP -> ISP clk" — and then enables
+ * CAM_LARB2 before CAM_CAMSYS.
+ *
+ * genpd supplies only part of that. Taking a runtime-PM reference here powers
+ * the ISP domain and, because ISP is a genpd child of MM, the MM domain with
+ * it. It does NOT enable the smi_common gate: MT6797_POWER_DOMAIN_ISP has
+ * .clk_id = {CLK_NONE} in mtk-scpsys.c, and MM's CLK_MM is the mm_sel
+ * topckgen mux, not CLK_MM_SMI_COMMON. So smi_common is taken as an explicit
+ * clock below, before the domain, and CAM_LARB2 before CAM_CAMSYS, in the
+ * vendor's order.
+ */
+
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <dt-bindings/clock/mt6797-clk.h>
+#include <linux/gpio/consumer.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/sysfs.h>
+
+/*
+ * SENINF instance stride and the MCLK register, from the vendor
+ * ISP_MCLKn_EN() functions: SENINF0 0x1a040000, SENINF1 0x1a041000,
+ * SENINF2 0x1a042000, and in each the register at +0x600 bit 29.
+ *
+ * Bit 29 is the enable, and the vendor only ever read-modify-writes that one
+ * bit — but it does so on top of a rest value this driver would otherwise
+ * never establish. camera_isp.c's release path (ISP_MCLK_EN Release) writes
+ * 0x00000001 to all three of these registers, so the vendor's "MCLK off" is
+ * 0x00000001 and its "MCLK on" is 0x20000001. Linux never runs the vendor
+ * SENINF init, so bit 0 arrives at whatever the preloader left — measured as
+ * 0 on this board — and an RMW of bit 29 alone yields 0x20000000, which is
+ * not a state the vendor ever produces.
+ *
+ * Bit 28 was found by bisecting this register against the CMMCLK pad's own
+ * DIN bit, with the pad muxed to CMMCLK and every other bit clear: it is the
+ * only bit of the 32 that makes the pad leave a static low. So it is the pad
+ * output enable, and since the vendor only ever read-modify-writes bit 29,
+ * bit 28 must already be set in the vendor's world — by something Linux does
+ * not run. It is set here for the same reason bit 0 is: matching the vendor's
+ * known-good register value is strictly better than matching part of it.
+ *
+ * Neither bit is understood, and neither makes the sensor answer. With bit 28
+ * set the pad goes to a STATIC HIGH, never a clock — measured, see
+ * 04-docs/CAMERA-SENSORS-2026-08-24.md. Whatever feeds the TG its clock is
+ * still missing, and that is the open end of #63.
+ */
+/*
+ * SENINF master-clock setup, reverse-engineered from the vendor camera HAL
+ * (libcam.halsensor.so in the stock system.img, SeninfDrvImp::setMclk1),
+ * NOT from the vendor kernel. The kernel's ISP_MCLKn_EN only ever writes
+ * bit 29 of +0x600, but the running system's HAL maps the SENINF page through
+ * /dev/devmap and drives it directly, and its enable is a different bit. The
+ * kernel path is a red herring. The HAL sequence, per socket (base = SENINF0
+ * for the main sensor, SENINF1 for the sub):
+ *
+ *   SENINF_TOP_CTRL (+0x000) |= BIT(10) | BIT(11)
+ *   SENINF_TG_SEN_CK (+0x604): [5:0] = MCLK divider, [21:16] = divider2
+ *   SENINF_MCLK (+0x600): BIT(31) enable, plus BIT(28), bits [1:0] = 1
+ *
+ * The divider takes 48 MHz (camtg_sel, measured on the SoC frequency meter)
+ * down to the 24 MHz the sensor wants. The exact field encoding is the one
+ * unknown left; seninf_div overrides it so it can be swept on-device against
+ * the CMMCLK pad, which now moves because the enable is finally the right bit.
+ */
+#define SENINF_STRIDE			0x1000
+#define SENINF_TOP_CTRL_REG		0x0000
+#define SENINF_MCLK_REG			0x0600
+#define SENINF_SEN_CK_REG		0x0604
+
+#define SENINF_TOP_CTRL_EN		(BIT(10) | BIT(11))
+
+#define SENINF_MCLK_ENABLE		(BIT(31) | BIT(0))  /* vendor active value 0x80000001 */
+#define SENINF_MCLK_BIT28		BIT(28)
+#define SENINF_MCLK_LOW			(BIT(0) | BIT(1))
+
+#define SENINF_SEN_CK_DIV_MASK		0x3f		/* [5:0] */
+#define SENINF_SEN_CK_DIV2_MASK		(0x3f << 16)	/* [21:16] */
+
+/*
+ * MCLK divider field for 48 MHz -> 24 MHz. Overridable so the exact encoding
+ * can be found on-device; 1 is the first guess (the [5:0] field halving).
+ */
+static unsigned int seninf_div = 1;
+module_param(seninf_div, uint, 0644);
+MODULE_PARM_DESC(seninf_div,
+		 "SENINF_TG_SEN_CK divider field for 48->24 MHz (sweep knob)");
+
+/*
+ * Vendor power-sequence voltages (kd_camera_hw.h VOL* / PowerOnList).
+ *
+ * DVDD is 1.21 V, not the 1.2 V PowerOnList asks for: hwpoweron() rewrites
+ * Vol_1200 to Vol_1210 before every _hwPowerOn(DVDD, ...) — "vcamd:
+ * unsupportable voltage range: 1500000-1210000uV" — on all three sockets, and
+ * the live vendor stack reads the rail back as 1210000 uV.
+ */
+#define CAM_DOVDD_UV			1800000
+#define CAM_AVDD_UV			2800000
+#define CAM_DVDD_UV			1210000
+
+/* Vendor power-sequence settle time, in milliseconds, between every step. */
+#define CAM_STEP_DELAY_MS		10
+
+/*
+ * SENINF_TG<n>_SEN_CK (SENINF + 0x604), the register immediately after the
+ * MCLK enable, reset value 0x00010001.
+ *
+ * The vendor kernel never writes it, so this driver did not either — but the
+ * vendor's userspace mmaps the ISP window and does much of the SENINF setup
+ * there, so "the vendor kernel does not" is not evidence that nothing does.
+ * It matters because the CAMTG mux measures 48 MHz on the SoC's own frequency
+ * meter while every candidate sensor asks for a 24 MHz MCLK, so something has
+ * to halve it, and this is the only register in the path named for a sensor
+ * clock.
+ *
+ * 0 means "leave at whatever reset left", which is the behaviour up to build
+ * #73. Any other value is written during power-on, BEFORE the rails come up,
+ * so that a sensor which latches its configuration out of reset sees it. It
+ * is a sweep knob for bring-up, not a configuration: the field layout is not
+ * known.
+ */
+/*
+ * Override for the whole SENINF MCLK register (SENINF + 0x600) rather than
+ * just its enable bit. 0 keeps the driver's own SENINF_MCLK_REST|EN value.
+ *
+ * Bit 28 was found by bisecting this register against the CMMCLK pad's own
+ * DIN bit: with the pad muxed to CMMCLK and every other bit clear, bit 28 is
+ * the only one that makes the pad leave a static low. The vendor's
+ * ISP_MCLKn_EN only ever read-modify-writes bit 29, which means bit 28 must
+ * already be set in the vendor's world — by something Linux does not run.
+ */
+static unsigned int seninf_mclk;
+module_param(seninf_mclk, uint, 0644);
+MODULE_PARM_DESC(seninf_mclk,
+		 "override for SENINF+0x600 (0 = the driver's own REST|EN value)");
+
+static unsigned int seninf_sen_ck;
+module_param(seninf_sen_ck, uint, 0644);
+MODULE_PARM_DESC(seninf_sen_ck,
+		 "value to write to SENINF+0x604 during power-on (0 = leave at reset)");
+
+static bool autopower;
+module_param(autopower, bool, 0444);
+
+/*
+ * Diagnostic: enable the four imgsys CCF clocks (IMG_LARB6/DIP/DPE/FDVT) in the
+ * vendor's Prepare_Enable_ccf_clock order, between the ISP power domain and the
+ * CAM gates. The vendor enables these and we did not, so they were the last
+ * remaining difference from the captured working state. Fetched at runtime from
+ * the imgsys provider node so no DT phandle is needed (keeps this inside the =m
+ * module, which loads after userspace and cannot affect boot — unlike a DT
+ * phandle, whose effect on boot was never cleanly confirmed).
+ *
+ * RESULT (2026-08-24, on hardware): enabling all four imgsys clocks brings the
+ * live imgsys CG register to 0x3be, matching the vendor byte-for-byte, and the
+ * CMMCLK1 pad STILL does not toggle and the sensor STILL NAKs on I2C. So the
+ * imgsys clocks are NOT the missing piece. (img_larb6 needs the clk-mt6797-img
+ * onecell-size fix to come out of the provider — CLK_IMG_LARB6 == 4 but the
+ * onecell is sized 4; here it was ungated via devmem to complete the test.)
+ * Left in, default off, as a reproducible record of that negative result.
+ */
+static bool enable_img;
+module_param(enable_img, bool, 0644);
+
+struct gemini_cam;
+static void gemini_cam_img_enable(struct gemini_cam *cam);
+static void gemini_cam_img_disable(struct gemini_cam *cam);
+MODULE_PARM_DESC(autopower,
+		 "power the camera sockets up at probe (default: no — write 1 to socket_power instead)");
+
+struct gemini_cam_socket {
+	const char *name;
+	unsigned int seninf;		/* SENINF instance carrying its MCLK */
+	struct gpio_desc *reset;
+	struct gpio_desc *powerdown;
+};
+
+struct gemini_cam {
+	struct device *dev;
+	void __iomem *seninf_base;
+
+	struct clk *smi_common;
+	struct clk *larb2;
+	struct clk *camsys;
+	struct clk *seninf;
+	struct clk *camtg;
+	struct clk *camtg_sel;
+	struct clk *camtg_parent;
+	/* imgsys CCF clocks, fetched at runtime from the provider (no DT ref) */
+	struct clk *img_clk[4];
+	bool img_on;
+
+	struct regulator *vcama;	/* AVDD  2.8 V */
+	struct regulator *vcamd;	/* DVDD  1.2 V */
+	struct regulator *vcamio;	/* DOVDD 1.8 V */
+
+	struct gemini_cam_socket socket[2];
+
+	bool powered;
+	struct mutex lock;		/* serialises power on/off */
+};
+
+static void gemini_cam_mclk_set(struct gemini_cam *cam, unsigned int seninf,
+				bool on)
+{
+	void __iomem *base = cam->seninf_base + seninf * SENINF_STRIDE;
+
+	if (!on) {
+		writel(readl(base + SENINF_MCLK_REG) & ~SENINF_MCLK_ENABLE,
+		       base + SENINF_MCLK_REG);
+		return;
+	}
+
+	if (seninf_mclk) {
+		writel(seninf_mclk, base + SENINF_MCLK_REG);
+		dev_info(cam->dev, "seninf%u MCLK override 0x%08x (rb 0x%08x)\n",
+			 seninf, seninf_mclk, readl(base + SENINF_MCLK_REG));
+		return;
+	}
+
+	/*
+	 * The vendor's active MCLK register value, captured from the running
+	 * vendor 3.18 kernel via /dev/mem on the Reference slot (2026-08-24):
+	 * SENINF + 0x600 reads exactly 0x80000000 — bit 31 alone — with
+	 * SENINF_TG_SEN_CK (+0x604) and +0x608 left at their reset values and
+	 * SENINF_TOP_CTRL untouched. So bit 31 is the enable, and the bit 28 an
+	 * earlier revision of this driver set (which drives the pad to a static
+	 * level) is wrong.
+	 *
+	 * The vendor's exact active value is 0x80000001 (bit 31 + bit 0),
+	 * captured from the running vendor HAL. But this is necessary and NOT
+	 * sufficient: with the ENTIRE SENINF page, camsys/imgsys clock gates,
+	 * ISP power domain and reset controllers all matching the vendor
+	 * byte-for-byte (verified 2026-08-24 by capturing the live vendor state
+	 * while its camera enumerated the sensor), the CMMCLK pad still does not
+	 * toggle and the sensor still does not answer on I2C. The remaining
+	 * difference is not any register value — it is the ISP clock-enable
+	 * SEQUENCE the vendor kernel performs (order and timing of the CCF
+	 * clock bring-up in cameraisp Prepare_Enable_ccf_clock), which a
+	 * register snapshot cannot reproduce. See
+	 * 04-docs/CAMERA-SENSORS-2026-08-24.md.
+	 */
+	writel(SENINF_MCLK_ENABLE, base + SENINF_MCLK_REG);
+	dev_info(cam->dev, "seninf%u MCLK = 0x%08x (vendor value; see driver note)\n",
+		 seninf, readl(base + SENINF_MCLK_REG));
+}
+static void gemini_cam_assert_resets(struct gemini_cam *cam)
+{
+	int i;
+
+	/* Both lines are described active-low in DT; 1 == asserted. */
+	for (i = 0; i < ARRAY_SIZE(cam->socket); i++) {
+		gpiod_set_value_cansleep(cam->socket[i].reset, 1);
+		gpiod_set_value_cansleep(cam->socket[i].powerdown, 1);
+	}
+}
+
+static void gemini_cam_rail_off(struct gemini_cam *cam, struct regulator *reg,
+				const char *what)
+{
+	int ret = regulator_disable(reg);
+
+	if (ret)
+		dev_err(cam->dev, "%s: failed to disable: %d\n", what, ret);
+}
+
+static void gemini_cam_power_off(struct gemini_cam *cam)
+{
+	int i;
+
+	gemini_cam_assert_resets(cam);
+
+	for (i = 0; i < ARRAY_SIZE(cam->socket); i++)
+		gemini_cam_mclk_set(cam, cam->socket[i].seninf, false);
+
+	/*
+	 * Rails down in the reverse of the order they came up. A failure here
+	 * is not recoverable and there is nobody to return it to, but it must
+	 * not be silent: a rail that would not turn off is exactly the kind of
+	 * thing that later looks like "the sensor answers sometimes".
+	 */
+	gemini_cam_rail_off(cam, cam->vcamd, "DVDD/vcamd");
+	gemini_cam_rail_off(cam, cam->vcama, "AVDD/vcama");
+	gemini_cam_rail_off(cam, cam->vcamio, "DOVDD/vcamio");
+
+	clk_disable_unprepare(cam->camtg);
+	clk_disable_unprepare(cam->seninf);
+	clk_disable_unprepare(cam->camsys);
+	clk_disable_unprepare(cam->larb2);
+
+	/* Drop the imgsys clocks while the ISP domain is still powered. */
+	gemini_cam_img_disable(cam);
+
+	pm_runtime_put_sync(cam->dev);
+	clk_disable_unprepare(cam->smi_common);
+	cam->powered = false;
+	dev_info(cam->dev, "camera sockets powered down\n");
+}
+
+static void gemini_cam_check_rail(struct gemini_cam *cam, struct regulator *reg,
+				  const char *what, int expect_uv)
+{
+	int uv = regulator_get_voltage(reg);
+
+	if (uv < 0) {
+		dev_warn(cam->dev, "%s: cannot read voltage: %d\n", what, uv);
+		return;
+	}
+
+	if (uv != expect_uv)
+		dev_warn(cam->dev, "%s: %d uV, vendor sequence wants %d uV\n",
+			 what, uv, expect_uv);
+	else
+		dev_info(cam->dev, "%s: %d uV\n", what, uv);
+}
+
+/*
+ * Enable the imgsys CCF clocks by fetching them straight from the imgsys
+ * provider node (no consumer phandle in our DT). Must run with the ISP power
+ * domain already up — the CG registers live at 0x15000000, inside that domain.
+ */
+static const unsigned int gemini_img_ids[4] = {
+	CLK_IMG_LARB6, CLK_IMG_DIP, CLK_IMG_DPE, CLK_IMG_FDVT,
+};
+static const char *const gemini_img_names[4] = {
+	"img_larb6", "img_dip", "img_dpe", "img_fdvt",
+};
+
+static void gemini_cam_img_enable(struct gemini_cam *cam)
+{
+	struct device_node *np;
+	int i;
+
+	if (!enable_img || cam->img_on)
+		return;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6797-imgsys");
+	if (!np) {
+		dev_warn(cam->dev, "imgsys node not found; enable_img no-op\n");
+		return;
+	}
+
+	for (i = 0; i < 4; i++) {
+		struct of_phandle_args spec = {
+			.np = np, .args_count = 1,
+		};
+		int ret;
+
+		spec.args[0] = gemini_img_ids[i];
+		cam->img_clk[i] = of_clk_get_from_provider(&spec);
+		if (IS_ERR(cam->img_clk[i])) {
+			dev_warn(cam->dev, "img clk %s get: %ld\n",
+				 gemini_img_names[i], PTR_ERR(cam->img_clk[i]));
+			cam->img_clk[i] = NULL;
+			continue;
+		}
+		ret = clk_prepare_enable(cam->img_clk[i]);
+		if (ret)
+			dev_warn(cam->dev, "img clk %s enable: %d\n",
+				 gemini_img_names[i], ret);
+		else
+			dev_info(cam->dev, "img clk %s enabled\n",
+				 gemini_img_names[i]);
+	}
+	of_node_put(np);
+	cam->img_on = true;
+}
+
+static void gemini_cam_img_disable(struct gemini_cam *cam)
+{
+	int i;
+
+	if (!cam->img_on)
+		return;
+	for (i = 0; i < 4; i++) {
+		if (cam->img_clk[i]) {
+			clk_disable_unprepare(cam->img_clk[i]);
+			clk_put(cam->img_clk[i]);
+			cam->img_clk[i] = NULL;
+		}
+	}
+	cam->img_on = false;
+}
+
+/*
+ * The complete vendor SENINF register state, captured live during the vendor
+ * camera stack's sensor enumeration (2026-08-25). {offset-from-seninf_base,
+ * value}. Writing all of this makes CMMCLK0 (pin30) and CMMCLK1 (pin31) toggle
+ * on the pads, which the single-register MCLK write never did.
+ */
+static const struct { u32 off; u32 val; } gemini_seninf_cfg[] = {
+	{ 0x0000, 0x00000c00 }, { 0x0008, 0x00043210 }, { 0x0010, 0x76543210 },
+	{ 0x0014, 0x00001100 }, { 0x0018, 0x00001100 },
+	{ 0x0200, 0x00000001 },
+	{ 0x0600, 0xa0000001 }, { 0x0604, 0x00010001 }, { 0x0608, 0x00300004 },
+	{ 0x0700, 0x018861e0 }, { 0x0a00, 0x01886160 }, { 0x0d00, 0x86df0080 },
+	{ 0x1200, 0x00000001 },
+	{ 0x1600, 0xa0000001 }, { 0x1604, 0x00010001 }, { 0x1608, 0x00300004 },
+	{ 0x1700, 0x018861e0 }, { 0x1a00, 0x01886160 }, { 0x1d00, 0x86df0080 },
+	{ 0x2600, 0x80000001 },
+};
+
+static void gemini_cam_seninf_config(struct gemini_cam *cam)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(gemini_seninf_cfg); i++)
+		writel(gemini_seninf_cfg[i].val,
+		       cam->seninf_base + gemini_seninf_cfg[i].off);
+
+	dev_info(cam->dev,
+		 "SENINF configured; CMMCLK top=0x%08x mux1=0x%08x TG1=0x%08x\n",
+		 readl(cam->seninf_base + 0x0000),
+		 readl(cam->seninf_base + 0x0d00),
+		 readl(cam->seninf_base + 0x0600));
+}
+
+static int gemini_cam_power_on(struct gemini_cam *cam)
+{
+	int ret, i;
+
+	/* Vendor order: smi_common, then the ISP domain, then the CAM gates. */
+	ret = clk_prepare_enable(cam->smi_common);
+	if (ret) {
+		dev_err(cam->dev, "smi_common clock: %d\n", ret);
+		return ret;
+	}
+
+	ret = pm_runtime_resume_and_get(cam->dev);
+	if (ret) {
+		dev_err(cam->dev, "ISP power domain did not come up: %d\n", ret);
+		goto err_smi;
+	}
+
+	/* Vendor order puts IMG_LARB6/DIP/DPE/FDVT here, after the ISP domain. */
+	gemini_cam_img_enable(cam);
+
+	ret = clk_prepare_enable(cam->larb2);
+	if (ret) {
+		dev_err(cam->dev, "cam_larb2 clock: %d\n", ret);
+		goto err_pd;
+	}
+
+	ret = clk_prepare_enable(cam->camsys);
+	if (ret) {
+		dev_err(cam->dev, "camsys clock: %d\n", ret);
+		goto err_larb2;
+	}
+
+	ret = clk_prepare_enable(cam->seninf);
+	if (ret) {
+		dev_err(cam->dev, "seninf clock: %d\n", ret);
+		goto err_camsys;
+	}
+
+	/*
+	 * Park the MCLK mux on the parent the vendor uses before ungating it
+	 * (kd_sensorlist.c kdSetSensorMclk, CAM_PLL_48_GROUP = univpll_d26).
+	 */
+	ret = clk_set_parent(cam->camtg_sel, cam->camtg_parent);
+	if (ret) {
+		dev_err(cam->dev, "camtg_sel reparent: %d\n", ret);
+		goto err_seninf;
+	}
+
+	ret = clk_prepare_enable(cam->camtg);
+	if (ret) {
+		dev_err(cam->dev, "camtg clock: %d\n", ret);
+		goto err_seninf;
+	}
+
+	dev_info(cam->dev, "camtg_sel at %lu Hz\n", clk_get_rate(cam->camtg_sel));
+
+	/* Hold both sensors in reset while the rails come up. */
+	gemini_cam_assert_resets(cam);
+
+	/*
+	 * Program the full SENINF pipeline, captured live from the vendor stack
+	 * (2026-08-25). This is the config that actually latches both CMMCLK
+	 * master clocks onto the pads; the earlier single-register MCLK write did
+	 * not, because it missed the seninf_mux enables (0x86df0080), the TG
+	 * +0x608 fields and the seninf-instance enables. Offsets are absolute
+	 * from seninf_base (0x1a040000); the real MT6797 map is seninf_top at +0,
+	 * SENINF1_TG at +0x600, seninf1_mux at +0xd00, SENINF2_TG at +0x1600, etc.
+	 * (MT6797 Functional Spec §6.10). See 04-docs/CAMERA-SENSORS-2026-08-24.md.
+	 */
+	gemini_cam_seninf_config(cam);
+
+	ret = regulator_enable(cam->vcamio);
+	if (ret) {
+		dev_err(cam->dev, "vcamio (DOVDD): %d\n", ret);
+		goto err_camtg;
+	}
+	msleep(CAM_STEP_DELAY_MS);
+
+	ret = regulator_enable(cam->vcama);
+	if (ret) {
+		dev_err(cam->dev, "vcama (AVDD): %d\n", ret);
+		goto err_vcamio;
+	}
+	msleep(CAM_STEP_DELAY_MS);
+
+	ret = regulator_enable(cam->vcamd);
+	if (ret) {
+		dev_err(cam->dev, "vcamd (DVDD): %d\n", ret);
+		goto err_vcama;
+	}
+	msleep(CAM_STEP_DELAY_MS);
+
+	for (i = 0; i < ARRAY_SIZE(cam->socket); i++) {
+		gpiod_set_value_cansleep(cam->socket[i].reset, 0);
+		msleep(CAM_STEP_DELAY_MS);
+		gpiod_set_value_cansleep(cam->socket[i].powerdown, 0);
+		msleep(CAM_STEP_DELAY_MS);
+		dev_info(cam->dev, "%s socket released from reset\n",
+			 cam->socket[i].name);
+	}
+
+	cam->powered = true;
+
+	/*
+	 * Report what the rails actually read back rather than what was
+	 * asked for, and say so loudly if the two differ: a rail sitting at
+	 * the wrong voltage is a plausible reason for a sensor not to answer,
+	 * and it must not be discovered later by inference.
+	 */
+	gemini_cam_check_rail(cam, cam->vcamio, "DOVDD/vcamio", CAM_DOVDD_UV);
+	gemini_cam_check_rail(cam, cam->vcama, "AVDD/vcama", CAM_AVDD_UV);
+	gemini_cam_check_rail(cam, cam->vcamd, "DVDD/vcamd", CAM_DVDD_UV);
+	return 0;
+
+err_vcama:
+	gemini_cam_rail_off(cam, cam->vcama, "AVDD/vcama");
+err_vcamio:
+	gemini_cam_rail_off(cam, cam->vcamio, "DOVDD/vcamio");
+err_camtg:
+	for (i = 0; i < ARRAY_SIZE(cam->socket); i++)
+		gemini_cam_mclk_set(cam, cam->socket[i].seninf, false);
+	clk_disable_unprepare(cam->camtg);
+err_seninf:
+	clk_disable_unprepare(cam->seninf);
+err_camsys:
+	clk_disable_unprepare(cam->camsys);
+err_larb2:
+	clk_disable_unprepare(cam->larb2);
+	gemini_cam_img_disable(cam);
+err_pd:
+	pm_runtime_put_sync(cam->dev);
+err_smi:
+	clk_disable_unprepare(cam->smi_common);
+	return ret;
+}
+
+/*
+ * Named socket_power, not power: every struct device already owns a "power"
+ * directory (the runtime-PM one), so a "power" attribute collides with it and
+ * device_add_groups() fails, which unbinds the driver. Measured on build #71.
+ */
+static ssize_t socket_power_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct gemini_cam *cam = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", cam->powered ? 1 : 0);
+}
+
+static ssize_t socket_power_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct gemini_cam *cam = dev_get_drvdata(dev);
+	bool want;
+	int ret;
+
+	ret = kstrtobool(buf, &want);
+	if (ret)
+		return ret;
+
+	ret = 0;
+	mutex_lock(&cam->lock);
+	if (want && !cam->powered)
+		ret = gemini_cam_power_on(cam);
+	else if (!want && cam->powered)
+		gemini_cam_power_off(cam);
+	mutex_unlock(&cam->lock);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(socket_power);
+
+/*
+ * Re-run just the reset/power-down half of the power-on sequence, leaving the
+ * rails and clocks alone.
+ *
+ * This exists so that a register hypothesis can be tested without rebuilding
+ * the module. Many sensors latch configuration out of reset, so poking a
+ * SENINF register while the sensor is already running proves nothing; what is
+ * needed is "change the register, then release reset again", and the
+ * reset/power-down lines are held by this driver, so userspace cannot do the
+ * second half. With this, a sweep is an ordinary shell loop:
+ *
+ *	devmem <seninf reg> 32 <value>
+ *	echo 1 > reset_cycle
+ *	i2cdetect -y -r 3
+ *
+ * Bring-up scaffolding, like the rest of this driver. Goes away with it.
+ */
+static ssize_t reset_cycle_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct gemini_cam *cam = dev_get_drvdata(dev);
+	int ret = 0, i;
+
+	mutex_lock(&cam->lock);
+	if (!cam->powered) {
+		dev_err(dev, "sockets are not powered; nothing to reset\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	gemini_cam_assert_resets(cam);
+	msleep(CAM_STEP_DELAY_MS);
+
+	for (i = 0; i < ARRAY_SIZE(cam->socket); i++) {
+		gpiod_set_value_cansleep(cam->socket[i].reset, 0);
+		msleep(CAM_STEP_DELAY_MS);
+		gpiod_set_value_cansleep(cam->socket[i].powerdown, 0);
+		msleep(CAM_STEP_DELAY_MS);
+	}
+	dev_dbg(dev, "reset cycled on both sockets\n");
+out:
+	mutex_unlock(&cam->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(reset_cycle);
+
+static struct attribute *gemini_cam_attrs[] = {
+	&dev_attr_socket_power.attr,
+	&dev_attr_reset_cycle.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(gemini_cam);
+
+static int gemini_cam_get_socket(struct gemini_cam *cam, int idx,
+				 const char *name, unsigned int seninf)
+{
+	struct gemini_cam_socket *s = &cam->socket[idx];
+	char prop[32];
+
+	s->name = name;
+	s->seninf = seninf;
+
+	/*
+	 * Optional, and increasingly absent: once a socket has a real sensor
+	 * subdev its reset and power-down lines belong on the sensor's own
+	 * node, where V4L2 can see them, and they disappear from here. The
+	 * sub socket went that way with #64. gpiod_set_value() tolerates a
+	 * NULL descriptor, so the sequence below needs no other change.
+	 */
+	scnprintf(prop, sizeof(prop), "%s-reset", name);
+	s->reset = devm_gpiod_get_optional(cam->dev, prop, GPIOD_OUT_HIGH);
+	if (IS_ERR(s->reset))
+		return dev_err_probe(cam->dev, PTR_ERR(s->reset),
+				     "%s-reset-gpios\n", name);
+
+	scnprintf(prop, sizeof(prop), "%s-powerdown", name);
+	s->powerdown = devm_gpiod_get_optional(cam->dev, prop, GPIOD_OUT_HIGH);
+	if (IS_ERR(s->powerdown))
+		return dev_err_probe(cam->dev, PTR_ERR(s->powerdown),
+				     "%s-powerdown-gpios\n", name);
+
+	return 0;
+}
+
+static int gemini_cam_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct gemini_cam *cam;
+	struct resource *res;
+	int ret;
+
+	dev_info(dev, "probing Gemini camera bring-up power controller\n");
+
+	cam = devm_kzalloc(dev, sizeof(*cam), GFP_KERNEL);
+	if (!cam)
+		return -ENOMEM;
+
+	cam->dev = dev;
+	mutex_init(&cam->lock);
+
+	/*
+	 * devm_ioremap(), not devm_platform_ioremap_resource(): this node
+	 * covers the SENINF block that #65 will give a real driver, and a
+	 * request_mem_region() here would make the two mutually exclusive
+	 * for no benefit. One bit in one register is written.
+	 */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return dev_err_probe(dev, -EINVAL, "no SENINF reg range\n");
+
+	cam->seninf_base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!cam->seninf_base)
+		return dev_err_probe(dev, -ENOMEM, "cannot map SENINF\n");
+
+	cam->smi_common = devm_clk_get(dev, "smi_common");
+	if (IS_ERR(cam->smi_common))
+		return dev_err_probe(dev, PTR_ERR(cam->smi_common),
+				     "smi_common clock\n");
+
+	cam->larb2 = devm_clk_get(dev, "larb2");
+	if (IS_ERR(cam->larb2))
+		return dev_err_probe(dev, PTR_ERR(cam->larb2), "larb2 clock\n");
+
+	cam->camsys = devm_clk_get(dev, "camsys");
+	if (IS_ERR(cam->camsys))
+		return dev_err_probe(dev, PTR_ERR(cam->camsys), "camsys clock\n");
+
+	cam->seninf = devm_clk_get(dev, "seninf");
+	if (IS_ERR(cam->seninf))
+		return dev_err_probe(dev, PTR_ERR(cam->seninf), "seninf clock\n");
+
+	cam->camtg = devm_clk_get(dev, "camtg");
+	if (IS_ERR(cam->camtg))
+		return dev_err_probe(dev, PTR_ERR(cam->camtg), "camtg clock\n");
+
+	cam->camtg_sel = devm_clk_get(dev, "camtg_sel");
+	if (IS_ERR(cam->camtg_sel))
+		return dev_err_probe(dev, PTR_ERR(cam->camtg_sel),
+				     "camtg_sel clock\n");
+
+	cam->camtg_parent = devm_clk_get(dev, "univpll_d26");
+	if (IS_ERR(cam->camtg_parent))
+		return dev_err_probe(dev, PTR_ERR(cam->camtg_parent),
+				     "univpll_d26 clock\n");
+
+	cam->vcama = devm_regulator_get(dev, "vcama");
+	if (IS_ERR(cam->vcama))
+		return dev_err_probe(dev, PTR_ERR(cam->vcama), "vcama supply\n");
+
+	cam->vcamd = devm_regulator_get(dev, "vcamd");
+	if (IS_ERR(cam->vcamd))
+		return dev_err_probe(dev, PTR_ERR(cam->vcamd), "vcamd supply\n");
+
+	cam->vcamio = devm_regulator_get(dev, "vcamio");
+	if (IS_ERR(cam->vcamio))
+		return dev_err_probe(dev, PTR_ERR(cam->vcamio), "vcamio supply\n");
+
+	/*
+	 * Socket -> SENINF instance: the vendor drives the main sensor's MCLK
+	 * from SENINF0 (ISP_MCLK1_EN) and the sub sensor's from SENINF1
+	 * (ISP_MCLK2_EN). CMMCLK0/CMMCLK1 (GPIO30/31) are the matching pads.
+	 */
+	ret = gemini_cam_get_socket(cam, 0, "main", 0);
+	if (ret)
+		return ret;
+
+	ret = gemini_cam_get_socket(cam, 1, "sub", 1);
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, cam);
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "runtime PM\n");
+
+	/*
+	 * Probe deliberately touches no hardware and leaves everything off.
+	 * The module has a modalias and udev will autoload it, so a probe
+	 * that powered the sensors would silently power the camera on every
+	 * boot — on a machine that is somebody's daily desktop and whose
+	 * power budget is already tight (#59). Powering up is an explicit
+	 * act:
+	 *
+	 *     echo 1 > /sys/devices/platform/.../socket_power
+	 */
+	if (autopower) {
+		mutex_lock(&cam->lock);
+		ret = gemini_cam_power_on(cam);
+		mutex_unlock(&cam->lock);
+		if (ret)
+			return ret;
+	}
+
+	dev_info(dev, "bound, sockets %s; write 1 to its sysfs 'socket_power' to enable\n",
+		 cam->powered ? "powered" : "off");
+	return 0;
+}
+
+static void gemini_cam_remove(struct platform_device *pdev)
+{
+	struct gemini_cam *cam = platform_get_drvdata(pdev);
+
+	mutex_lock(&cam->lock);
+	if (cam->powered)
+		gemini_cam_power_off(cam);
+	mutex_unlock(&cam->lock);
+}
+
+static const struct of_device_id gemini_cam_of_match[] = {
+	{ .compatible = "planet,gemini-camera-power" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, gemini_cam_of_match);
+
+static struct platform_driver gemini_cam_driver = {
+	.driver = {
+		.name = "gemini-camera-power",
+		.of_match_table = gemini_cam_of_match,
+		.dev_groups = gemini_cam_groups,
+	},
+	.probe = gemini_cam_probe,
+	.remove_new = gemini_cam_remove,
+};
+module_platform_driver(gemini_cam_driver);
+
+MODULE_AUTHOR("Gemini PDA Linux port");
+MODULE_DESCRIPTION("Gemini PDA camera bring-up power controller (issue #63)");
+MODULE_LICENSE("GPL");
