+++ b/Documentation/devicetree/bindings/misc/planet,gemini-camera-power.yaml
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/planet,gemini-camera-power.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Planet Computers Gemini PDA camera bring-up power controller
+
+maintainers:
+  - Gemini PDA Linux port <https://github.com/mratan/gemini-linux>
+
+description: |
+  Bring-up scaffolding for the MT6797 camera stack on the Gemini PDA. It
+  gathers the supplies, master clocks and reset/power-down lines that the two
+  camera sockets share, and runs the vendor power-on sequence over them on
+  request, so that the fitted image sensors can be identified with an ordinary
+  I2C scan before any sensor driver exists.
+
+  This node is temporary. Once V4L2 sensor subdev drivers exist, each sensor's
+  own I2C node carries its supplies, clock and reset GPIO, and this node is
+  removed.
+
+properties:
+  compatible:
+    const: planet,gemini-camera-power
+
+  reg:
+    maxItems: 1
+    description:
+      The SENINF register block. Only the per-instance master-clock output
+      enable is used.
+
+  clocks:
+    items:
+      - description: camsys register-bank gate
+      - description: SENINF gate
+      - description: sensor master-clock (CAMTG) gate
+      - description: topckgen CAMTG mux, whose rate the sensors see
+      - description: the mux parent the vendor selects for CAMTG
+
+  clock-names:
+    items:
+      - const: camsys
+      - const: seninf
+      - const: camtg
+      - const: camtg_sel
+      - const: univpll_d26
+
+  power-domains:
+    maxItems: 1
+    description: the ISP MTCMOS domain containing camsys and SENINF
+
+  vcama-supply:
+    description: sensor analog supply (AVDD)
+
+  vcamd-supply:
+    description: sensor digital core supply (DVDD)
+
+  vcamio-supply:
+    description: sensor I/O supply (DOVDD)
+
+  main-reset-gpios:
+    maxItems: 1
+    description: rear sensor reset, active low
+
+  main-powerdown-gpios:
+    maxItems: 1
+    description: rear sensor power-down (PWDNB), active low
+
+  sub-reset-gpios:
+    maxItems: 1
+    description: front sensor reset, active low
+
+  sub-powerdown-gpios:
+    maxItems: 1
+    description: front sensor power-down (PWDNB), active low
+
+  pinctrl-0: true
+
+  pinctrl-names:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - power-domains
+  - vcama-supply
+  - vcamd-supply
+  - vcamio-supply
+  - main-reset-gpios
+  - main-powerdown-gpios
+  - sub-reset-gpios
+  - sub-powerdown-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6797-clk.h>
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/power/mt6797-power.h>
+
+    camera-power@1a040000 {
+        compatible = "planet,gemini-camera-power";
+        reg = <0x1a040000 0x3000>;
+        power-domains = <&scpsys MT6797_POWER_DOMAIN_ISP>;
+        clocks = <&camsys CLK_CAM_CAMSYS>,
+                 <&camsys CLK_CAM_SENINF>,
+                 <&camsys CLK_CAM_CAMTG>,
+                 <&topckgen CLK_TOP_MUX_CAMTG>,
+                 <&topckgen CLK_TOP_UNIVPLL_D26>;
+        clock-names = "camsys", "seninf", "camtg", "camtg_sel", "univpll_d26";
+        vcama-supply = <&mt6351_vcama_reg>;
+        vcamd-supply = <&mt6351_vcamd_reg>;
+        vcamio-supply = <&mt6351_vcamio_reg>;
+        main-reset-gpios = <&pio 32 GPIO_ACTIVE_LOW>;
+        main-powerdown-gpios = <&pio 28 GPIO_ACTIVE_LOW>;
+        sub-reset-gpios = <&pio 33 GPIO_ACTIVE_LOW>;
+        sub-powerdown-gpios = <&pio 29 GPIO_ACTIVE_LOW>;
+    };
