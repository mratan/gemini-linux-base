diff --git a/arch/arm64/boot/dts/mediatek/mt6797.dtsi b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
index c3677d77e..672a89d2c 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6797.dtsi
@@ -123,6 +123,31 @@ infrasys: infracfg_ao@10001000 {
 		#clock-cells = <1>;
 	};
 
+	/*
+	 * Second infracfg block at 0x10201000, distinct from the AO block
+	 * at 0x10001000 (&infrasys). The vendor DTB's scpsys node spans
+	 * three regions (AO infracfg, SPM 0x10006000, and this block), which
+	 * originally suggested the TOPAXI bus-protection registers live
+	 * here. They do NOT: the vendor runtime (clk-mt6797-pg.c) maps its
+	 * INFRA_TOPAXI_PROTECTEN/PROTECTSTA1 accesses off scpsys reg[0] --
+	 * the AO block -- and live reads on hardware (2026-08-18, CONN
+	 * powered on) confirm it: 0x10001220/0x10001228 hold the real
+	 * protect state (0x104B8 = MD1 mask) while 0x10201220/0x10201228
+	 * read hard zero. Pointing scpsys's infracfg phandle here made CONN
+	 * power-OFF time out forever ("Failed to power off domain conn"):
+	 * set-protect polls PROTECTSTA1 for the ack bits against a register
+	 * that always reads 0. Power-ON only appeared to work because
+	 * clear-protect polls for zero. So the phandle stays on &infrasys;
+	 * this node is kept as a bare syscon for register inspection.
+	 * Must NOT reuse "mediatek,mt6797-infracfg" here -- the infra
+	 * clock-controller driver also matches it and would attempt a
+	 * second, conflicting clock-provider registration on this node.
+	 */
+	infracfg2: infracfg@10201000 {
+		compatible = "syscon";
+		reg = <0 0x10201000 0 0x1000>;
+	};
+
 	pio: pinctrl@10005000 {
 		compatible = "mediatek,mt6797-pinctrl";
 		reg = <0 0x10005000 0 0x1000>,
