arm64: dts: mediatek: gemini: add GPU (Mali-T880) node — Track 2 / panfrost prep

Adds the MT6797 Mali-T880 GPU node (reg/IRQs/clock/mali-supply/power-domain),
its 7-entry OPP table, and the vgpu buck regulator on i2c7 — all UNPROVEN and
kept out of the boot path (panfrost is =m, MFG domains keep-default-off).
Renumbered from 0022 to 0024 and re-based so it appends after the display DTS
patches (0022/0023) instead of colliding on the shared board-dts EOF anchor.

diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index 0eccc52de..46be5851b 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -1730,3 +1730,129 @@ pins-ctrl {
 		};
 	};
 };
+
+/*
+ * ==========================================================================
+ * Track 2 (GPU / panfrost) — UNPROVEN device-free staging. gemini_linux #7.
+ *
+ * Nothing here has run on hardware. It exists so the first GPU device
+ * session is a test, not development. The Mali MFG power domains
+ * (patches/v6.6/pmdomain/0003) are registered KEEP_DEFAULT_OFF and
+ * panfrost is a module, so this block cannot power the GPU at boot and
+ * therefore cannot regress the display/Wi-Fi bring-up.
+ * ==========================================================================
+ */
+
+/ {
+	/*
+	 * GPU DVFS operating points. Values transcribed from the vendor
+	 * "Full Yield" default table mt_gpufreq_opp_v7_tbl_e1_0[] in
+	 * ubports-3.18 drivers/misc/mediatek/base/power/mt6797/mt_gpufreq.c
+	 * (GPUOP(freq_khz, volt, idx); volt constants are in mV*100, so
+	 * e.g. GPU_DVFS_VOLT0 112890 -> 1.12890 V -> 1128900 uV). opp-hz is
+	 * the vendor KHz value * 1000. Binning selects among several vendor
+	 * tables; this is the full-yield default. UNPROVEN — the mali-supply
+	 * must actually reach these microvolts for DVFS to be safe on silicon.
+	 */
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-238000000 {
+			opp-hz = /bits/ 64 <238000000>;
+			opp-microvolt = <859500>;
+		};
+		opp-365000000 {
+			opp-hz = /bits/ 64 <365000000>;
+			opp-microvolt = <910800>;
+		};
+		opp-442500000 {
+			opp-hz = /bits/ 64 <442500000>;
+			opp-microvolt = <949300>;
+		};
+		opp-520000000 {
+			opp-hz = /bits/ 64 <520000000>;
+			opp-microvolt = <1000600>;
+		};
+		opp-610000000 {
+			opp-hz = /bits/ 64 <610000000>;
+			opp-microvolt = <1039100>;
+		};
+		opp-700000000 {
+			opp-hz = /bits/ 64 <700000000>;
+			opp-microvolt = <1090400>;
+		};
+		opp-780000000 {
+			opp-hz = /bits/ 64 <780000000>;
+			opp-microvolt = <1128900>;
+		};
+	};
+
+	/*
+	 * Mali Midgard GPU. reg/interrupts from the vendor node
+	 * mali@13040000 in ubports-3.18 arch/arm64/boot/dts/mt6797.dts:
+	 *   reg  0x13040000 len 0x4000
+	 *   IRQ  GIC_SPI 264 (job), 263 (mmu), 262 (gpu), level-low
+	 * (vendor interrupt-names JOB/MMU/GPU -> mainline lowercase).
+	 *
+	 * Clock: the mainline mt6797 GPU clock is the CLK_TOP_MUX_MFG mux
+	 * from topckgen (the same "mfg" clock scpsys uses); the vendor's
+	 * dedicated g3d_config/mfgsys clock controller is not modelled in
+	 * mainline 6.6, so panfrost's single "core" clock is wired to the
+	 * mux. Power: the MFG domain (its mfg_async parent powers with it
+	 * via the subdomain link); the four shader-core domains need a
+	 * follow-up multi-domain panfrost compatible (mt8192-style) and are
+	 * NOT wired here — a known UNPROVEN gap. mali-supply: see &i2c7.
+	 *
+	 * Compatible model (T880 vs vendor's T860) is flagged for owner
+	 * review in patches/v6.6/gpu/0001; panfrost auto-detects at runtime.
+	 */
+	gpu: gpu@13040000 {
+		compatible = "mediatek,mt6797-mali", "arm,mali-t880";
+		reg = <0 0x13040000 0 0x4000>;
+		interrupts = <GIC_SPI 264 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_SPI 263 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_SPI 262 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-names = "job", "mmu", "gpu";
+		clocks = <&topckgen CLK_TOP_MUX_MFG>;
+		clock-names = "core";
+		mali-supply = <&vgpu>;
+		power-domains = <&scpsys MT6797_POWER_DOMAIN_MFG>;
+		operating-points-v2 = <&gpu_opp_table>;
+	};
+};
+
+/*
+ * GPU supply buck. The live golden-harvest I2C scan (mirrors/bsg100
+ * research.md) shows i2c7: 0x1c rt5735-regulator, 0x60 vgpu_buck. The
+ * base tree's own hardware analysis (driver_ports.md "RT5735 Buck
+ * Regulator") concludes the 0x60 "vgpu_buck" is "likely the same chip
+ * [RT5735] on a different I2C address", so mali-supply is wired to an
+ * RT5735 at 0x60 (compatible richtek,rt5735 — the fan53555 variant the
+ * base tree already added in patches/v6.6/regulator/0001).
+ *
+ * OWNER SANITY-CHECK REQUESTED (per handoff): the mt6797 GPU OPP voltage
+ * constants map to exact FAN53555 VSEL codes (12.826 mV step / 603 mV
+ * base: 1128.9 mV = code 41, 1090.4 mV = code 38) rather than to clean
+ * RT5735 6.25 mV / 600 mV steps, matching the vendor gpufreq's separate
+ * EXT_FAN53555 conversion path (mt_gpufreq.c). So the part at 0x60 may
+ * actually be a FAN53555-family buck. Either resolves to a valid
+ * regulator for panfrost to probe; confirm the 0x60 part on hardware
+ * before trusting GPU DVFS. Constraints below are the buck's full
+ * capable range (covers the 859.5 mV..1128.9 mV OPP span).
+ */
+&i2c7 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c7_pins_a>;
+	clock-frequency = <100000>;
+	status = "okay";
+
+	vgpu: regulator@1c {
+		compatible = "richtek,rt5735";
+		reg = <0x1c>;
+		regulator-name = "vgpu";
+		regulator-min-microvolt = <600000>;
+		regulator-max-microvolt = <1393750>;
+		regulator-ramp-delay = <6250>;
+		/* Die CONFIRMED on hardware 2026-08-18 (closes audit F5): Richtek RT5735 at 0x1c — PID reg 0x03 reads 0x10 (RT5735_PRODUCT_ID); the vendor DTB's i2c7 carries rt5735@1c "rt,rt5735-regulator" plus a chipless vgpu_buck@60 fan53555-probe node, and a live bus scan ACKs only 0x1c. Rail found disabled, VSEL0 staged at 0x26 (837.5 mV). Still no regulator-boot-on: panfrost enables it on demand. */
+	};
+};
