+	/*
+	 * The CPU clock tree: four ARMCAXPLLs and the per-cluster mux select.
+	 * Separate from both topckgen and apmixedsys, and the reason this SoC
+	 * had no CPU clocks and therefore no cpufreq at all.
+	 *
+	 * The driver exposes only the two Cortex-A53 clusters' PLLs. CCI runs
+	 * off ARMCAXPLL2 in the same block and is deliberately not modelled --
+	 * it is live and nothing here should be able to move it.
+	 */
+	mcumixed: mcumixed@1001a000 {
+		compatible = "mediatek,mt6797-mcumixed";
+		reg = <0 0x1001a000 0 0x1000>;
+		clocks = <&clk26m>,
+			 <&topckgen CLK_TOP_ARMPLL_DIV_PLL1>,
+			 <&topckgen CLK_TOP_ARMPLL_DIV_PLL2>;
+		#clock-cells = <1>;
+	};
+
+	/*
+	 * VSRAM: the Cortex-A53 clusters' SRAM supply is an array of eight
+	 * on-die LDOs in INFRACFG_AO (CPULDO_CTRL_0/1/2 at 0xf98/0xf9c/0xfa0),
+	 * not a PMIC rail. The vendor holds it at or above Vproc; it therefore
+	 * has to be raised before cpufreq can take Vproc to the top of either
+	 * cluster's OPP table. Voltage constraints are board policy and live
+	 * in the board file.
+	 */
+	vsram_cpu: regulator-cpu-sram {
+		compatible = "mediatek,mt6797-cpu-sram-ldo";
+		mediatek,infracfg = <&infrasys>;
+		regulator-name = "vsram_cpu";
+	};
+
 	infrasys: infracfg_ao@10001000 {
 		compatible = "mediatek,mt6797-infracfg", "syscon";
 		reg = <0 0x10001000 0 0x1000>;
