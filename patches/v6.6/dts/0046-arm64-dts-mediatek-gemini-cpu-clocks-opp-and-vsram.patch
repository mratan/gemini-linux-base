+/*
+ * VSRAM, pinned at its maximum.
+ *
+ * Measured on this board before anything modelled it: CPULDO_CTRL_1/2 held
+ * 0x0B0B0B0B, selector 11, which is 1100 mV — exactly 100 mV above the
+ * 1000 mV BUCKA was sitting at, the vendor's NORMAL_DIFF_VRSAM_VPROC.
+ *
+ * The vendor's rule is Vsram >= Vproc, and at most MAX_DIFF_VSRAM_VPROC
+ * (300 mV) above it. cpufreq takes Vproc up to 1200 mV for the top operating
+ * point of either A53 cluster, so a VSRAM left at 1100 mV would break the
+ * first half of that rule at 1125 mV and above. Pinning VSRAM at 1200 mV —
+ * MAX_VSRAM_VOLT, the ceiling the vendor's own code refuses to exceed — makes
+ * the whole 1000-1200 mV Vproc range legal with a single static setting, and
+ * keeps voltage tracking (and therefore i2c6 traffic) out of the middle of
+ * every CPU frequency change.
+ *
+ * min == max on purpose: nothing may move this rail at runtime. It is
+ * deliberately left with no consumer, and in particular is NOT the CPUs'
+ * sram-supply — mediatek-cpufreq turns a present sram regulator into software
+ * voltage tracking, which would fight this pin and fail every transition.
+ */
+&vsram_cpu {
+	regulator-min-microvolt = <1200000>;
+	regulator-max-microvolt = <1200000>;
+	regulator-always-on;
+	regulator-boot-on;
+};
+
+/*
+ * CPU operating points.
+ *
+ * Frequencies are the vendor's SB-bin tables for this die, verbatim. The bin
+ * is not a guess: Android on this very phone reports LL topping out at
+ * 1547 MHz, and all sixteen LL entries of CPU_DVFS_FREQ*_LL_SB match that
+ * capture exactly, which is what makes the L table trustworthy too.
+ *
+ * TWO DELIBERATE NARROWINGS, both of which cost only idle power:
+ *
+ * 1. The bottom of each table is cut where the vendor starts using
+ *    ARMPLLDIV_CKDIV, the fractional post-divider (LL below 624 MHz, L below
+ *    650 MHz). Nothing here models that divider, so those operating points
+ *    are simply not offered rather than being offered at the wrong frequency.
+ *
+ * 2. Voltages are floored at 1000000 uV. BUCKA is not the little cluster's
+ *    rail alone -- the vendor puts LL, L *and CCI* all on VPROC1, and this
+ *    port scales only the two A53 clusters. CCI stays where the bootloader
+ *    left it, ~630 MHz, which the vendor's own CCI table prices at just above
+ *    its 1000 mV operating point. The machine is running at exactly 1000 mV
+ *    right now with CCI at that frequency, so 1000 mV is a measured-safe
+ *    floor and anything below it is not. Lowering it is what a CCI cpufreq
+ *    policy would earn.
+ *
+ * The top of each table is untouched, which is where the 1.72x and 1.57x
+ * this whole exercise is for actually comes from.
+ */
+
+&cpu0 {
+	operating-points-v2 = <&cpu_opp_ll>;
+	proc-supply = <&da9214_vproc>;
+};
+
+&cpu1 {
+	operating-points-v2 = <&cpu_opp_ll>;
+	proc-supply = <&da9214_vproc>;
+};
+
+&cpu2 {
+	operating-points-v2 = <&cpu_opp_ll>;
+	proc-supply = <&da9214_vproc>;
+};
+
+&cpu3 {
+	operating-points-v2 = <&cpu_opp_ll>;
+	proc-supply = <&da9214_vproc>;
+};
+
+&cpu4 {
+	operating-points-v2 = <&cpu_opp_l>;
+	proc-supply = <&da9214_vproc>;
+};
+
+&cpu5 {
+	operating-points-v2 = <&cpu_opp_l>;
