 			     "mediatek,mt6577-i2c";
-		id = <5>;
 		reg = <0 0x1101c000 0 0x1000>,
 		      <0 0x11000380 0 0x80>;
 		interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_LOW>;
@@ -597,6 +592,25 @@
 	 * planet/kali_boot.img (node smi_larb0@14020000).
 	 * 0x14010000 is disp_rdma1 — do not use that address here.
 	 */
+	/*
+	 * larb5 serves DISP_OVL1/RDMA1/WDMA1 -- the external-display path.
+	 * mt6797-larb-port.h says so in its own header comment, but the OVL1
+	 * and RDMA1 nodes pointed at &larb0 until 2026-08-25, which would have
+	 * produced exactly the IOMMU translation faults the camera hit on the
+	 * same mistake. No `interrupts`: mtk-smi never requests one (the vendor
+	 * value is SPI 234, kept here for reference).
+	 */
+	larb5: larb@14021000 {
+		compatible = "mediatek,mt6797-smi-larb";
+		reg = <0 0x14021000 0 0x1000>;
+		mediatek,larb-id = <5>;
+		mediatek,smi = <&smi_common>;
+		power-domains = <&scpsys MT6797_POWER_DOMAIN_MM>;
+		clocks = <&mmsys CLK_MM_SMI_LARB5>,
+			 <&mmsys CLK_MM_SMI_LARB5>;
+		clock-names = "apb", "smi";
+	};
+
 	larb0: larb@14020000 {
 		compatible = "mediatek,mt6797-smi-larb";
 		reg = <0 0x14020000 0 0x1000>;
@@ -649,7 +663,7 @@
 		reg = <0 0x10205000 0 0x1000>;
 		interrupts = <GIC_SPI 156 IRQ_TYPE_LEVEL_LOW>;
 		mediatek,infracfg = <&infrasys>;
-		mediatek,larbs = <&larb0>, <&larb2>;
+		mediatek,larbs = <&larb0>, <&larb2>, <&larb5>;
 		#iommu-cells = <1>;
 	};
 
