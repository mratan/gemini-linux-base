@@ -3046,9 +3162,54 @@
  * it can manage a cluster -- see #55.
  */
 &cpu8 {
+	operating-points-v2 = <&cpu_opp_b>;
 	proc-supply = <&da9214_vproc2>;
 };
 
 &cpu9 {
+	operating-points-v2 = <&cpu_opp_b>;
 	proc-supply = <&da9214_vproc2>;
 };
+
+/*
+ * capacity-dmips-mhz, restated per MHz because THIS board renormalises.
+ *
+ * mt6797.dtsi carries 608 : 617 : 1024, which is the measurement (single-thread
+ * gbench stint with the frequency pinned, 2026-08-28: A53-LL 676 Mops/s at
+ * 1222 MHz, A53-L 686 at 1209, A72 1135 at 1989) expressed as a ratio, and on a
+ * board with no OPP tables those numbers reach the scheduler unchanged.
+ *
+ * This board has OPP tables on all ten cores, so init_cpu_capacity_callback()
+ * eventually sees cpus_to_visit empty and calls topology_normalize_cpu_scale(),
+ * which multiplies each raw value by that policy's cpuinfo_max_freq. Left alone,
+ * 608/617/1024 would become 472/620/1024 — the little cluster quietly
+ * down-weighted by a quarter. So encode the measurement the way the property is
+ * actually defined:
+ *
+ *   raw = wanted_capacity / cpuinfo_max_freq_MHz, scaled to keep the A72 at 1024
+ *   LL  608 / 1547 -> 782      L  617 / 2002 -> 613      B  1024 / 1989 -> 1024
+ *
+ * and 782x1547 : 613x2002 : 1024x1989 normalises back to 608 : 617 : 1024.
+ *
+ * ONE HONEST CAVEAT. Renormalisation only happens once cpu8 has a policy, and
+ * cpu8 is onlined by gemini-a72-online at ~240 s. Until then — and for the whole
+ * boot if the A72s are never brought up — the scheduler uses these raw values
+ * verbatim, which rates the LL cluster 28% above the L cluster instead of 1.5%
+ * below it. Both are Cortex-A53 and the misplacement is between two nearly
+ * identical clusters rather than across the big/little boundary, and
+ * SD_ASYM_CPUCAPACITY is set either way because 1024 differs from both; but it
+ * is wrong, and the way to shorten it is to online the A72s earlier, not to
+ * change these numbers back.
+ *
+ * cpuinfo_max_freq is each table's top, NOT the ceiling gemini-cpufreq-cap holds
+ * the clusters at, so the target ratios describe the machine as it actually runs
+ * rather than one allowed to reach its tables.
+ */
+&cpu0 { capacity-dmips-mhz = <782>; };
+&cpu1 { capacity-dmips-mhz = <782>; };
+&cpu2 { capacity-dmips-mhz = <782>; };
+&cpu3 { capacity-dmips-mhz = <782>; };
+&cpu4 { capacity-dmips-mhz = <613>; };
+&cpu5 { capacity-dmips-mhz = <613>; };
+&cpu6 { capacity-dmips-mhz = <613>; };
+&cpu7 { capacity-dmips-mhz = <613>; };
