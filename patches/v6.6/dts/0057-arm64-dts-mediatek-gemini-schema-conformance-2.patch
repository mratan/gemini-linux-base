 		      <0 0x11280700 0 0x0100>;
 		reg-names = "mac", "ippc";
@@ -1575,7 +1578,7 @@
 			 <&infrasys CLK_INFRA_PMIC_AP>;
 		clock-names = "spi", "wrap";
 
-		pmic: mt6351 {
+		pmic: pmic {
 			compatible = "mediatek,mt6351";
 
 			/*
@@ -1870,7 +1873,7 @@
  */
 / {
 	usb1phy: t-phy@11210000 {
-		compatible = "mediatek,generic-tphy-v1";
+		compatible = "mediatek,mt6797-tphy", "mediatek,generic-tphy-v1";
 		reg = <0 0x11210000 0 0x800>;
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -2004,9 +2007,16 @@
 		regulator-name = "hdmi_1v2";
 		regulator-min-microvolt = <1200000>;
 		regulator-max-microvolt = <1200000>;
-		enable-gpios = <&pio 247 GPIO_ACTIVE_HIGH>;
+		gpios = <&pio 247 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
 		/* TODO: verify enable polarity on hardware (vendor drives
-		 * GPIO247 high to enable the rail). */
+		 * GPIO247 high to enable the rail).
+		 *
+		 * This was "enable-gpios" until 2026-08-25, which
+		 * reg-fixed-voltage.c does not read -- it asks gpiolib for the
+		 * nameless "gpio"/"gpios" property. So the rail was never
+		 * actually gated by software. If HDMI regresses, that is the
+		 * change to look at first. */
 	};
 
 	/* HDMI type-A receptacle presented to the user via the Planet cable. */
@@ -2095,8 +2105,8 @@
 	 * sil9024a.dtsi gpio_sil9022_dpi_func1). 12 data lines (D0..D11) plus
 	 * DE/CK/HSYNC/VSYNC — RGB888 is carried dual-edge (DDR).
 	 */
-	dpi_pins: dpi-pins {
-		pins-dpi {
+	dpi_pins: dpi-0 {
+		dpi-pins {
 			pinmux = <MT6797_GPIO39__FUNC_DPI_D0>,
 				 <MT6797_GPIO40__FUNC_DPI_D1>,
 				 <MT6797_GPIO41__FUNC_DPI_D2>,
@@ -2129,8 +2139,8 @@
