 			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
 		};
 	};
@@ -1261,8 +1264,8 @@
 	 * (as done via MTK_DRIVE_* in other mt65xx/mt81xx board DTS uhs
 	 * states) is deferred until basic block I/O is confirmed working.
 	 */
-	msdc0_pins_uhs: msdc0-uhs {
-		pins-cmd-dat {
+	msdc0_pins_uhs: msdc0-1 {
+		cmd-dat-pins {
 			pinmux = <MT6797_GPIO122__FUNC_MSDC0_CMD>,
 				 <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
 				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
@@ -1273,10 +1276,10 @@
 				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
 				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>;
 		};
-		pins-clk {
+		clk-pins {
 			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
 		};
-		pins-rst {
+		rst-pins {
 			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
 		};
 	};
@@ -1377,29 +1380,29 @@
  */
 &pio {
 	/* pinmux only, no pinconf -- see the msdc0 pinctrl comment */
