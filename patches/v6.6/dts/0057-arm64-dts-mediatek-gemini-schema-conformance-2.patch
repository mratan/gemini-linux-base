-		pins-cmd-dat {
+	msdc1_pins_uhs: msdc1-1 {
+		cmd-dat-pins {
 			pinmux = <MT6797_GPIO129__FUNC_MSDC1_CMD>,
 				 <MT6797_GPIO130__FUNC_MSDC1_DAT0>,
 				 <MT6797_GPIO131__FUNC_MSDC1_DAT1>,
 				 <MT6797_GPIO132__FUNC_MSDC1_DAT2>,
 				 <MT6797_GPIO133__FUNC_MSDC1_DAT3>;
 		};
-		pins-clk {
+		clk-pins {
 			pinmux = <MT6797_GPIO134__FUNC_MSDC1_CLK>;
 		};
 	};
@@ -1451,7 +1454,7 @@
  */
 / {
 	u3phy: t-phy@11290000 {
-		compatible = "mediatek,generic-tphy-v1";
+		compatible = "mediatek,mt6797-tphy", "mediatek,generic-tphy-v1";
 		reg = <0 0x11290000 0 0x800>;
 		#address-cells = <2>;
 		#size-cells = <2>;
@@ -1485,7 +1488,7 @@
 	};
 
 	ssusb: usb@11271000 {
-		compatible = "mediatek,mtu3";
