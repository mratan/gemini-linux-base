arm64: dts: mediatek: gemini: 128MB default CMA pool (desktop scanout)

diff --git a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
index ae66f6f94..e244d9cfc 100644
--- a/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6797-gemini-pda.dts
@@ -86,6 +86,22 @@ reserved-memory {
 		#size-cells = <2>;
 		ranges;
 
+		/*
+		 * Default CMA pool. The kernel default (32 MB) cannot hold a
+		 * desktop's worth of 1080x2160 ARGB scanout buffers (~9.3 MB
+		 * each): sway ran single-buffered and wlr screencopy could not
+		 * allocate at all (2026-08-20 session). CONFIG_CMDLINE_FORCE=y
+		 * makes cma= unusable without a kernel rebuild — the DT pool is
+		 * the right knob anyway.
+		 */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0 0x8000000>;
+			alignment = <0 0x400000>;
+			linux,cma-default;
+		};
+
 		/* vendor: mediatek,spm-dummy-1 — first page of DRAM */
 		spm-dummy@40000000 {
 			reg = <0 0x40000000 0 0x1000>;
