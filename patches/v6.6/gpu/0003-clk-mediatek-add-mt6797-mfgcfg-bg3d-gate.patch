clk: mediatek: add MT6797 mfgcfg (g3d_config) BG3D gate driver

The vendor mali node needs "mfg-main" — the BG3D gate at g3d_config
0x13000000 (vendor clk-mt6797.c mfg_cg_regs sta 0x0/set 0x4/clr 0x8,
bit 0, parent mfg_sel). Without it the first GPU register access
stalls the AXI. Modeled on clk-mt6779-mfg.c; tristate so it can ship
as a module and panfrost defers until it probes.

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index 48b42d111..3dd12e6da 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -312,6 +312,13 @@ config COMMON_CLK_MT6797
 	help
 	  This driver supports MediaTek MT6797 basic clocks.
 
+config COMMON_CLK_MT6797_MFGCFG
+	tristate "Clock driver for MediaTek MT6797 mfgcfg"
+	depends on COMMON_CLK_MT6797
+	help
+	  This driver supports the MediaTek MT6797 mfgcfg (g3d_config)
+	  clock gate for the Mali GPU.
+
 config COMMON_CLK_MT6797_MMSYS
 	tristate "Clock driver for MediaTek MT6797 mmsys"
 	depends on COMMON_CLK_MT6797
