+config MTK_MT6797_A72
+	bool "MT6797 Cortex-A72 cluster bring-up (Gemini PDA)"
+	depends on ARM64 && I2C && HAS_IOMEM
+	default n
+	help
+	  MT6797's two Cortex-A72 cores sit behind a power domain fed by an
+	  external DA9214 buck on i2c6, and the firmware refuses to power the
+	  cluster unless that rail, the cluster PLL and an SRAM LDO are all set
+	  up before PSCI CPU_ON. Nothing in mainline does that, so cpu8 and cpu9
+	  cannot be onlined.
+
+	  This runs the vendor's prerequisites from a CPUHP_BP_PREPARE_DYN
+	  callback, which is the same insertion point the vendor kernel uses.
+	  With it, cpu8 and cpu9 online through plain sysfs hotplug and behave
+	  as ordinary CPUs.
+
+	  Say Y on the Gemini PDA.
+
 config MTK_CONSYS_SPIKE
 	tristate "MediaTek MT6797 CONSYS feasibility spike (Gemini PDA)"
