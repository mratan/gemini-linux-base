@@ -476,7 +632,7 @@
 
 	if (kstrtouint(b, 0, &mhz))
 		return -EINVAL;
-	ret = mt6797_a72_retune(mhz);
+	ret = mt6797_a72_set_opp(mhz);
 	return ret ? ret : n;
 }
 
