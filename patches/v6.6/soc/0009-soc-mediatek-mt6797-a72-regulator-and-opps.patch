+/*
+ * The vendor's operating points for cluster B, transcribed in
+ * 04-docs/A72-OPP-TABLE-2026-08-24.md from ubports-3.18
+ * drivers/misc/mediatek/base/power/mt6797/mt_cpufreq.c. The vendor's
+ * frequencies are kHz and its voltages are in units of 10 uV despite a
+ * "10MV" comment in that file: 118000 x 10 uV = 1.18 V, the rail this driver
+ * already brought up. So kHz = vendor, mV = vendor / 100.
+ *
+ * WHICH BIN: the vendor picks one of six tables from two efuse fields
+ * (FUNC_CODE / DATE_CODE). We cannot read the efuse -- mainline mt6797 has no
+ * nvmem node and /sys/bus/nvmem/devices is empty -- so this is FY1221,
+ * CPU_LEVEL_0, the LOWEST-clocked of the six and therefore the one with the
+ * highest voltage for any given clock. On a faster-binned die that
+ * under-clocks; it can never over-volt. FIXME: read the efuse and pick the
+ * real bin once an mtk-efuse node exists.
+ *
+ * The table stops at 793 MHz. The vendor continues to 650 and 338, but
+ * mt6797_a72_retune() refuses anything below 750 MHz -- the firmware's
+ * power-on gate wants ~750 and that floor has never been tested from the
+ * other direction -- so a caller asking for 338 would only ever get -EINVAL.
+ */
+struct a72_opp {
+	unsigned int khz;
+	unsigned int mv;
+};
+
+static const struct a72_opp a72_opps[] = {
+	{ 2145000, 1180 },
+	{ 2093000, 1170 },
+	{ 2054000, 1160 },
+	{ 1989000, 1140 },
+	{ 1963000, 1130 },
+	{ 1872000, 1110 },
+	{ 1690000, 1070 },
+	{ 1599000, 1050 },
+	{ 1404000, 1000 },
+	{ 1287000,  980 },
+	{ 1170000,  950 },
+	{ 1053000,  930 },
+	{  936000,  900 },
+	{  793000,  880 },
+};
+
+/*
+ * Move the cluster to the highest operating point not exceeding `mhz`, rail
+ * and clock in the order that is safe for the direction of travel.
+ *
+ * ORDER MATTERS AND IS NOT SYMMETRIC. Going up, the rail must arrive before
+ * the clock, or the cores run faster than their voltage supports. Coming down,
+ * the clock must drop first, for the same reason in reverse. Backwards does
+ * not degrade gracefully: it hangs the cluster, and on this board a hung
+ * cluster is a watchdog reset.
+ *
+ * A request above the top of the table is honoured on the top voltage rather
+ * than refused, because that is what this driver did before and the 2496 MHz
+ * burst named at A72_RUN_MHZ_DEFAULT depends on it. That is unspecified
+ * territory: the vendor publishes no voltage above 2145 MHz. FIXME: no
+ * evidence-based voltage exists for those points, which is why none is
+ * invented here.
+ */
+static int mt6797_a72_set_opp(unsigned int mhz)
+{
+	unsigned int mv, old_mv = a72_cur_mv;
+	int i, sel = ARRAY_SIZE(a72_opps) - 1;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(a72_opps); i++) {
+		if (a72_opps[i].khz / 1000 <= mhz) {
+			sel = i;
+			break;
+		}
+	}
+	mv = a72_opps[sel].mv;
+
+	if (mhz > a72_opps[0].khz / 1000) {
+		pr_warn("%u MHz is above the vendor's top OPP (%u MHz); running it on the %u mV rail\n",
+			mhz, a72_opps[0].khz / 1000, a72_opps[0].mv);
+		mv = a72_opps[0].mv;
+	} else {
+		mhz = a72_opps[sel].khz / 1000;
+	}
+
+	if (mv > old_mv) {
+		ret = a72_set_vproc2_mv(mv);
+		if (ret)
+			return ret;
+		ret = mt6797_a72_retune(mhz);
+		if (ret) {
+			pr_err("retune to %u MHz failed (%d); backing the rail out to %u mV\n",
+			       mhz, ret, old_mv);
+			a72_set_vproc2_mv(old_mv);
+			return ret;
+		}
+	} else {
+		ret = mt6797_a72_retune(mhz);
+		if (ret) {
+			pr_err("retune to %u MHz failed (%d); leaving the rail at %u mV\n",
+			       mhz, ret, old_mv);
+			return ret;
+		}
+		if (mv < old_mv) {
+			ret = a72_set_vproc2_mv(mv);
+			if (ret)	/* clock is already low; a high rail is safe */
+				pr_warn("clock is %u MHz but the rail is still %u mV (%d)\n",
+					mhz, old_mv, ret);
+		}
+	}
+	pr_info("A72 cluster at %u MHz on %u mV\n", mhz, mv);
+	return 0;
+}
+
 /* Runs ON the A72, at the tail of its own bring-up. */
 static int mt6797_a72_online(unsigned int cpu)
 {
@@ -460,7 +616,7 @@
 
 static void a72_raise_fn(struct work_struct *w)
 {
-	mt6797_a72_retune(A72_RUN_MHZ_DEFAULT);
+	mt6797_a72_set_opp(A72_RUN_MHZ_DEFAULT);
 }
 
