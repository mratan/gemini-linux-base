drm/panel: expose the panel's own RDDPM status over debugfs

Every check the panel gate can otherwise make reads state the SoC was
programmed with. That proves we sent the right thing; it does not prove the
panel accepted it. RDDPM (DCS 0x0A, Get Power Mode) is the controller's own
account of itself, and the vendor ESD table declares 0x9C for a correctly
initialised panel: booster on, sleep out, display on.

The distinction is not academic. During the 2026-07-11 investigation the init
sequence "succeeded" and every host-side register matched LK while RDDPM read
0x1C, because the manufacturer registers were going out as DCS packets instead
of generic ones and the panel was silently discarding them. Host-side state
looked perfect and the glass was dark.

There is no userspace path for a DCS read, so the gate had to skip this check
and say so. This adds /sys/kernel/debug/gemini-panel/rddpm.

Reads are attempted only while the panel is prepared. The DSI host switches to
command mode for the transfer and back again, and that transfer is bounded by
mtk_dsi's 2 s IRQ wait, so a dead panel cannot wedge a reader here. The path is
driver-owned rather than under the DRM device's directory so the gate does not
have to know which card number the panel landed on.

--- a/drivers/gpu/drm/panel/panel-solomon-ssd2092.c
+++ b/drivers/gpu/drm/panel/panel-solomon-ssd2092.c
@@ -27,6 +27,7 @@
  */
 
 #include <linux/backlight.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -51,6 +52,8 @@
 
 	bool prepared;
 	bool enabled;
+
+	struct dentry *debugfs;
 };
 
 static inline struct ssd2092 *panel_to_ssd2092(struct drm_panel *panel)
@@ -567,6 +570,52 @@
 	.get_modes	= ssd2092_get_modes,
 };
 
+/*
+ * ASK THE PANEL, not the SoC.
+ *
+ * Every other check available to the panel gate reads state the SoC was
+ * programmed with — which proves we sent the right thing, not that the panel
+ * accepted it. RDDPM (DCS 0x0A, Get Power Mode) is the panel controller's own
+ * account of itself, and the vendor's ESD table declares 0x9C for a correctly
+ * initialised panel: booster on, sleep out, display on. The difference matters:
+ * during the 2026-07-11 investigation the init "succeeded" and every host-side
+ * register looked right while RDDPM read 0x1C, because the manufacturer
+ * registers were being sent as DCS instead of generic packets and the panel
+ * was silently ignoring them.
+ *
+ * There is no userspace path for a DCS read, so the gate had to skip this
+ * check entirely. This exposes one.
+ *
+ * Reads are only attempted while the panel is prepared; the DSI host switches
+ * to command mode for the transfer and back afterwards, and that transfer is
+ * bounded by mtk_dsi (2 s), so a dead panel cannot wedge a reader here.
+ */
+static int ssd2092_rddpm_show(struct seq_file *s, void *unused)
+{
+	struct ssd2092 *priv = s->private;
+	u8 val = 0;
+	int ret;
+
+	if (!priv->prepared) {
+		seq_puts(s, "unavailable: panel not prepared\n");
+		return 0;
+	}
+
+	ret = mipi_dsi_dcs_read(priv->dsi, MIPI_DCS_GET_POWER_MODE, &val, 1);
+	if (ret < 0) {
+		seq_printf(s, "error: %d\n", ret);
+		return 0;
+	}
+	if (ret != 1) {
+		seq_printf(s, "error: short read (%d bytes)\n", ret);
+		return 0;
+	}
+
+	seq_printf(s, "0x%02x\n", val);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ssd2092_rddpm);
+
 static int ssd2092_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -624,6 +673,15 @@
 		return ret;
 	}
 
+	/*
+	 * Diagnostics live under a fixed, driver-owned path rather than under
+	 * the DRM device's directory, so the gate can find them without
+	 * knowing which card number the panel landed on.
+	 */
+	priv->debugfs = debugfs_create_dir("gemini-panel", NULL);
+	debugfs_create_file("rddpm", 0444, priv->debugfs, priv,
+			    &ssd2092_rddpm_fops);
+
 	dev_info(dev, "Solomon SSD2092 FHD DSI panel registered\n");
 	return 0;
 }
@@ -632,6 +690,7 @@
 {
 	struct ssd2092 *priv = mipi_dsi_get_drvdata(dsi);
 
+	debugfs_remove_recursive(priv->debugfs);
 	mipi_dsi_detach(dsi);
 	drm_panel_remove(&priv->panel);
 }
