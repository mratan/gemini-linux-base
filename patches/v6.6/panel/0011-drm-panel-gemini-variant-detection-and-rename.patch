--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-gemini-fhd.c
@@ -0,0 +1,1095 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Planet Computers Gemini PDA FHD DSI panel driver
+ *
+ * 5.99" 1080x2160 MIPI DSI video-mode panel on the MT6797X (Helio X27).
+ *
+ * THE GEMINI SHIPPED WITH TWO DIFFERENT PANELS, wired identically, so the
+ * device tree cannot say which one is present. The stock LK bootloader probes
+ * it at every boot and publishes the LCM's name; this driver reads that and
+ * selects the matching timings, DSI mode and init sequence at runtime, so one
+ * image serves both:
+ *
+ *   aeon_nt36672_fhd_dsi_vdo_x600_xinli  Novatek NT36672, a TDDI part (the
+ *                                        touch controller is on the same die
+ *                                        and power domain — see
+ *                                        drivers/input/touchscreen/gemini-nt36xxx.c)
+ *   aeon_ssd2092_fhd_dsi_solomon         Solomon SSD2092, panel ID 0x01572098
+ *
+ * This file was called panel-solomon-ssd2092.c and asserted the SSD2092
+ * identity in this comment for six weeks while driving an NT36672, which is a
+ * large part of why the touchscreen bug (B-31) survived as long as it did:
+ * every reader who came to the display looking for a Novatek part found a
+ * Solomon one and moved on. The name now matches the hardware, which is to say
+ * it names neither panel.
+ *
+ * All hardware values (timings, lane count, init sequences, reset sequence)
+ * come from the vendor 3.18 kernel LCM drivers:
+ *   drivers/misc/mediatek/lcm/aeon_nt36672_fhd_dsi_vdo_x600_xinli/
+ *   drivers/misc/mediatek/lcm/aeon_ssd2092_fhd_dsi_solomon/
+ * (gemian-android-kernel-3.18-android8 tree). Only the NT36672 path has ever
+ * run on hardware; see the comment on ssd2092_init_sequence().
+ *
+ * LCD bias: dual-output +/-5V charge pump (vendor calls it lp3101, same part
+ * family/address as TPS65132), I2C, addr 0x3E. Exposed here as avdd/avee
+ * regulator supplies.
+ */
+
+#include <linux/backlight.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_crtc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+/*
+ * One fitted panel. The Gemini shipped with two, and which one is present is
+ * not knowable from the device tree: the board is identical either way. LK
+ * probes it at every boot and publishes the LCM's name, so that is what we
+ * ask. See gemini_panel_detect().
+ */
+struct gemini_panel;
+
+struct gemini_panel_variant {
+	const char			*lcm;	/* LK's atag,videolfb name */
+	const char			*name;	/* for humans and the log */
+	const struct drm_display_mode	*mode;
+	unsigned long			mode_flags;
+	int				(*init)(struct gemini_panel *priv);
+};
+
+struct gemini_panel {
+	const struct gemini_panel_variant *variant;
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+
+	struct regulator *avdd;
+	struct regulator *avee;
+	struct gpio_desc *reset_gpio;
+	struct backlight_device *backlight;
+
+	bool prepared;
+	bool enabled;
+
+	struct dentry *debugfs;
+};
+
+static inline struct gemini_panel *panel_to_gemini_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct gemini_panel, panel);
+}
+
+/*
+ * PANEL IDENTITY (corrected 2026-08-20): this driver now targets the
+ * Novatek NT36672 variant, which is what LK reports for this unit in
+ * chosen/atag,videolfb ("aeon_nt36672_fhd_dsi_vdo_x600_xinli").  The
+ * Gemini shipped with at least two panel variants and the vendor tree
+ * compiles an LCM for each (CONFIG_CUSTOM_KERNEL_LCM lists both);
+ * LK picks one by string at boot.  The file/symbol names still say
+ * ssd2092 -- renaming is a follow-up, deliberately not mixed into the
+ * change that makes the panel light up.
+ *
+ * Packet-type dispatch matches the vendor DSI layer exactly
+ * (ddp_dsi.c DSI_set_cmdq_V2): commands >= 0xB0 (manufacturer
+ * registers -- all the analog/booster/gamma configuration) are sent
+ * as GENERIC packets (data ID 0x23/0x29); commands < 0xB0 (standard
+ * MIPI DCS) as DCS packets (0x05/0x15/0x39).  Sending the 0xB0+
+ * registers as DCS makes the panel silently ignore them: init
+ * "succeeds", status reads look sane, but the booster never starts
+ * (RDDPM 0x0a reads 0x1c instead of 0x9c) and the glass stays dark --
+ * root-caused 2026-07-11 after every other host-side difference had
+ * been eliminated.
+ */
+/*
+ * BOUNDED INITIALISATION (B-24).
+ *
+ * The init table is 183 commands and runs inside drm_panel_prepare(), which
+ * runs under the CRTC enable path during boot. Each command is individually
+ * bounded already -- mtk_dsi_host_send_cmd() waits at most 2 s for its IRQ --
+ * but two of those bounds do not abort anything: mtk_dsi_wait_for_idle()
+ * spends up to 2 s polling and then merely warns and resets the engine, and
+ * the mode switch adds another 500 ms. So a panel that answers slowly, or not
+ * at all, can spend minutes here without any single call "hanging".
+ *
+ * That is fatal rather than merely slow, because the RGU hardware watchdog
+ * fires at ~31 s and nothing pets it this early in boot. The result is a
+ * reset loop that looks, on the host, exactly like a flaky USB cable -- which
+ * is how it was misdiagnosed for most of an evening on 2026-08-20.
+ *
+ * So the sequence carries a wall-clock budget checked between commands. When
+ * it is exhausted the sequence aborts and names the command it stopped at,
+ * prepare() fails, and the kernel carries on booting with no image. A dark
+ * panel is a bad outcome; a watchdog loop is a dead device, and the whole
+ * point is that the first can never become the second.
+ *
+ * The budget is a module parameter so a diagnostic boot can widen it from the
+ * kernel command line without a rebuild:
+ *     panel_solomon_ssd2092.init_budget_ms=30000
+ */
+static unsigned int init_budget_ms = 8000;
+module_param(init_budget_ms, uint, 0644);
+MODULE_PARM_DESC(init_budget_ms,
+		 "wall-clock budget for the panel init sequence, ms (0 = unbounded; must stay well under the ~31 s watchdog)");
+
+static bool init_verbose;
+module_param(init_verbose, bool, 0644);
+MODULE_PARM_DESC(init_verbose,
+		 "log every init command with its index and elapsed time (names the stalling command)");
+
+struct gemini_panel_init_ctx {
+	struct mipi_dsi_device *dsi;
+	unsigned long start;
+	unsigned long deadline;
+	unsigned int index;
+};
+
+static int gemini_panel_init_cmd(struct gemini_panel_init_ctx *c, const u8 *d, size_t len)
+{
+	unsigned long t0 = jiffies;
+	ssize_t ret;
+	unsigned int ms;
+
+	if (init_budget_ms && time_after(jiffies, c->deadline)) {
+		dev_err(&c->dsi->dev,
+			"init sequence exceeded its %u ms budget at command %u (0x%02x); aborting so the boot survives\n",
+			init_budget_ms, c->index, d[0]);
+		return -ETIMEDOUT;
+	}
+
+	/*
+	 * Packet-type dispatch, unchanged: commands >= 0xB0 are Novatek
+	 * manufacturer registers and must go as GENERIC packets.
+	 */
+	if (d[0] >= 0xb0)
+		ret = mipi_dsi_generic_write(c->dsi, d, len);
+	else
+		ret = mipi_dsi_dcs_write_buffer(c->dsi, d, len);
+
+	ms = jiffies_to_msecs(jiffies - t0);
+	if (ret < 0) {
+		dev_err(&c->dsi->dev,
+			"init command %u (0x%02x) failed after %u ms: %zd\n",
+			c->index, d[0], ms, ret);
+		return ret;
+	}
+	/*
+	 * Report slow commands even on success. A command that takes a second
+	 * is the one eating the budget, and knowing which one it is turns
+	 * fixing this from a guess into a bisect.
+	 */
+	if (init_verbose)
+		dev_info(&c->dsi->dev, "init command %u (0x%02x) ok in %u ms\n",
+			 c->index, d[0], ms);
+	else if (ms >= 200)
+		dev_warn(&c->dsi->dev, "init command %u (0x%02x) took %u ms\n",
+			 c->index, d[0], ms);
+
+	c->index++;
+	return 0;
+}
