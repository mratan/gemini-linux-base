+/*
+ * ASK THE PANEL, not the SoC.
+ *
+ * Every other check available to the panel gate reads state the SoC was
+ * programmed with — which proves we sent the right thing, not that the panel
+ * accepted it. RDDPM (DCS 0x0A, Get Power Mode) is the panel controller's own
+ * account of itself, and the vendor's ESD table declares 0x9C for a correctly
+ * initialised panel: booster on, sleep out, display on. The difference matters:
+ * during the 2026-07-11 investigation the init "succeeded" and every host-side
+ * register looked right while RDDPM read 0x1C, because the manufacturer
+ * registers were being sent as DCS instead of generic packets and the panel
+ * was silently ignoring them.
+ *
+ * There is no userspace path for a DCS read, so the gate had to skip this
+ * check entirely. This exposes one.
+ *
+ * Reads are only attempted while the panel is prepared; the DSI host switches
+ * to command mode for the transfer and back afterwards, and that transfer is
+ * bounded by mtk_dsi (2 s), so a dead panel cannot wedge a reader here.
+ */
+static int gemini_panel_rddpm_show(struct seq_file *s, void *unused)
+{
+	struct gemini_panel *priv = s->private;
+	u8 val = 0;
+	int ret;
+
+	if (!priv->prepared) {
+		seq_puts(s, "unavailable: panel not prepared\n");
+		return 0;
+	}
+
+	ret = mipi_dsi_dcs_read(priv->dsi, MIPI_DCS_GET_POWER_MODE, &val, 1);
+	if (ret < 0) {
+		seq_printf(s, "error: %d\n", ret);
+		return 0;
+	}
+	if (ret != 1) {
+		seq_printf(s, "error: short read (%d bytes)\n", ret);
+		return 0;
+	}
+
+	seq_printf(s, "0x%02x\n", val);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(gemini_panel_rddpm);
+
+static int gemini_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct gemini_panel *priv;
+	const char *lcm;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, priv);
+
+	/*
+	 * Which panel is fitted, from the bootloader rather than from the
+	 * device tree — the two variants are wired identically, so the DT
+	 * cannot tell them apart and this file used to just assume.
+	 *
+	 * When LK says nothing we recognise, fall back to the NT36672 and say
+	 * so loudly, rather than refusing to probe: a machine that boots with
+	 * a display that might be wrong is recoverable over the network, and
+	 * one that boots with no display at all, on a device whose only other
+	 * way in is a USB cable, is a lot less so. The message is what makes
+	 * the difference diagnosable.
+	 */
+	priv->variant = gemini_panel_detect(dev, &lcm);
+	if (!priv->variant) {
+		priv->variant = &gemini_panel_variants[0];
+		dev_warn(dev,
+			 "no usable panel identity from the bootloader (%s); assuming %s. If the display is dark or scrambled, this is why.\n",
+			 lcm ? lcm : "/chosen/atag,videolfb absent or malformed",
+			 priv->variant->name);
+	} else {
+		dev_info(dev, "bootloader reports %s (\"%s\")\n",
+			 priv->variant->name, lcm);
+	}
+
+	priv->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(priv->avdd))
+		return dev_err_probe(dev, PTR_ERR(priv->avdd), "avdd regulator\n");
+
+	priv->avee = devm_regulator_get(dev, "avee");
+	if (IS_ERR(priv->avee))
+		return dev_err_probe(dev, PTR_ERR(priv->avee), "avee regulator\n");
+
+	priv->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(priv->reset_gpio), "reset gpio\n");
+
+	priv->backlight = devm_of_find_backlight(dev);
+	if (IS_ERR(priv->backlight))
+		return dev_err_probe(dev, PTR_ERR(priv->backlight), "backlight\n");
+
+	drm_panel_init(&priv->panel, dev, &gemini_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	drm_panel_add(&priv->panel);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * LK's working TXRX_CTRL is 0x0001003c: EOT packets enabled (bit 6
+	 * DIS_EOT clear) and HS clock allowed into LP between transmissions
+	 * (bit 16 HSTX_CKLP_EN set).  mtk_dsi's DIS_EOT handling is inverted
+	 * relative to the flag name: it sets DIS_EOT unless the panel asks
+	 * for MIPI_DSI_MODE_NO_EOT_PACKET — so NO_EOT_PACKET here *enables*
+	 * EOT on the wire, and CLOCK_NON_CONTINUOUS sets HSTX_CKLP_EN,
+	 * making the register bit-identical to LK's.
+	 */
+	dsi->mode_flags = priv->variant->mode_flags;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to attach DSI: %d\n", ret);
+		drm_panel_remove(&priv->panel);
+		return ret;
+	}
+
+	/*
+	 * Diagnostics live under a fixed, driver-owned path rather than under
+	 * the DRM device's directory, so the gate can find them without
+	 * knowing which card number the panel landed on.
+	 */
+	priv->debugfs = debugfs_create_dir("gemini-panel", NULL);
+	debugfs_create_file("rddpm", 0444, priv->debugfs, priv,
+			    &gemini_panel_rddpm_fops);
+
+	dev_info(dev, "%s FHD DSI panel registered\n", priv->variant->name);
+	return 0;
+}
+
+static void gemini_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct gemini_panel *priv = mipi_dsi_get_drvdata(dsi);
+
+	debugfs_remove_recursive(priv->debugfs);
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&priv->panel);
+}
+
+static const struct of_device_id gemini_panel_of_match[] = {
+	{ .compatible = "planet,gemini-panel" },
+	/*
+	 * Kept: every DTB flashed before 2026-08-21 says solomon,ssd2092, and
+	 * some of them are in boot slots that exist precisely to be fallen
+	 * back to. Dropping it would make this driver refuse to bind on a
+	 * rescue boot. It is a name, not a claim about the hardware — which
+	 * panel is fitted is decided by gemini_panel_detect() either way.
+	 */
+	{ .compatible = "solomon,ssd2092" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gemini_panel_of_match);
+
+static struct mipi_dsi_driver gemini_panel_driver = {
+	.probe  = gemini_panel_probe,
+	.remove = gemini_panel_remove,
+	.driver = {
+		.name = "panel-gemini-fhd",
+		.of_match_table = gemini_panel_of_match,
+	},
+};
+module_mipi_dsi_driver(gemini_panel_driver);
+
+MODULE_AUTHOR("Ben Hamilton <ben@wakatipu.co>");
+MODULE_DESCRIPTION("Planet Computers Gemini PDA FHD DSI panel (NT36672 / SSD2092)");
+MODULE_LICENSE("GPL");
