+static int gemini_panel_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	struct gemini_panel *priv = panel_to_gemini_panel(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, priv->variant->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = priv->variant->mode->width_mm;
+	connector->display_info.height_mm = priv->variant->mode->height_mm;
+
+	return 1;
+}
