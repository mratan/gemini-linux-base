+/*
+ * Known panels, by the name LK publishes.
+ *
+ * The Gemini shipped in two panel variants with identical wiring, so the
+ * device tree cannot tell them apart and a build that assumes one produces a
+ * dark screen on the other. The stock LK bootloader probes the fitted panel at
+ * every boot and hands the result to the kernel in the videolfb ATAG, which
+ * arrives as /chosen/atag,videolfb: an 8-byte framebuffer base, an
+ * "lcm found" flag, fps, vram size, then the LCM's name as a NUL-terminated
+ * string. On this unit that string reads
+ * "aeon_nt36672_fhd_dsi_vdo_x600_xinli".
+ *
+ * That is the same identity the vendor kernel selects its LCM driver by, so it
+ * is the right thing to key on rather than anything we could guess from the
+ * board.
+ */
+#define VIDEOLFB_LCMNAME_OFFSET	20	/* u64 fb_base, u32 islcmfound, fps, vram */
+
+static const struct gemini_panel_variant gemini_panel_variants[] = {
+	{
+		.lcm		= "aeon_nt36672_fhd_dsi_vdo_x600_xinli",
+		.name		= "Novatek NT36672 (TDDI)",
+		.mode		= &nt36672_mode,
+		.init		= nt36672_init_sequence,
+		/*
+		 * BURST, per the vendor LCM. See the mode comment for why the
+		 * EOT/clock-lane flags are the way round they are.
+		 */
+		.mode_flags	= MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+				  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET |
+				  MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	},
+	{
+		.lcm		= "aeon_ssd2092_fhd_dsi_solomon",
+		.name		= "Solomon SSD2092",
+		.mode		= &ssd2092_mode,
+		.init		= ssd2092_init_sequence,
+		/* SYNC_PULSE_VDO_MODE in the vendor LCM, not burst. */
+		.mode_flags	= MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+				  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET |
+				  MIPI_DSI_CLOCK_NON_CONTINUOUS,
+	},
+};
+
+/* Which panel LK says is fitted, or NULL if it did not say anything we know. */
+static const struct gemini_panel_variant *gemini_panel_detect(struct device *dev,
+							      const char **lcm_out)
+{
+	struct device_node *chosen;
+	const char *lcm = NULL;
+	const u8 *tag;
+	int len, i;
+
+	*lcm_out = NULL;
+
+	chosen = of_find_node_by_path("/chosen");
+	if (!chosen)
+		return NULL;
+
+	tag = of_get_property(chosen, "atag,videolfb", &len);
+	if (tag && len > VIDEOLFB_LCMNAME_OFFSET) {
+		const char *s = (const char *)tag + VIDEOLFB_LCMNAME_OFFSET;
+
+		/* Only trust it if it is actually NUL-terminated inside the tag. */
+		if (memchr(s, 0, len - VIDEOLFB_LCMNAME_OFFSET))
+			lcm = s;
+	}
+	of_node_put(chosen);
+
+	if (!lcm || !*lcm)
+		return NULL;
+
+	*lcm_out = lcm;
+
+	for (i = 0; i < ARRAY_SIZE(gemini_panel_variants); i++)
+		if (!strcmp(lcm, gemini_panel_variants[i].lcm))
+			return &gemini_panel_variants[i];
+
+	dev_warn(dev, "bootloader reports panel \"%s\", which this driver does not know\n",
+		 lcm);
+	return NULL;
+}
