+static const struct drm_panel_funcs gemini_panel_funcs = {
+	.prepare	= gemini_panel_prepare,
+	.enable		= gemini_panel_enable,
+	.disable	= gemini_panel_disable,
+	.unprepare	= gemini_panel_unprepare,
+	.get_modes	= gemini_panel_get_modes,
+};
