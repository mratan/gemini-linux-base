 /*
+ * Camera LDO voltage tables, transcribed from the vendor
+ * drivers/misc/mediatek/power/mt6797/pmic.c. The vendor mtk_ldos[] entries
+ * name which table belongs to which rail:
+ *
+ *   vcama  -> mt6351_VCAMA_voltages
+ *   vcamd  -> mt6351_VCAMD_voltages
+ *   vcamio -> mt6351_VCAM_IO_voltages
+ *
+ * All three VOSEL fields are three bits wide, and the vendor describes fewer
+ * than eight codes for each. The undescribed codes are entered as 0, which
+ * regulator_list_voltage_table() reports as "unknown" — NOT left off the end
+ * of the table.
+ *
+ * That matters more than it looks. These rails are constrained min == max in
+ * DT, which sets apply_uV, so machine_constraints_voltage() reads the live
+ * VOSEL at registration. A short table makes an out-of-range selector return
+ * -EINVAL, machine_constraints_voltage() propagates it, devm_regulator_register()
+ * fails, and mt6351_regulator_probe() returns the error for the WHOLE driver —
+ * so a bootloader that happened to leave a camera rail on an undescribed code
+ * would take out vcn18/vcn28/vcn33_wifi and vmch/vmc with it, i.e. internal
+ * Wi-Fi (ADR-0001) and the SD card would die because of a camera rail. A
+ * padded table reads back 0 uV instead, and the constraint is then applied
+ * normally. The zeros are never selectable: regulator_map_voltage_iterate()
+ * only picks an entry inside [min_uV, max_uV], and no rail here allows 0.
+ */
+static const unsigned int mt6351_vcama_voltages[] = {
+	1500000, 1800000, 2500000, 2800000, 0, 0, 0, 0,
