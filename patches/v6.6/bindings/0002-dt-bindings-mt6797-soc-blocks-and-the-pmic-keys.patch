Subject: [PATCH] dt-bindings: MT6797 clock controllers and the MT6351 PMIC keys

diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6797-mfgcfg.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6797-mfgcfg.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6797-mfgcfg.yaml
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6797-mfgcfg.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 MFGCFG clock controller
+
+maintainers:
+  - Gemini PDA Linux port <https://github.com/mratan/gemini-linux>
+
+description:
+  The MFGCFG block holds the clock gates for the MT6797's Mali GPU. Without a
+  provider for it the GPU's core clock does not exist and panfrost cannot bind
+  at all, so this node is a hard requirement for graphics rather than an
+  optimisation.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-mfgcfg
+
+  reg:
+    maxItems: 1
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@13000000 {
+        compatible = "mediatek,mt6797-mfgcfg";
+        reg = <0x13000000 0x1000>;
+        #clock-cells = <1>;
+    };
diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6797-mcumixed.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6797-mcumixed.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6797-mcumixed.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6797-mcumixed.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6797 MCUMIXED clock controller
+
+maintainers:
+  - Gemini PDA Linux port <https://github.com/mratan/gemini-linux>
+
+description:
+  MCUMIXED carries the muxes that select which PLL feeds each CPU cluster.
+  Reparenting them is how a cluster changes frequency, so cpufreq drives these
+  muxes directly rather than leaving them to the clock framework.
+
+properties:
+  compatible:
+    const: mediatek,mt6797-mcumixed
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: 26 MHz crystal
+      - description: ARMPLL divider output 1
+      - description: ARMPLL divider output 2
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mt6797-clk.h>
+
+    clock-controller@1001a000 {
+        compatible = "mediatek,mt6797-mcumixed";
+        reg = <0x1001a000 0x1000>;
+        clocks = <&clk26m>,
+                 <&topckgen CLK_TOP_ARMPLL_DIV_PLL1>,
+                 <&topckgen CLK_TOP_ARMPLL_DIV_PLL2>;
+        #clock-cells = <1>;
+    };
diff --git a/Documentation/devicetree/bindings/input/mediatek,mt6351-keys.yaml b/Documentation/devicetree/bindings/input/mediatek,mt6351-keys.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/mediatek,mt6351-keys.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/mediatek,mt6351-keys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6351 PMIC keys
+
+maintainers:
+  - Gemini PDA Linux port <https://github.com/mratan/gemini-linux>
+
+description: |
+  The MT6351 PMIC has two keys, PWRKEY and HOMEKEY. Both are debounced in
+  hardware and both report their level in one register, TOPSTATUS.
+
+  This is a POLLED driver, unlike mtk-pmic-keys which serves the other
+  MediaTek PMICs. The MT6351's interrupt is an EINT, and the SoC it is paired
+  with here (MT6797) has no EINT support in mainline pinctrl, so there is no
+  interrupt to request. Both key states live in the same register, so a poll
+  costs one PMIC read.
+
+  The node lives under the PMIC's own node. Note that the PMIC node is an MFD
+  node with no MFD driver in mainline, so whatever binds it must populate its
+  device-tree children for this node to become a device at all.
+
+  A long press of PWRKEY is a PMIC hardware function (RG_PWRKEY_RST_EN) that
+  forces the system off. It owes nothing to software, so a driver reporting a
+  short press as an ordinary key does not conflict with it -- but it does mean
+  the chosen keycode should be one a user pressing a power key would accept, or
+  that userspace should be told not to act on it.
+
+properties:
+  compatible:
+    const: mediatek,mt6351-keys
+
+  linux,keycodes:
+    minItems: 1
+    maxItems: 2
+    description:
+      Keycodes for PWRKEY and HOMEKEY, in that order. On the Planet Gemini PDA
+      these two buttons are the key silkscreened "Esc" at the top left and the
+      silver button on the right side, so KEY_ESC and KEY_SLEEP.
+
+  poll-interval:
+    default: 20
+    minimum: 1
+    maximum: 1000
+    description:
+      Polling period in milliseconds. The default is short enough that a
+      deliberate press is not missed and long enough that the cost is
+      negligible; one poll is a single PMIC register read.
+
+required:
+  - compatible
+  - linux,keycodes
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/input/linux-event-codes.h>
+
+    pmic {
+        compatible = "mediatek,mt6351";
+
+        keys {
+            compatible = "mediatek,mt6351-keys";
+            linux,keycodes = <KEY_ESC>, <KEY_SLEEP>;
+            poll-interval = <20>;
+        };
+    };
