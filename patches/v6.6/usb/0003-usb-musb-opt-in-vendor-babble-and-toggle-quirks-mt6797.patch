diff --git a/drivers/usb/musb/musb_core.c b/drivers/usb/musb/musb_core.c
index b24adb5b3..edbac382b 100644
--- a/drivers/usb/musb/musb_core.c
+++ b/drivers/usb/musb/musb_core.c
@@ -996,7 +996,24 @@ static void musb_handle_intr_reset(struct musb *musb)
 		 * Babble conditions. One such platform is AM335x. In
 		 * most cases, however, the only thing we can do is
 		 * drop the session.
+		 *
+		 * babble_keep_session (opt-in, MediaTek MT6797 usb11 —
+		 * see drivers/usb/musb/mediatek.c): the vendor musbfsh
+		 * driver logs and IGNORES babble while a device is
+		 * attached (DEVCTL FSDEV covers FS and HS devices),
+		 * keeping the session up; dropping the session on this
+		 * IP has been observed to wedge the host until reboot.
 		 */
+		if (musb->config->babble_keep_session) {
+			u8 devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
+
+			if (devctl & (MUSB_DEVCTL_FSDEV | MUSB_DEVCTL_LSDEV)) {
+				dev_err(musb->controller,
+					"Babble (ignored, session kept, devctl %02x)\n",
+					devctl);
+				return;
+			}
+		}
 		dev_err(musb->controller, "Babble\n");
 		musb_recover_from_babble(musb);
 	} else {
