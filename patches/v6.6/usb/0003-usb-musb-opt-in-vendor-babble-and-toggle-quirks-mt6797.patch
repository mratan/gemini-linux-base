 {
 	struct musb *musb = qh->hw_ep->musb;
+	struct mtk_glue *glue = dev_get_drvdata(musb->controller->parent);
 	u8 epnum = qh->hw_ep->epnum;
 	u16 value, toggle;
 
 	toggle = usb_gettoggle(urb->dev, qh->epnum, is_out);
 
+	if (glue->quirk_vendor_toggle) {
+		/*
+		 * GEMINI (MT6797 usb11, issue #27 candidate C1): write the
+		 * toggle ABSOLUTELY and race-free, vendor musbfsh style
+		 * (musbfsh_host.c): a single 32-bit write covering TOG[15:0]
+		 * plus TOGEN[31:16], with TOGEN acting as the per-EP
+		 * write-enable so only this endpoint's bit is updated. The
+		 * 16-bit RMW below has two defects the vendor mechanism
+		 * avoids: it can never CLEAR a stale DATA1 (usbcore toggle
+		 * resets after dequeue/error are lost -> persistent PID
+		 * mismatch), and — with TOGEN left at GENMASK(15,0) by
+		 * mtk_musb_init — its write-back clobbers other endpoints'
+		 * hardware-updated toggle bits with a stale snapshot while
+		 * they stream. Vendor follows with a second write clearing
+		 * the write-enable half. Opt-in via DT
+		 * "mediatek,quirk-vendor-toggle" (usbexp variant DTB).
+		 */
+		u16 tog_reg = is_out ? MUSB_TXTOG : MUSB_RXTOG;
+
+		musb_writel(musb->mregs, tog_reg,
+			    ((u32)(1 << epnum) << 16) | (toggle << epnum));
+		musb_writel(musb->mregs, tog_reg, toggle << epnum);
+		return 0;
+	}
+
 	if (is_out) {
 		value = musb_readw(musb->mregs, MUSB_TXTOG);
 		value |= toggle << epnum;
