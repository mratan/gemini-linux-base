[Unit]
Description=Address the built-in USB ethernet gadget (headless SSH access, no serial)
Documentation=file:///usr/local/sbin/gemini-usb-net
After=local-fs.target systemd-udevd.service gemini-wdt-disable.service
Before=ssh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gemini-usb-net
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
