#!/bin/sh
# gemini-usb-net — give the built-in USB ethernet gadget an IP so the
# Experimental slot is reachable over the USB cable with NO serial adapter.
#
# The experimental kernel has CONFIG_USB_ETH=y (legacy g_ether, built-in), so
# an ethernet gadget auto-binds the mtu3 UDC at boot and creates a device-side
# `usb0` netdev — BEFORE any userspace runs. A configfs gadget therefore can
# never bind (UDC already busy); the earlier approach fought g_ether and lost.
# So we simply ride g_ether: wait for its usb0 and address it. Host side
# (navier/damkohler) takes 10.15.19.100/24 on its matching usb ethernet iface.
# sshd (enabled separately) binds 0.0.0.0, so it answers on 10.15.19.82.
set -e
log() { echo "gemini-usb-net: $*"; }

# find the gadget's device-side ethernet iface: prefer usb0, else the first
# iface whose driver is a usb ethernet gadget function.
find_if() {
    [ -e /sys/class/net/usb0 ] && { echo usb0; return; }
    for n in /sys/class/net/*; do
        d=$(basename "$n")
        case "$d" in lo|eth*|wlan*) continue;; esac
        # g_ether/u_ether device side shows up as usbN
        case "$d" in usb*) echo "$d"; return;; esac
    done
}

IF=""
for _ in $(seq 1 30); do
    IF=$(find_if)
    [ -n "$IF" ] && break
    sleep 1
done
[ -n "$IF" ] || { log "no usb gadget iface appeared after 30s"; exit 1; }

ip addr add 10.15.19.82/24 dev "$IF" 2>/dev/null || true
ip link set "$IF" up
log "configured $IF = 10.15.19.82/24 (host side: 10.15.19.100/24)"
