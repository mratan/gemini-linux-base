#!/bin/sh
# gemini-net-up — bring internal Wi-Fi up after boot and join the stored
# network, so SSH does not depend on the USB cable.
#
# Why a second channel matters: the USB gadget dies on many boots, and when it
# does the session is over until someone is physically at the device. That is
# the thing this whole lab exists to avoid.
#
# WHY THIS IS DANGEROUS, AND WHAT MAKES IT SAFE
#
# Measured 2026-08-20: run unguarded at boot, this script took the entire
# system down at ~177 s uptime on two separate boots — gadget gone, panel dark,
# nothing back, physical power cycle required. The identical kernel with this
# script disabled ran indefinitely. The cause is the CONSYS func-on itself, not
# the logic here: a func-on on a non-cold CONSYS can wedge the MCU, and when it
# wedges it takes the AXI bus and the machine with it. An unattended lab does
# warm reboots constantly, so it almost never sees a cold CONSYS.
#
# Two things together make it survivable rather than fatal:
#
#   1. A real hardware watchdog reset (gemini-wdt-hardreset, B-29). A wedge
#      then costs a reboot instead of the device.
#   2. The attempt counter below. Without it, a wedge-reset would re-run the
#      same bring-up and wedge again forever — recovery that loops is not
#      recovery. The counter is incremented and SYNCED *before* the risky call,
#      so a wedge leaves evidence it happened; it is cleared only on success.
#      After MAXFAIL consecutive incomplete attempts the script stands down and
#      lets the system boot without Wi-Fi.
#
# Wi-Fi is worth having. It is not worth more than the machine, and this is what
# keeps that trade the right way round.
#
# TIMING IS ALSO LOAD-BEARING. A func-on at ~14 s uptime wedges a cold CONSYS
# outright: regulators, clocks and pwrap are not ready that early, and no
# retry recovers it. So this waits for a settle floor measured from boot.
#
# It deliberately does NOT touch the watchdog — see gemini-watchdog.
set -u

SETTLE=${GEMINI_SETTLE:-120}
LOG=/var/log/gemini-net-up.log
WPA=/root/wpa.conf
K=/lib/modules/$(uname -r)/updates
STATE=/var/lib/gemini
STAMP=$STATE/consys-attempts
MAXFAIL=${GEMINI_MAXFAIL:-2}

exec >>"$LOG" 2>&1
echo "=== gemini-net-up $(date -Is) uptime=$(cut -d. -f1 /proc/uptime)s ==="

# Wait for the settle floor measured from boot, not from service start, so a
# slow boot does not add to it.
while :; do
    up=$(cut -d. -f1 /proc/uptime)
    [ "$up" -ge "$SETTLE" ] && break
    sleep 5
done
echo "settled at uptime ${up}s"

if [ ! -r "$WPA" ]; then
    echo "no $WPA — nothing to join; leaving Wi-Fi down"; exit 0
fi

mkdir -p "$STATE"

# Exactly one instance, ever. Two concurrent bring-ups race each other into
# "no hif info" and leave the WMT core half-initialised — observed 2026-08-20
# when a manual run overlapped the boot service. Worse, there is no way back:
# mtk_stp_wmt_soc CANNOT be unloaded (wmt_lib_deinit deadlocks in
# kthread_stop), so once the stack is half-up the only retry is a reboot.
if ! mkdir "$STATE/net-up.lock" 2>/dev/null; then
    echo "another gemini-net-up is running; refusing to race it"
    exit 0
fi
trap 'rmdir "$STATE/net-up.lock" 2>/dev/null' EXIT

# For the same reason the retry budget is PER BOOT, not per attempt: retrying
# within one boot cannot work, because the modules from the failed attempt are
# still loaded and unremovable. A second try only makes sense after a reboot.
if [ -e /run/gemini-net-up.attempted ]; then
    echo "already attempted this boot; a retry needs a reboot (modules are unremovable)"
    exit 0
fi
: > /run/gemini-net-up.attempted   # /run is tmpfs: cleared every boot

fails=$(cat "$STAMP" 2>/dev/null || echo 0)
case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
if [ "$fails" -ge "$MAXFAIL" ]; then
    echo "STANDING DOWN: $fails consecutive attempts did not complete."
    echo "A CONSYS wedge takes the whole system with it, so this does not retry"
    echo "indefinitely. Clear $STAMP by hand to try again."
    exit 0
fi
# Increment and SYNC before touching CONSYS: if the func-on wedges the machine,
# this file is the only record that the attempt ever happened.
echo $((fails + 1)) > "$STAMP"
sync
echo "attempt $((fails + 1)) of $MAXFAIL"

if ! ip link show wlan0 >/dev/null 2>&1; then
    echo "-- bringing up the CONSYS stack"
    for m in mtk_btif mtk_stp_wmt_soc mtk_wmt_detect; do
        insmod "$K/$m.ko" 2>&1 | sed "s/^/   $m: /"
    done
    /usr/sbin/wmt_loader; echo "   wmt_loader rc=$?"
    for m in rfkill cfg80211 wlan_gen3; do
        insmod "$K/$m.ko" 2>&1 | sed "s/^/   $m: /"
    done
    # reset-failed first: a transient unit left over from an earlier attempt
    # makes systemd-run refuse ("already loaded or has a fragment file"), the
    # launcher never starts, and func-on then fails with a bare I/O error that
    # says nothing about why. Cost an hour to spot.
    systemctl reset-failed gemini-wmt-launcher 2>/dev/null
    systemctl unmask gemini-wmt-launcher 2>/dev/null
    systemd-run -q --unit=gemini-wmt-launcher /usr/sbin/wmt_launcher -p /lib/firmware
    if ! pgrep -f wmt_launcher >/dev/null 2>&1; then
        echo "   WARNING wmt_launcher is not running; func-on will fail"
    fi
    sleep 4
    echo 1 > /dev/wmtWifi; echo "   func-on rc=$?"
    # wlan0 does not appear instantly after func-on.
    for _ in $(seq 1 30); do
        ip link show wlan0 >/dev/null 2>&1 && break
        sleep 1
    done
fi

ip link show wlan0 >/dev/null 2>&1 || { echo "wlan0 never appeared — giving up"; exit 1; }
ip link set wlan0 up
echo "-- wlan0 up, associating"

# Association can fail transiently (a scan that lands badly, a slow AP). A
# wedged CONSYS will not recover no matter how often we ask, so the retry
# budget is small and deliberate rather than a loop that hides the difference.
state=
for attempt in 1 2 3; do
    pkill -f "wpa_supplicant.*wlan0" 2>/dev/null && sleep 1
    wpa_supplicant -B -i wlan0 -c "$WPA" -f /root/wpa.log || { echo "supplicant failed to start"; sleep 5; continue; }
    for _ in $(seq 1 30); do
        state=$(wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^wpa_state=//p')
        [ "$state" = COMPLETED ] && break
        sleep 1
    done
    echo "attempt $attempt: wpa_state=$state"
    [ "$state" = COMPLETED ] && break
    sleep 5
done
[ "$state" = COMPLETED ] || { tail -20 /root/wpa.log; exit 2; }

busybox udhcpc -i wlan0 -q -n -t 10 -s /usr/share/udhcpc/default.script
addr=$(ip -4 -br addr show wlan0)
echo "wlan0: $addr"
# Publish the address where the host can find it without guessing.
ip -4 -o addr show wlan0 | awk '{print $4}' | cut -d/ -f1 > /run/gemini-wifi-ip
# Survived the dangerous part: reset the counter so the next boot starts fresh.
echo 0 > "$STAMP"
sync
echo "GEMINI-NET-UP-OK $(cat /run/gemini-wifi-ip 2>/dev/null)"
