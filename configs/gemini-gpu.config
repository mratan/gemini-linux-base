# Track 2 (GPU / panfrost) — UNPROVEN device-free staging. gemini_linux #7.
#
# Enables the panfrost DRM driver for the MT6797 Mali Midgard GPU. This is
# staged so the first GPU device session is a test, not development: no
# device has run it. panfrost is built as a MODULE (=m) on purpose — it must
# NOT be in the boot path, so that the MFG power domains (which are registered
# KEEP_DEFAULT_OFF in patches/v6.6/pmdomain/0003) are never powered during the
# display/Wi-Fi bring-up this project actually gates on. Loading the module is
# the explicit first-session GPU test step.
#
# CONFIG_DRM is already =y via gemini-display.config. Panfrost's other deps
# (DRM_SCHED, DRM_GEM_SHMEM_HELPER, IOMMU_SUPPORT, IOMMU_IO_PGTABLE_LPAE,
# PM_DEVFREQ, DEVFREQ_GOV_SIMPLE_ONDEMAND) are pulled in by its Kconfig
# `select`s and resolved by olddefconfig — they are not listed here.
CONFIG_DRM_PANFROST=m

# The GPU supply is an external I2C buck modelled as a richtek,rt5735 (a
# fan53555 variant added by patches/v6.6/regulator/0001). Ensure its driver
# is present so panfrost's mali-supply resolves instead of deferring forever.
CONFIG_REGULATOR_FAN53555=y
CONFIG_COMMON_CLK_MT6797_MFGCFG=m
