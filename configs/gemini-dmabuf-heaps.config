# DMA-BUF heaps — what userspace uses to allocate shareable buffers (#68).
#
# libcamera's software ISP debayers into a buffer it allocates itself and then
# hands on as a dma-buf. With no provider it says so and gives up:
#
#     ERROR DmaBufAllocator dma_buf_allocator.cpp:119
#           Could not open any dma-buf provider
#
# It looks for /dev/dma_heap/* first and falls back to /dev/udmabuf, so both go
# on. The system heap is plain shareable memory with no CMA reservation behind
# it, which is what the software ISP wants: its output is consumed by the CPU
# and by the GPU through dma-buf import, not by a device that needs physically
# contiguous pages.
#
# Deliberately NOT the CMA heap. This board's CMA reservation is 32 MB and the
# camera's own capture buffers already come out of it via vb2-dma-contig -- at
# 2592x1944 that is 6.3 MB a frame. Handing userspace a way to allocate from
# the same pool is how the capture path starts failing to get buffers at the
# worst moment.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_UDMABUF=y
