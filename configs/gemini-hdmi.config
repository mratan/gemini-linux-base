# External display (HDMI-out) — Track 3, Slice VS1 (tracker issue #13).
#
# Enables the mainline drm/bridge/sii902x.c HDMI bridge (SiI9024A / Silicon
# Image 902x TPI family) that the ported MT6797 DPI encoder attaches to. The
# DPI encoder itself is part of DRM_MEDIATEK (enabled in gemini-display.config).
#
# Built-in (=y), not =m: the Gemini's bring-up initramfs is a minimal
# rdinit=/bin/sh with no modprobe path (see gemini-display.config), so every
# driver in the display chain must be built in or it never loads.
#
# DRM_SII902X selects DRM_KMS_HELPER, REGMAP_I2C and I2C_MUX; I2C is already on
# (i2c-mt65xx via the touch/charger fragments). No firmware is referenced — the
# SiI9024A is pure TPI I2C register init + DDC EDID (ADR-0003).
CONFIG_DRM_SII902X=y
