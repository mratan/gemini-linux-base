# Track 4 (Camera) — slice #63: power and clock the camera domain.
#
# Nothing here produces an image. It is the bottom of the stack: the camsys
# clock gates, and the bring-up power controller that lets an I2C scan find
# out which sensors this board is actually fitted with.
#
# Both are MODULES on purpose. The Experimental slot is somebody's daily
# desktop, and the PRD (#62) requires that a fault in camera code be an rmmod
# rather than a reflash. The power controller additionally powers nothing at
# probe — it has a "power" sysfs attribute — so udev autoloading it at boot
# costs a bound driver and no watts.
#
# REGULATOR_MT6351 is already =y from gemini-consys.config; the camera rails
# (vcama/vcamd/vcamio/vldo28) are added to that same driver by
# patches/v6.6/regulator/0004 and need no separate symbol.
CONFIG_COMMON_CLK_MT6797_CAMSYS=m
CONFIG_GEMINI_CAMERA_POWER=m

# i2cdetect/i2ctransfer on the camera buses need the userspace I2C interface.
# Already =y for the touch-controller probes; asserted here so that the camera
# work does not silently depend on another fragment keeping it.
CONFIG_I2C_CHARDEV=y
