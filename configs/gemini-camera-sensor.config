# Track 4 (Camera) — slice #64: the front sensor as a V4L2 subdev.
#
# The sensor is an SK Hynix Hi-556, and mainline already drives it:
# drivers/media/i2c/hi556.c checks register 0x0f16 for 0x0556 and declares
# 2 CSI-2 data lanes, which is exactly what the vendor's "sp5509" driver does.
# So this slice is a mainline driver plus device-tree support for it
# (patches/v6.6/media/0001), not a port of 2000 lines of vendor C.
#
# =m like everything else in Track 4: the Experimental slot is somebody's
# daily desktop and a camera fault must be an rmmod, not a reflash.
CONFIG_VIDEO_HI556=m

# The subdev userspace API and the media-controller graph. MEDIA_SUPPORT and
# VIDEO_DEV are already on in the Base tree (that is why #62 needed no
# enablement slice); these are asserted here so the camera work does not
# silently depend on another fragment keeping them, which is the failure
# gemini-kbuild.sh exists to catch.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y

# hi556 needs these to build at all; V4L2_FWNODE is what parses the DT
# endpoint's data-lanes and link-frequencies.
CONFIG_V4L2_FWNODE=m
CONFIG_VIDEO_CAMERA_SENSOR=y

# Slices #64 and #65: the media-graph seam that exposes the sensor subdev,
# the SENINF CSI-2 receiver and the CAMSV0 capture node.
CONFIG_GEMINI_CAMERA_BRIDGE=m

# The DMA buffer backend for the CAMSV capture node. Selected by
# GEMINI_CAMERA_BRIDGE, and asserted here because a silently-dropped buffer
# backend is exactly the class of failure gemini-kbuild.sh exists to catch.
CONFIG_VIDEOBUF2_DMA_CONTIG=m
