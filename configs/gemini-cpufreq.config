# CPU clocks and DVFS for MT6797 (B-40, issue #55).
#
# MT6797 keeps its CPU clock tree in MCUMIXED at 0x1001a000 -- four ARMCAXPLLs
# and a per-cluster mux -- a block mainline has never modelled. Without a
# provider for it the CPU clocks do not exist, mediatek-cpufreq has nothing to
# bind to, and the machine runs at whatever operating point LK left behind:
# measured 897 MHz on the little cluster against a rated 1547, and 1274 MHz on
# the big-little cluster against a rated 2002.
#
# Built in, not modular, for both symbols below: cpufreq binds during boot and
# a module that loads afterwards is too late.
CONFIG_COMMON_CLK_MT6797_MCUMIXED=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y

# VSRAM, the A53 clusters' SRAM supply. An array of eight on-die LDOs in
# INFRACFG_AO, not a PMIC rail. The vendor keeps it at or above Vproc, so it
# has to be raised from the 1100 mV the bootloader leaves before cpufreq can
# take Vproc to 1200 mV for the top OPP of either cluster. Built in for the
# same reason as the rest: it must be settled before Vproc starts moving.
CONFIG_REGULATOR_MT6797_CPU_SRAM=y
