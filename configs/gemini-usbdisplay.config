# USB display — Track 3 re-route (ADR-0004; tracker issue #26 "Slice U1",
# PRD #25): external monitor over USB graphics instead of the Native HDMI
# bridge (whose Planet 30-001-01 cable is unobtainable).
#
# Primary route: upstream udl driving a DL-165/DL-195-class USB 2.0 adapter
# on the right-port MUSB host. =m and default-safe: udl.ko only binds when a
# DisplayLink device actually enumerates; with no adapter plugged in, boot
# and the internal panel are unchanged. Module (not =y) is fine here —
# unlike the internal-panel chain (see gemini-display.config's rdinit
# constraint) the USB display is never needed before the rootfs is up, and
# the loop-image rootfs has a full modprobe environment; release/assemble.sh
# stages udl.ko + evdi.ko under /lib/modules/<kver>/updates and depmod-
# verifies them (issue #26 acceptance criteria).
#
# NOTE the right port runs USB 2.0 high-speed (dts/0019, B-22 follow-up
# 2026-07-20) but PIO-only with single-buffered 512B FIFOs — ~43-64 Mbit/s
# measured TCP ceiling — and a babbling device wedges the host until reboot.
# Display-grade sustained bulk (throughput headroom + babble recovery) is
# Slice U2 (issue #27). This fragment stages the driver side only.
CONFIG_DRM_UDL=m

# udl selects DRM_GEM_SHMEM_HELPER; left to Kconfig it would land =m
# (defconfig has other =m selectors) and udl.ko would grow a module dep to
# stage. Force it built-in so udl.ko and evdi.ko stay the only shipped
# display modules (DRM=y already, from gemini-display.config).
CONFIG_DRM_GEM_SHMEM_HELPER=y

# The secondary route's evdi is out-of-tree (modules/evdi, pinned to the
# version Synaptics pairs with the aarch64 DisplayLinkManager — see its
# PROVENANCE.md) and needs no extra kernel config beyond DRM=y.
