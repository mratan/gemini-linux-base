# iwd — the kernel side of it.
#
# iwd does its crypto through the kernel rather than linking a userspace
# library, so it refuses to start at all if the AF_ALG interfaces and the
# keyctl Diffie-Hellman operation are not there. It says so precisely and then
# exits 1, which systemd reports only as "control process exited with error
# code" — the useful text is in `journalctl -u iwd`:
#
#   The following options are missing in the kernel:
#     CONFIG_KEY_DH_OPERATIONS
#     CONFIG_CRYPTO_ECB / MD5 / CBC / SHA256 / AES / DES / CMAC / HMAC / ...
#
# That list is misleading. Of the eleven it printed on this device, eight were
# already enabled; the algorithms are reachable as modules and AF_ALG autoloads
# them on demand. Only three were genuinely absent, and they are the three
# below. Check the .config before adding anything else from that message.
#
# CRYPTO_USER_API has to be built in rather than left as the module it was:
# the two _HASH/_SKCIPHER sub-options cannot be =y under a =m parent, and
# merge_config would silently drop them.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# keyctl(KEYCTL_DH_COMPUTE), which iwd uses for SAE/WPA3 and for EAP methods
# that need a DH exchange. Depends on KEYS (already =y) and pulls CRYPTO_DH.
CONFIG_KEY_DH_OPERATIONS=y
