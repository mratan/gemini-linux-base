# Tailscale's remaining kernel gaps.
#
# NOT the whole netfilter stack -- that is already present and was misdiagnosed
# once. The built kernel already has:
#
#   CONFIG_NETFILTER=y
#   CONFIG_NETFILTER_XTABLES=m
#   CONFIG_IP_NF_IPTABLES=m
#   CONFIG_TUN=y
#
# and ip_tables.ko / x_tables.ko load fine. What failed was Debian's default
# iptables-NFT backend against a kernel with CONFIG_NF_TABLES unset:
#
#   iptables: Failed to initialize nft: Protocol not supported
#
# That is fixed in userspace, not here, and it is what actually unblocked
# tailscaled -- see the comment in device-config on /etc/default/tailscaled:
#
#   update-alternatives --set iptables  /usr/sbin/iptables-legacy
#   update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
#
# With that done, tailscaled runs in normal mode with a real tailscale0 and
# both plain ssh and Tailscale SSH work. The two options below remove the two
# health warnings that remain. Neither is required for Tailscale to function,
# so this fragment is a tidy-up to fold into the next flash, not a fix.

# "Extension connmark revision 0 not supported, missing kernel module?"
# tailscaled restores connection marks in mangle/PREROUTING. xt_connmark is the
# only netfilter module it wants that is genuinely not built.
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m

# "router: error querying IP rules (does kernel have IP_MULTIPLE_TABLES?):
#  operation not supported"
# Policy routing. Absent entirely from the current .config.
#
# IP_ADVANCED_ROUTER is a `depends on`, not a `select`, so asking for
# IP_MULTIPLE_TABLES alone gets it silently dropped by olddefconfig -- which is
# exactly what happened on the first build of this fragment (build #91,
# 2026-08-26): "DROPPED: CONFIG_IP_MULTIPLE_TABLES=y", caught by
# gemini-kbuild.sh's post-merge assertion and not by anything else. The parent
# symbol is a pure menu-gate: on its own it changes no code.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Not added deliberately: CONFIG_NF_TABLES. Adding it would let the NFT backend
# work and make the update-alternatives step unnecessary, which is tempting.
# It also pulls in a large subsystem on a device where the connectivity stack is
# a vendor blob and every kernel change costs a flash and a boot-loop risk. The
# legacy backend is measured working; revisit only if something else needs nft.
