# MT6797's two Cortex-A72 cores (cpu8, cpu9).
#
# The cluster is fed by an external DA9214 buck on i2c6 and the firmware will
# not power it up unless that rail, ARMCAXPLL2 (which it measures, and rejects
# outside 742500..757500 kHz) and the big SRAM LDO are all set before PSCI
# CPU_ON. drivers/soc/mediatek/mt6797-a72.c does that from a
# CPUHP_BP_PREPARE_DYN callback — the same point the vendor kernel uses — so
# `echo 1 > /sys/devices/system/cpu/cpu8/online` works.
#
# maxcpus=8 stays in gemini-cmdline.config on purpose: bringing the A72s up
# during early SMP boot is impossible because i2c is not probed yet, which is
# also why the vendor hotplugs them late rather than booting them.
CONFIG_MTK_MT6797_A72=y
