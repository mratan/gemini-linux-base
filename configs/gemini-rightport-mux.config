# Right-port USB-C mux — static/sysfs selection (Track 3, Slice VS2; issue #16).
#
# Enables the gemini-rightport-mux driver that routes the right USB-C port to
# EITHER HDMI (the SiI9024A added in VS1) OR USB-2 host — never both. It drives
# the three mux GPIOs (sw_en/sw_sel/sw7226_en) and exposes a "mode" sysfs
# attribute (hdmi / usb-host), decoupled from the Type-C/fusb302 state machine
# (ADR-0003). GPIO72 (sw7226_en) is the master interlock, so the two routes are
# mutually exclusive by construction.
#
# Built-in (=y), not =m: the Gemini's bring-up initramfs is a minimal
# rdinit=/bin/sh with no modprobe path (same rationale as gemini-hdmi.config /
# gemini-display.config), so the driver must be built in to claim the mux GPIOs
# and apply the default (usb-host) mode at boot.
CONFIG_GEMINI_RIGHTPORT_MUX=y
