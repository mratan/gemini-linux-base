From d269e2daa4ca45d556125fbb9793e006dfc8dff2 Mon Sep 17 00:00:00 2001
From: mratan <mattdratan@gmail.com>
Date: Wed, 12 Aug 2026 09:53:56 -0700
Subject: [PATCH 3/3] capture: /proc/driver/wmt_capture control hook for C0
 captures

wmt_detect is the only connectivity component that initializes at boot
(MTK_WCN_REMOVE_KERNEL_MODULE defers everything else to wmt_loader's
COMBO_IOCTL_DO_MODULE_INIT ioctl), so a proc hook here is reachable
with the daemons and the Android LXC container held off entirely --
the held-off state the Pre-firmware capture needs.

Commands: 'modinit' runs do_connectivity_driver_init(soc chipid), the
byte-identical kernel path wmt_loader's ioctl takes (registers
/dev/stpwmt and /proc/driver/wmt_dbg, powers nothing); 'snap <tag>'
and 'cpupcr <tag>' emit the full register table / 32x1ms CPUPCR burst
at operator-chosen sequence points. The C0b single-query experiment
itself then uses the stock vendor debug interface (wmt_dbg 0x7 =
func-ctrl), needing no new kernel code on that path.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../common/common_detect/wmt_detect.c         | 82 +++++++++++++++++++
 1 file changed, 82 insertions(+)

diff --git a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c
index 632cd1ecc..f17184a6b 100644
--- a/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c
+++ b/drivers/misc/mediatek/connectivity/common/common_detect/wmt_detect.c
@@ -28,6 +28,7 @@
 #endif
 #ifdef CONFIG_COMPAT
 #include <linux/compat.h>
+#include <linux/proc_fs.h>
 #endif
 
 #define WMT_DETECT_MAJOR 154
@@ -293,6 +294,84 @@ static struct platform_driver wmt_detect_driver = {
 };
 #endif
 
+/* ====================================================================
+ * Capture kit (gemini_linux tracker issue #9): /proc/driver/wmt_capture
+ *
+ * Control hook for the Pre-firmware capture (C0) on the Reference
+ * slot. wmt_detect is the only part of the connectivity stack that
+ * initializes at boot (MTK_WCN_REMOVE_KERNEL_MODULE defers everything
+ * else to wmt_loader's COMBO_IOCTL_DO_MODULE_INIT ioctl), so this
+ * proc node exists as soon as the kernel is up, with the daemons and
+ * the Android LXC container held off entirely.
+ *
+ * Commands (echo to /proc/driver/wmt_capture):
+ *   modinit       - run do_connectivity_driver_init(soc chipid): the
+ *                   byte-identical kernel path wmt_loader's ioctl
+ *                   takes (wmt_detect.c COMBO_IOCTL_DO_MODULE_INIT).
+ *                   Registers /dev/stpwmt + /proc/driver/wmt_dbg; does
+ *                   NOT power CONSYS or touch BTIF.
+ *   snap <tag>    - full register-table snapshot (CAPTURE-REG lines)
+ *                   at an arbitrary user-chosen sequence point.
+ *   cpupcr <tag>  - 32-sample ~1ms CPUPCR burst (CAPTURE-CPUPCR
+ *                   lines), gated on CONN power.
+ *
+ * The C0b single-query experiment then uses the stock vendor debug
+ * interface: echo 0x7 0x3 0x1 > /proc/driver/wmt_dbg (func-on WIFI),
+ * which runs the unmodified power-on + sw_init path; with
+ * wmt_launcher held off the patch search times out after 2000 ms
+ * (wmt_ctrl_ul_cmd), so the attempt self-terminates after the
+ * pre-patch WMT_QUERY_STP exchange -- exactly the observation the
+ * divergence-debug plan calls the single most load-bearing bit of
+ * evidence.
+ * ==================================================================== */
+extern VOID wmt_capture_regtable(const char *sp);
+extern VOID wmt_capture_cpupcr_burst(const char *sp, int n);
+
+static int g_wmt_capture_modinit_done;
+
+static ssize_t wmt_capture_write(struct file *filp, const char __user *buf,
+				 size_t count, loff_t *f_pos)
+{
+	char cmd[64];
+	size_t orig_count = count;
+	int ret;
+
+	if (count >= sizeof(cmd))
+		return -EINVAL;
+	if (copy_from_user(cmd, buf, count))
+		return -EFAULT;
+	cmd[count] = '\0';
+	while (count && (cmd[count - 1] == '\n' || cmd[count - 1] == '\r'))
+		cmd[--count] = '\0';
+
+	if (!strcmp(cmd, "modinit")) {
+		if (g_wmt_capture_modinit_done) {
+			WMT_DETECT_INFO_FUNC("wmt_capture: modinit already done\n");
+			return orig_count;
+		}
+		pr_info("CAPTURE-CTL: modinit chipid=0x%x\n",
+			wmt_plat_get_soc_chipid());
+		ret = do_connectivity_driver_init(wmt_plat_get_soc_chipid());
+		pr_info("CAPTURE-CTL: modinit ret=%d\n", ret);
+		if (!ret)
+			g_wmt_capture_modinit_done = 1;
+	} else if (!strncmp(cmd, "snap ", 5) && cmd[5]) {
+		wmt_capture_regtable(cmd + 5);
+	} else if (!strncmp(cmd, "cpupcr ", 7) && cmd[7]) {
+		wmt_capture_cpupcr_burst(cmd + 7, 32);
+	} else {
+		WMT_DETECT_INFO_FUNC(
+			"wmt_capture: unknown cmd '%s' (modinit|snap <tag>|cpupcr <tag>)\n",
+			cmd);
+	}
+	return orig_count;
+}
+
+static const struct file_operations wmt_capture_fops = {
+	.owner = THIS_MODULE,
+	.write = wmt_capture_write,
+};
+
 /*module_platform_driver(wmt_detect_driver);*/
 static int wmt_detect_driver_init(void)
 {
@@ -338,6 +417,9 @@ static int wmt_detect_driver_init(void)
 		WMT_DETECT_ERR_FUNC("platform driver register fail ret:%d\n", ret);
 #endif
 
+	if (!proc_create("driver/wmt_capture", 0220, NULL, &wmt_capture_fops))
+		WMT_DETECT_ERR_FUNC("wmt_capture proc node create failed\n");
+
 	return 0;
 
