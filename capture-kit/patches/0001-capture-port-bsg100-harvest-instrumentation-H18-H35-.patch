 	iRet = wmt_ctrl_tx_ex(pData, size, writtenSize, bRawFlag);
 	if (0 == *writtenSize && (chip_type == WMT_CHIP_TYPE_SOC)) {
 		retry_times = 0;
@@ -372,6 +375,11 @@ INT32 wmt_core_rx(PUINT8 pBuf, UINT32 bufLen, PUINT32 readSize)
 		mtk_wcn_stp_dbg_dump_package();
 		osal_assert(0);
 	}
+	if (!iRet && readSize && *readSize) {
+		pr_info("HARVEST-WMT-RX: len=%u\n", *readSize);
+		print_hex_dump(KERN_INFO, "HARVEST-WMT-RX: ", DUMP_PREFIX_OFFSET,
