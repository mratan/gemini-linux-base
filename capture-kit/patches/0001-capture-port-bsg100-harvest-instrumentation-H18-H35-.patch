@@ -337,6 +337,9 @@ wmt_core_tx(const PUINT8 pData, const UINT32 size, PUINT32 writtenSize, const MT
 	ENUM_WMT_CHIP_TYPE chip_type;
 
 	chip_type = wmt_detect_get_chip_type();
+	pr_info("HARVEST-WMT-TX: len=%u raw=%d\n", size, bRawFlag);
+	print_hex_dump(KERN_INFO, "HARVEST-WMT-TX: ", DUMP_PREFIX_OFFSET,
