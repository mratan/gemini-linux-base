 #endif
@@ -1075,9 +1075,9 @@ unsigned int btif_dma_rx_data_receiver(P_MTK_DMA_INFO_STR p_dma_info,
 	unsigned int index = 0;
 	p_mtk_btif p_btif = &(g_btif[index]);
 
-#if 0
-	_btif_dump_memory("<DMA Rx>", p_buf, buf_len);
-#endif
+	pr_info("HARVEST-BTIF-RX: len=%u mode=DMA\n", buf_len);
+	print_hex_dump(KERN_INFO, "HARVEST-BTIF-RX: ", DUMP_PREFIX_OFFSET,
+		       16, 1, p_buf, buf_len > 32 ? 32 : buf_len, false);
 
 	btif_bbs_write(&(p_btif->btif_buf), p_buf, buf_len);
 /*save DMA Rx packet here*/
@@ -1094,9 +1094,9 @@ unsigned int btif_pio_rx_data_receiver(P_MTK_BTIF_INFO_STR p_btif_info,
 	unsigned int index = 0;
 	p_mtk_btif p_btif = &(g_btif[index]);
 
-#if 0
-	_btif_dump_memory("<PIO Rx>", p_buf, buf_len);
-#endif
+	pr_info("HARVEST-BTIF-RX: len=%u mode=PIO\n", buf_len);
+	print_hex_dump(KERN_INFO, "HARVEST-BTIF-RX: ", DUMP_PREFIX_OFFSET,
+		       16, 1, p_buf, buf_len > 32 ? 32 : buf_len, false);
 	btif_bbs_write(&(p_btif->btif_buf), p_buf, buf_len);
 
 /*save PIO Rx packet here*/
@@ -2820,6 +2820,11 @@ int _btif_send_data(p_mtk_btif p_btif,
 	if (B_S_ON != state)
 		i_ret = _btif_exit_dpidle(p_btif);
 
