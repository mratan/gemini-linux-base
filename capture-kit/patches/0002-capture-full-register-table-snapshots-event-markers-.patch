+/* ====================================================================
+ * Capture kit (gemini_linux tracker issue #9).
+ *
+ * Full register-table snapshots implementing the
+ * "What a Pre-firmware capture must record" table of
+ * 04-docs/DIVERGENCE-DEBUG-PLAN.md, emitted at defined sequence
+ * points in the vendor CONSYS bring-up so C0/C1 captures diff
+ * mechanically against C2 (the ported stack on the 6.6 Base tree).
+ *
+ * Output format (one register per line, greppable, normalizes to the
+ * plan's "register, sequence-point, value" table):
+ *   CAPTURE-REG: <seq-point> <NAME> 0x<phys> = 0x<val>
+ *   CAPTURE-REG: <seq-point> <NAME> 0x<phys> = SKIPPED-<why>
+ *   CAPTURE-PMIC: <seq-point> <NAME> 0x<pmic-adr> = 0x<val16>
+ *   CAPTURE-CPUPCR: <seq-point> sample=<i> = 0x<val>
+ *   CAPTURE-EMI: <seq-point> ...
+ *   CAPTURE-MCU-RST: assert|release
+ *
+ * Read-only by construction: every access is a read; CONN-domain and
+ * BTIF/APDMA reads are gated on the power/clock state that makes them
+ * safe (DEVAPC lesson from bsg100 H16, see harvest_snap above).
+ * ==================================================================== */
+#include <linux/crc32.h>
+#include <linux/vmalloc.h>
+
+struct wmt_cap_reg {
+	const char *name;
+	UINT32 phys;
+};
+
+/* AP-side registers: always safe to read. Addresses and expected
+ * values source-cited in DIVERGENCE-DEBUG-PLAN.md and the mirrored
+ * bsg100 consys-golden-harvest.sh / blockers.md B-21. */
+static const struct wmt_cap_reg wmt_cap_ap_regs[] = {
+	{"SPM_PWRON_CONFG_EN",       0x10006000},
+	{"SPM_PWR_STATUS",           0x10006180},
+	{"SPM_PWR_STATUS_2ND",       0x10006184},
+	{"SPM_CONN_PWR_CON",         0x1000632c}, /* golden-on 0x10D, SRAM_PDN bit8 SET */
+	{"SPM_CONN_PWR_CON_STALE",   0x10006280}, /* the stale-define trap; capture, don't poke */
+	{"INFRA_TOPAXI_PROT_EN",     0x10001220}, /* CONN bits 17|18 */
+	{"INFRA_TOPAXI_PROT_STA1",   0x10001228},
+	{"AP2CONN_OSC_EN",           0x10001f00}, /* golden 0x6D403A00; bit11 unresolved lead */
+	{"CONSYS_EMI_MAPPING",       0x10001340},
+	{"CONN2AP_SLEEP_MASK",       0x10001350}, /* bit 8 */
+	{"WDT_SWSYSRST",             0x10007018}, /* bit 12 = CONSYS CPU reset */
+	{"INFRA_CG_STA0",            0x10001090}, /* bit31 = CLK_INFRA_BTIF gate state */
+	{"INFRA_CG_STA1",            0x10001094}, /* bit18 = CLK_INFRA_AP_DMA gate state */
+	{"PWRAP_DCXO_ENABLE",        0x1000d18c},
+	{"PWRAP_DCXO_CONN_ADR0",     0x1000d190},
+	{"PWRAP_DCXO_CONN_WDATA0",   0x1000d194},
+	{"PWRAP_DCXO_CONN_ADR1",     0x1000d198},
+	{"PWRAP_DCXO_CONN_WDATA1",   0x1000d19c},
+};
+
+/* CONN-domain registers: only readable while SPM_PWR_STATUS/2ND bit 1
+ * report the CONN MTCMOS on (DEVAPC violation + eventual hard reset
+ * otherwise -- bsg100 H16). */
+static const struct wmt_cap_reg wmt_cap_conn_regs[] = {
+	{"CONSYS_HW_VER",            0x18070000}, /* expect 0x8A00 */
+	{"CONSYS_FW_VER",            0x18070004},
+	{"CONSYS_CHIP_ID",           0x18070008}, /* expect 0x0279 */
+	{"MCU_CFG_ACR",              0x18070110},
+	{"CONSYS_CPUPCR",            0x18070160},
+};
+
+/* BTIF host block + APDMA BTIF channels: reads need CLK_INFRA_BTIF /
+ * CLK_INFRA_AP_DMA ungated (bus hang otherwise). Offset 0x8 is IIR on
+ * read; FIFOCTRL shares the offset but is write-only. BTIF_WAK (+0x64)
+ * is documented write-only; the read is best-effort and the golden
+ * harvest script read it too. */
+static const struct wmt_cap_reg wmt_cap_btif_regs[] = {
+	{"BTIF_IER",                 0x1100c004},
+	{"BTIF_IIR_FIFOCTRL",        0x1100c008},
+	{"BTIF_FAKELCR",             0x1100c00c},
+	{"BTIF_LSR",                 0x1100c014},
+	{"BTIF_SLEEP_EN",            0x1100c048},
+	{"BTIF_DMA_EN",              0x1100c04c},
+	{"BTIF_RTOCNT",              0x1100c054},
+	{"BTIF_TRI_LVL",             0x1100c060}, /* golden 0x18 */
+	{"BTIF_WAK",                 0x1100c064},
+	{"BTIF_WAT_TIME",            0x1100c068},
+	{"BTIF_HANDSHAKE",           0x1100c06c}, /* golden 0x3 */
+};
+static const struct wmt_cap_reg wmt_cap_apdma_regs[] = {
+	{"APDMA_BTIF_TX_INT_EN",     0x11000884},
+	{"APDMA_BTIF_TX_EN",         0x11000888},
+	{"APDMA_BTIF_RX_INT_EN",     0x11000904},
+	{"APDMA_BTIF_RX_EN",         0x11000908},
+};
+
+/* MT6351 PMIC registers over pwrap (not memory-mapped; devmem cannot
+ * reach these -- the reason this must be kernel-side). Addresses:
+ * upmu_hw.h MT6351_LDO_VCN*_CON0; DCXO_CW00 0x7000 per the mirrored
+ * bsg100 golden harvest script (bit 5 = XO_WCN). */
+static const struct wmt_cap_reg wmt_cap_pmic_regs[] = {
+	{"PMIC_DCXO_CW00",           0x7000},
+	{"PMIC_LDO_VCN18_CON0",      0x0a52},
+	{"PMIC_LDO_VCN28_CON0",      0x0a0c}, /* RG_VCN28_ON_CTRL lives here */
+	{"PMIC_LDO_VCN33_CON0",      0x0a92},
+};
+
+extern s32 pwrap_read(u32 adr, u32 *rdata); /* mt_pmic_wrap.c, EXPORT_SYMBOL */
+
+#define WMT_CAP_PAGES 16
+struct wmt_cap_page_ent {
+	UINT32 page;
+	VOID __iomem *virt;
+};
+static struct wmt_cap_page_ent wmt_cap_pages[WMT_CAP_PAGES];
+
+static VOID __iomem *wmt_cap_map(UINT32 phys)
+{
+	UINT32 page = phys & ~0xFFFU;
+	INT32 i;
+
+	for (i = 0; i < WMT_CAP_PAGES; i++) {
+		if (wmt_cap_pages[i].virt && wmt_cap_pages[i].page == page)
+			return wmt_cap_pages[i].virt + (phys & 0xFFF);
+		if (!wmt_cap_pages[i].virt) {
+			wmt_cap_pages[i].virt = ioremap_nocache(page, 0x1000);
+			wmt_cap_pages[i].page = page;
+			if (!wmt_cap_pages[i].virt)
+				return NULL;
+			return wmt_cap_pages[i].virt + (phys & 0xFFF);
+		}
+	}
+	return NULL;
+}
+
+static INT32 wmt_cap_read(UINT32 phys, UINT32 *val)
+{
+	VOID __iomem *v = wmt_cap_map(phys);
+
+	if (!v)
+		return -1;
+	*val = CONSYS_REG_READ(v);
+	return 0;
+}
+
+static VOID wmt_cap_emit(const char *sp, const struct wmt_cap_reg *r)
+{
+	UINT32 val = 0;
+
+	if (wmt_cap_read(r->phys, &val))
+		pr_info("CAPTURE-REG: %s %s 0x%08x = SKIPPED-MAP-FAILED\n",
+			sp, r->name, r->phys);
+	else
+		pr_info("CAPTURE-REG: %s %s 0x%08x = 0x%08x\n",
+			sp, r->name, r->phys, val);
+}
+
+static VOID wmt_cap_skip(const char *sp, const struct wmt_cap_reg *r,
+			 const char *why)
+{
+	pr_info("CAPTURE-REG: %s %s 0x%08x = SKIPPED-%s\n",
+		sp, r->name, r->phys, why);
+}
+
+static INT32 wmt_cap_conn_powered(VOID)
+{
+	UINT32 sta = 0, sta2 = 0;
+
+	if (wmt_cap_read(0x10006180, &sta) || wmt_cap_read(0x10006184, &sta2))
+		return 0;
+	return ((sta & 0x2) && (sta2 & 0x2)) ? 1 : 0;
+}
+
+/* CONSYS EMI ctrl window: 343 KiB at gConEmiPhyBase + 0x80000 (bsg100
+ * research.md; untested-hypothesis row of the plan's table). First 64
+ * bytes hexdumped + CRC32 of the whole window. */
+#define WMT_CAP_EMI_CTRL_OFF  0x80000
+#define WMT_CAP_EMI_CTRL_LEN  (343 * 1024)
+
+static VOID wmt_cap_emi(const char *sp)
+{
+	VOID __iomem *win;
+	PUINT8 buf;
+
+	if (!gConEmiPhyBase) {
+		pr_info("CAPTURE-EMI: %s gConEmiPhyBase = UNSET\n", sp);
+		return;
+	}
+	pr_info("CAPTURE-EMI: %s gConEmiPhyBase = 0x%08x\n",
+		sp, (UINT32) gConEmiPhyBase);
+	win = ioremap_nocache(gConEmiPhyBase + WMT_CAP_EMI_CTRL_OFF,
+			      WMT_CAP_EMI_CTRL_LEN);
+	if (!win) {
+		pr_info("CAPTURE-EMI: %s ctrlwin = SKIPPED-MAP-FAILED\n", sp);
+		return;
+	}
+	buf = vmalloc(WMT_CAP_EMI_CTRL_LEN);
+	if (buf) {
+		memcpy_fromio(buf, win, WMT_CAP_EMI_CTRL_LEN);
+		pr_info("CAPTURE-EMI: %s ctrlwin_crc32 = 0x%08x len=%d\n",
+			sp, crc32_le(0, buf, WMT_CAP_EMI_CTRL_LEN),
+			WMT_CAP_EMI_CTRL_LEN);
+		print_hex_dump(KERN_INFO, "CAPTURE-EMI: ", DUMP_PREFIX_OFFSET,
+			       16, 1, buf, 64, false);
+		vfree(buf);
+	} else {
+		pr_info("CAPTURE-EMI: %s ctrlwin = SKIPPED-NOMEM\n", sp);
+	}
+	iounmap(win);
+}
+
+/* Full register-table snapshot at one sequence point. Callable from
+ * the bring-up path here and from the /proc/driver/wmt_capture hook in
+ * wmt_detect.c (both built-in). */
+VOID wmt_capture_regtable(const char *sp)
+{
+	UINT32 cg0 = 0, cg1 = 0;
+	INT32 conn_on, i;
+
+	pr_info("CAPTURE-SNAP-BEGIN: %s\n", sp);
+
+	for (i = 0; i < (INT32) ARRAY_SIZE(wmt_cap_ap_regs); i++)
+		wmt_cap_emit(sp, &wmt_cap_ap_regs[i]);
+
+	conn_on = wmt_cap_conn_powered();
+	pr_info("CAPTURE-REG: %s CONN_POWERED - = %d\n", sp, conn_on);
+	for (i = 0; i < (INT32) ARRAY_SIZE(wmt_cap_conn_regs); i++) {
+		if (conn_on)
+			wmt_cap_emit(sp, &wmt_cap_conn_regs[i]);
+		else
+			wmt_cap_skip(sp, &wmt_cap_conn_regs[i],
+				     "CONN-UNPOWERED");
+	}
+
+	/* MTK CG status: bit set = clock gated */
+	wmt_cap_read(0x10001090, &cg0);
+	wmt_cap_read(0x10001094, &cg1);
+	for (i = 0; i < (INT32) ARRAY_SIZE(wmt_cap_btif_regs); i++) {
+		if (!(cg0 & (1U << 31)))
+			wmt_cap_emit(sp, &wmt_cap_btif_regs[i]);
+		else
+			wmt_cap_skip(sp, &wmt_cap_btif_regs[i],
+				     "BTIF-CLK-GATED");
+	}
+	for (i = 0; i < (INT32) ARRAY_SIZE(wmt_cap_apdma_regs); i++) {
+		if (!(cg1 & (1U << 18)))
+			wmt_cap_emit(sp, &wmt_cap_apdma_regs[i]);
+		else
+			wmt_cap_skip(sp, &wmt_cap_apdma_regs[i],
+				     "APDMA-CLK-GATED");
+	}
+
+	for (i = 0; i < (INT32) ARRAY_SIZE(wmt_cap_pmic_regs); i++) {
+		UINT32 val = 0;
+
+		if (pwrap_read(wmt_cap_pmic_regs[i].phys, &val))
+			pr_info("CAPTURE-PMIC: %s %s 0x%04x = READ-FAILED\n",
+				sp, wmt_cap_pmic_regs[i].name,
+				wmt_cap_pmic_regs[i].phys);
+		else
+			pr_info("CAPTURE-PMIC: %s %s 0x%04x = 0x%04x\n",
+				sp, wmt_cap_pmic_regs[i].name,
+				wmt_cap_pmic_regs[i].phys, val);
+	}
+
+	wmt_cap_emi(sp);
+	pr_info("CAPTURE-SNAP-END: %s\n", sp);
+}
+
+/* CPUPCR burst: >=32 samples at ~1 ms spacing (the plan's MCU
+ * execution discriminator: golden steady 0x0009997A vs abnormal
+ * 0x55AA55xx sleep-spin). Process context only (sleeps). */
+VOID wmt_capture_cpupcr_burst(const char *sp, INT32 n)
+{
+	UINT32 val;
